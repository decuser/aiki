# 'describe' is a function that contains a match statement
let describe = (state) {
    match state {
        0 { 
            return "Idle" 
        }
        [:move, x, y] { 
            return "Moving" 
        }
        _ { 
            return "Unknown" 
        }
    }
}

# Now you 'call' the function using the pipe
[:move, 10, 20] |> describe() |> print()
print("\n")
