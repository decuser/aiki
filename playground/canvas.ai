let c = canvas(800, 800)
let cx = 400
let cy = 400
let t = 0
let R = 200
let r = 80
let d = 150

while t < 6280 {
    let angle = t / 100
    let x = cx + (((R - r) * cos(angle)) + (d * cos(((R - r) / r) * angle)))
    let y = cy + (((R - r) * sin(angle)) - (d * sin(((R - r) / r) * angle)))
    dot(c, x, y, :cyan)
    t = t + 1
}
