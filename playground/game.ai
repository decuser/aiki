# Aiki Number Guessing Game
let secret = 42
let attempts = 0
let guessed = false

print("I'm thinking of a number between 1 and 100.")

while not guessed {
	print("Enter your guess: ")
	let input = read()
	let guess = tonum(input)
	attempts = attempts + 1
	if guess == secret {
		print("Correct! You found it in")
		print(attempts)
		print("attempts.")
		guessed = true
	} else {
		if guess < secret {
			print("Too low, try again.")
		} else {
			print("Too high, try again.")
		}
	}
}
