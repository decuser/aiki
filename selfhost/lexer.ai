package "selfhost/lexer"

# Phase I / Cut I.2: independent Aiki lexer.
#
# This implementation intentionally does not call the Go lexer or use regular
# expressions. It realizes the lexical language independently with ordinary
# Aiki string/rune/list operations. Enumerated lexical tables are exposed so
# the invariant harness can couple them back to grammar.ebnfx.
let str = import("string")

let @token [kind, lexeme, line, col]
let @lexical_authority [tokens, keywords, operators, delimiters, skips]

let token_names = ["WHITESPACE", "NEWLINE", "COMMENT", "NUMBER", "STRING", "RUNE", "SYMBOL", "SHAPE", "KEYWORD", "OPERATOR", "DELIMITER", "NAME"]

let keywords = ["let", "if", "else", "while", "match", "select", "default", "return", "true", "false", "and", "or", "not", "package"]

let operators = ["+", "-", "*", "/", "<", ">", "<=", ">=", "|>", ".", "="]
let delimiters = ["(", ")", "[", "]", "{", "}", ",", ";", "..."]
let skip_tokens = ["WHITESPACE", "COMMENT"]

let lexical_authority = () {
	[@lexical_authority, token_names, keywords, operators, delimiters, skip_tokens]
}

let is_keyword = (word) {
	if equal(word, "let") {
		return true
	}
	if equal(word, "if") {
		return true
	}
	if equal(word, "else") {
		return true
	}
	if equal(word, "while") {
		return true
	}
	if equal(word, "match") {
		return true
	}
	if equal(word, "select") {
		return true
	}
	if equal(word, "default") {
		return true
	}
	if equal(word, "return") {
		return true
	}
	if equal(word, "true") {
		return true
	}
	if equal(word, "false") {
		return true
	}
	if equal(word, "and") {
		return true
	}
	if equal(word, "or") {
		return true
	}
	if equal(word, "not") {
		return true
	}
	if equal(word, "package") {
		return true
	}
	return false
}

let is_digit = (r) {
	let n = ord(r)
	(n >= 48) and (n <= 57)
}

let is_alpha = (r) {
	let n = ord(r)
	((n >= 65) and (n <= 90)) or ((n >= 97) and (n <= 122))
}

let is_name_start = (r) {
	is_alpha(r) or equal(ord(r), 95)
}

let is_name_continue = (r) {
	is_name_start(r) or is_digit(r)
}

let code_at = (chars, at) {
	if (at < 0) or (at >= length(chars)) {
		return 0 - 1
	}
	return ord(chars[at])
}

let is_digit_at = (chars, at) {
	let n = code_at(chars, at)
	(n >= 48) and (n <= 57)
}

let is_name_start_at = (chars, at) {
	let n = code_at(chars, at)
	((n >= 65) and (n <= 90)) or ((n >= 97) and (n <= 122)) or equal(n, 95)
}

let is_name_continue_at = (chars, at) {
	is_name_start_at(chars, at) or is_digit_at(chars, at)
}

let literal_token = (chars, at, n) {
	let code = code_at(chars, at)
	if equal(code, 46) {
		if at + 2 < n {
			if equal(code_at(chars, at + 1), 46) {
				if equal(code_at(chars, at + 2), 46) {
					return ["DELIMITER", at + 3]
				}
			}
		}
		return ["OPERATOR", at + 1]
	}
	if equal(code, 60) {
		if at + 1 < n {
			if equal(code_at(chars, at + 1), 61) {
				return ["OPERATOR", at + 2]
			}
		}
		return ["OPERATOR", at + 1]
	}
	if equal(code, 62) {
		if at + 1 < n {
			if equal(code_at(chars, at + 1), 61) {
				return ["OPERATOR", at + 2]
			}
		}
		return ["OPERATOR", at + 1]
	}
	if equal(code, 124) {
		if at + 1 < n {
			if equal(code_at(chars, at + 1), 62) {
				return ["OPERATOR", at + 2]
			}
		}
		return []
	}
	if equal(code, 43) {
		return ["OPERATOR", at + 1]
	}
	if equal(code, 45) {
		return ["OPERATOR", at + 1]
	}
	if equal(code, 42) {
		return ["OPERATOR", at + 1]
	}
	if equal(code, 47) {
		return ["OPERATOR", at + 1]
	}
	if equal(code, 61) {
		return ["OPERATOR", at + 1]
	}
	if equal(code, 40) {
		return ["DELIMITER", at + 1]
	}
	if equal(code, 41) {
		return ["DELIMITER", at + 1]
	}
	if equal(code, 91) {
		return ["DELIMITER", at + 1]
	}
	if equal(code, 93) {
		return ["DELIMITER", at + 1]
	}
	if equal(code, 123) {
		return ["DELIMITER", at + 1]
	}
	if equal(code, 125) {
		return ["DELIMITER", at + 1]
	}
	if equal(code, 44) {
		return ["DELIMITER", at + 1]
	}
	if equal(code, 59) {
		return ["DELIMITER", at + 1]
	}
	return []
}

let text_from = (chars, start, end) {
	let out = ""
	let i = start
	while i < end {
		out = out + to_str(chars[i])
		i = i + 1
	}
	return out
}

let lex_error = (line, col, message) {
	shaped(:error, [:lex, to_str(line) + ":" + to_str(col) + ": " + message])
}

let tokenize = (source) {
	let chars = str.chars(source)
	let out = []
	let i = 0
	let line = 1
	let col = 1
	let n = length(chars)
	while i < n {
		let start = i
		let start_line = line
		let start_col = col
		let kind = ""
		let end = i
		let ch = chars[i]
		let code = ord(ch)
		# WHITESPACE: space, tab, carriage return; physical newline is separate.
		if equal(code, 32) or equal(code, 9) or equal(code, 13) {
			kind = "WHITESPACE"
			end = i + 1
			let scanning = true
			while (end < n) and scanning {
				let c = ord(chars[end])
				if equal(c, 32) or equal(c, 9) or equal(c, 13) {
					end = end + 1
				} else {
					scanning = false
				}
			}
		} else {
			# NEWLINE: one or more physical LF characters.
			if equal(code, 10) {
				kind = "NEWLINE"
				end = i + 1
				while (end < n) and equal(code_at(chars, end), 10) {
					end = end + 1
				}
			} else {
				# COMMENT: from # through, but not including, physical newline.
				if equal(code, 35) {
					kind = "COMMENT"
					end = i + 1
					while (end < n) and (not equal(code_at(chars, end), 10)) {
						end = end + 1
					}
				} else {
					# NUMBER: integer, optional decimal fraction, optional /digits.
					if is_digit(ch) {
						kind = "NUMBER"
						end = i + 1
						while (end < n) and is_digit_at(chars, end) {
							end = end + 1
						}
						if (end + 1 < n) and equal(code_at(chars, end), 46) and is_digit_at(chars, end + 1) {
							end = end + 2
							while (end < n) and is_digit_at(chars, end) {
								end = end + 1
							}
						}
						if (end + 1 < n) and equal(code_at(chars, end), 47) and is_digit_at(chars, end + 1) {
							end = end + 2
							while (end < n) and is_digit_at(chars, end) {
								end = end + 1
							}
						}
					} else {
						# STRING: quote, zero or more ordinary/escaped chars, quote.
						if equal(code, 34) {
							let j = i + 1
							let closed = false
							while (j < n) and (not closed) {
								let c = ord(chars[j])
								if equal(c, 92) {
									if (j + 1 < n) and (not equal(code_at(chars, j + 1), 10)) {
										j = j + 2
									} else {
										return lex_error(start_line, start_col, "unexpected character '\"'")
									}
								} else {
									if equal(c, 34) {
										j = j + 1
										closed = true
									} else {
										j = j + 1
									}
								}
							}
							if not closed {
								return lex_error(start_line, start_col, "unexpected character '\"'")
							}
							kind = "STRING"
							end = j
						} else {
							# RUNE: exactly one ordinary character or one backslash escape.
							if equal(code, 39) {
								if i + 2 >= n {
									return lex_error(start_line, start_col, "unexpected character apostrophe")
								}
								if equal(code_at(chars, i + 1), 92) {
									if (i + 3 >= n) or equal(code_at(chars, i + 2), 10) or (not equal(code_at(chars, i + 3), 39)) {
										return lex_error(start_line, start_col, "unexpected character apostrophe")
									}
									end = i + 4
								} else {
									if equal(code_at(chars, i + 1), 39) or (not equal(code_at(chars, i + 2), 39)) {
										return lex_error(start_line, start_col, "unexpected character apostrophe")
									}
									end = i + 3
								}
								kind = "RUNE"
							} else {
								# SYMBOL / SHAPE: prefix followed by an identifier.
								if equal(code, 58) or equal(code, 64) {
									if (i + 1 >= n) or (not is_name_start_at(chars, i + 1)) {
										return lex_error(start_line, start_col, "unexpected character " + to_str(ch))
									}
									if equal(code, 58) {
										kind = "SYMBOL"
									} else {
										kind = "SHAPE"
									}
									end = i + 2
									while (end < n) and is_name_continue_at(chars, end) {
										end = end + 1
									}
								} else {
									# NAME / KEYWORD: maximal identifier first, then classify exact keyword.
									if is_name_start(ch) {
										end = i + 1
										while (end < n) and is_name_continue_at(chars, end) {
											end = end + 1
										}
										let word = text_from(chars, i, end)
										if is_keyword(word) {
											kind = "KEYWORD"
										} else {
											kind = "NAME"
										}
									} else {
										let literal = literal_token(chars, i, n)
										if length(literal) > 0 {
											kind = literal[0]
											end = literal[1]
										} else {
											return lex_error(start_line, start_col, "unexpected character " + to_str(ch))
										}
									}
								}
							}
						}
					}
				}
			}
		}
		let lexeme = text_from(chars, start, end)
		out = append(out, [@token, kind, lexeme, start_line, start_col])
		if equal(kind, "NEWLINE") {
			line = line + (end - start)
			col = 1
		} else {
			col = col + (end - start)
		}
		i = end
	}
	return out
}

let project_tokens = (tokens) {
	let lines = []
	let i = 0
	while i < length(tokens) {
		let t = tokens[i]
		lines = append(lines, to_str(t.line) + ":" + to_str(t.col) + " " + t.kind + " " + inspect(t.lexeme))
		i = i + 1
	}
	return str.join(lines, "\n")
}

export(:tokenize, :project_tokens, :lexical_authority)
