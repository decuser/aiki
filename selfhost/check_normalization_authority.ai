# Executable coupling for the independent normalization tables.
let grammar = import("./grammar_authority")
let normalize = import("./normalize")

let @token_authority [tokens, keywords, operators, delimiters, skips]
let @newline_authority [token, after_tokens, after_lexemes, suppress_pairs]
let @normalization_authority [skips, newline_token, after_tokens, after_lexemes, suppress_pairs]

let same = (a, b) {
	if not equal(type(a), type(b)) {
		return false
	}
	if equal(type(a), :list) {
		if not equal(length(a), length(b)) {
			return false
		}
		let i = 0
		while i < length(a) {
			if not same(a[i], b[i]) {
				return false
			}
			i = i + 1
		}
		return true
	}
	return equal(a, b)
}

let lexical = grammar.read_token_authority("engine/syntax/grammar.ebnfx")
let newline = grammar.read_newline_authority("engine/syntax/grammar.ebnfx")
let actual = normalize.normalization_authority()

if is_error(lexical) {
	println(inspect(lexical))
} else {
	if is_error(newline) {
		println(inspect(newline))
	} else {
		if same(lexical.skips, actual.skips) and equal(newline.token, actual.newline_token) and same(newline.after_tokens, actual.after_tokens) and same(newline.after_lexemes, actual.after_lexemes) and same(newline.suppress_pairs, actual.suppress_pairs) {
			println("ok")
		} else {
			println("grammar lexical " + inspect(lexical))
			println("grammar newline " + inspect(newline))
			println("normalizer " + inspect(actual))
		}
	}
}
