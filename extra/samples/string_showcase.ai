# string_showcase.ai - Demonstrating Aiki's string functions
#
# This sample shows the full range of string operations available
# in the prelude, organized by category.
println("=== String Functions Showcase ===")
println("")

# -----------------------------------------------------------------------------
# Foundation: substring, join, split
# -----------------------------------------------------------------------------
println("--- Foundation ---")

# substring extracts a substring
let greeting = "Hello, World!"
println("Original: " + greeting)
println("substring(0, 5): " + substring(greeting, 0, 5))
println("substring(7, 12): " + substring(greeting, 7, 12))

# join combines a list of strings
let parts = ["apple", "banana", "cherry"]
println("join with ', ': " + join(parts, ", "))
println("join with '': " + join(parts, ""))

# split breaks a string apart
let csv = "red,green,blue"
println("split by ',': " + inspect(split(csv, ",")))

# Round trip: split then join
println("split then join: " + join(split("a-b-c", "-"), "-"))
println("")

# -----------------------------------------------------------------------------
# Search: index_of, contains, starts_with, ends_with, occurrences
# -----------------------------------------------------------------------------
println("--- Search ---")

let text = "The quick brown fox jumps over the lazy dog"
println("Text: " + text)
println("index_of 'fox': " + to_str(index_of(text, "fox")))
println("index_of 'cat': " + inspect(index_of(text, "cat")))
println("contains 'quick': " + to_str(contains(text, "quick")))
println("starts_with 'The': " + to_str(starts_with(text, "The")))
println("ends_with 'dog': " + to_str(ends_with(text, "dog")))
println("occurrences 'the' (case sensitive): " + to_str(occurrences(text, "the")))
println("")

# -----------------------------------------------------------------------------
# Transform: replace, repeat, reverse_string, insert, remove
# -----------------------------------------------------------------------------
println("--- Transform ---")

println("replace 'fox' with 'cat': " + replace(text, "fox", "cat"))
println("replace_first 'the' with 'a': " + replace_first(text, "the", "a"))
println("repeat 'ab' 4 times: " + repeat("ab", 4))
println("reverse 'hello': " + reverse_string("hello"))
println("insert 'XX' at position 2: " + insert("hello", 2, "XX"))
println("remove positions 1-3: " + remove("hello", 1, 3))
println("")

# -----------------------------------------------------------------------------
# Trim and Pad
# -----------------------------------------------------------------------------
println("--- Trim and Pad ---")

let messy = "   spaced out   "
println("Original: [" + messy + "]")
println("trim: [" + trim(messy) + "]")
println("trim_start: [" + trim_start(messy) + "]")
println("trim_end: [" + trim_end(messy) + "]")

println("pad_start '42' to 6 with '0': " + pad_start("42", 6, '0'))
println("pad_end '42' to 6 with '0': " + pad_end("42", 6, '0'))
println("center 'hi' to 10 with '-': " + center("hi", 10, '-'))
println("truncate 'hello world' to 5: " + truncate("hello world", 5))
println("")

# -----------------------------------------------------------------------------
# Conversion: chars, lines, words
# -----------------------------------------------------------------------------
println("--- Conversion ---")

println("chars 'hello': " + inspect(chars("hello")))

let multiline = "line one\nline two\nline three"
println("lines count: " + to_str(length(lines(multiline))))
println("first line: " + first(lines(multiline)))

let sentence = "  hello   world  "
println("words: " + inspect(words(sentence)))
println("")

# -----------------------------------------------------------------------------
# Character Classes
# -----------------------------------------------------------------------------
println("--- Character Classes ---")

let test_chars = ['A', 'a', '5', ' ', '!']
each(test_chars, (c) {
	print(to_str(c) + ": ")
	print("digit=" + to_str(is_digit(c)) + " ")
	print("alpha=" + to_str(is_alpha(c)) + " ")
	print("upper=" + to_str(is_upper(c)) + " ")
	print("lower=" + to_str(is_lower(c)) + " ")
	print("alnum=" + to_str(is_alnum(c)) + " ")
	println("space=" + to_str(is_whitespace(c)))
})

println("")

# -----------------------------------------------------------------------------
# String Predicates
# -----------------------------------------------------------------------------
println("--- String Predicates ---")

println("is_numeric('123'): " + to_str(is_numeric("123")))
println("is_numeric('12.3'): " + to_str(is_numeric("12.3")))
println("is_alphabetic('abc'): " + to_str(is_alphabetic("abc")))
println("is_alphabetic('abc1'): " + to_str(is_alphabetic("abc1")))
println("")

# -----------------------------------------------------------------------------
# Comparison
# -----------------------------------------------------------------------------
println("--- Comparison ---")

println("compare 'apple' 'banana': " + to_str(compare("apple", "banana")))
println("compare 'banana' 'apple': " + to_str(compare("banana", "apple")))
println("compare 'apple' 'apple': " + to_str(compare("apple", "apple")))
println("")

# -----------------------------------------------------------------------------
# Case Conversion
# -----------------------------------------------------------------------------
println("--- Case Conversion ---")

println("upper 'Hello World': " + upper("Hello World"))
println("lower 'Hello World': " + lower("Hello World"))
println("capitalize 'hello': " + capitalize("hello"))
println("capitalize 'HELLO': " + capitalize("HELLO"))
println("title 'hello world': " + title("hello world"))
println("equal_ignore_case 'Hello' 'HELLO': " + to_str(equal_ignore_case("Hello", "HELLO")))

# Unicode case conversion
println("")
println("Unicode case conversion:")
println("upper 'cafe': " + upper("cafe"))
println("lower 'NAIVE': " + lower("NAIVE"))
println("")

# -----------------------------------------------------------------------------
# Practical Example: Simple CSV Parser
# -----------------------------------------------------------------------------
println("--- Practical: CSV Parser ---")

let csv_data = "name,age,city\nAlice,30,Boston\nBob,25,Chicago\nCarol,35,Denver"

let rows = lines(csv_data)
let headers = split(first(rows), ",")
println("Headers: " + inspect(headers))

each(rest(rows), (row) {
	let values = split(row, ",")
	let name = first(values)
	let age = first(rest(values))
	let city = first(rest(rest(values)))
	println(name + " is " + age + " years old, lives in " + city)
})

println("")

# -----------------------------------------------------------------------------
# Practical Example: Slug Generator
# -----------------------------------------------------------------------------
println("--- Practical: Slug Generator ---")

let make_slug = (s) {
	let cleaned = lower(trim(s))
	replace(cleaned, " ", "-")
}

println("'Hello World' -> " + make_slug("Hello World"))
println("'  My Blog Post  ' -> " + make_slug("  My Blog Post  "))
println("")

# -----------------------------------------------------------------------------
# Practical Example: Simple Template
# -----------------------------------------------------------------------------
println("--- Practical: Simple Template ---")

let template = "Hello, {name}! Welcome to {place}."
let filled = replace(replace(template, "{name}", "Alice"), "{place}", "Aiki")
println(filled)
println("")

println("=== Showcase Complete ===")
