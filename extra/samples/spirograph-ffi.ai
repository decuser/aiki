import("math/ffi", :sin, :cos)
let cv = import("canvas")
let time = import("time")

let c = cv.canvas(800, 800)
cv.set_bg(c, :white)
cv.pen_size(c, 2)
let tick = 0
let R = 200
let r = 80
let d = 150
let diff = R - r
let ratio = diff / r
while tick < 5028 {
	let angle = tick / 100
	let x = 400 + ((diff * cos(angle)) + (d * cos(ratio * angle)))
	let y = 400 + ((diff * sin(angle)) - (d * sin(ratio * angle)))
	cv.dot(c, x, y, :black)
	tick = tick + 1
}

time.sleep(1000)
