# Aiki Number Guessing Game
seed(42)
let secret = random(100) + 1
let attempts = 0
let guessed = false

print("I'm thinking of a number between 1 and 100.\n")

while not guessed {
	print("Enter your guess: ")
	let input = read()
	let guess = to_number(input)
	attempts = attempts + 1
	if equal(guess, secret) {
		print("Correct! You found it in ")
		print(attempts)
		print(" attempts.")
		guessed = true
	} else {
		if guess < secret {
			print("Too low, try again.\n")
		} else {
			print("Too high, try again.\n")
		}
	}
}

print("\n")
