# Newton's Method
let my_sqrt = (x) {
	let z = 1.0
	let delta = 1.0
	while delta > 0.00001 {
		let old_z = z
		z = (z + (x / z)) / 2
		delta = abs(z - old_z)
	}
	return z
}

print(my_sqrt(9), "\n")
print(my_sqrt(2), "\n")
print(to_decimal(my_sqrt(9), 6), "\n")
print(to_decimal(my_sqrt(2), 6), "\n")
