print("ADD\n")
print(1 + 1, "\n")

print("RAT_ONE_THIRD_TIMES_THREE\n")
print((1 / 3) * 3, "\n")

print("RAT_TWO_THIRDS_PLUS_ONE_SIXTH\n")
print((2 / 3) + (1 / 6), "\n")

print("LEFT_TO_RIGHT_ONE_PLUS_TWO_TIMES_THREE\n")
print(1 + 2 * 3, "\n")

print("NEG_RATIONAL_ADD\n")
print((-1 / 2) + (3 / 2), "\n")

print("INT_PLUS_RATIONAL\n")
print(1 + (1 / 2), "\n")

print("ZERO_RATIONAL\n")
print(0 / 5, "\n")

print("MATH_SMOKE_DONE\n")
