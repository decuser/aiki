# string_utils.ai - string manipulation using rune operations
#
# Demonstrates that strings are rune sequences and can be
# manipulated with list operations plus to_str/chr/ord.
#
# NOTE: These are educational implementations. The string library provides
# optimized versions of these functions (starts_with, ends_with, etc.)
let list = import("list")

# my_slice(s, start, end) - extract substring
let my_slice = (s, start, end) {
	let result = ""
	let i = start
	while i < end {
		result = result + to_str(s[i])
		i = i + 1
	}
	return result
}

# my_starts_with(s, prefix) - check prefix
let my_starts_with = (s, prefix) {
	if length(prefix) > length(s) {
		return false
	}
	let i = 0
	while i < length(prefix) {
		if not equal(s[i], prefix[i]) {
			return false
		}
		i = i + 1
	}
	return true
}

# my_ends_with(s, suffix) - check suffix
let my_ends_with = (s, suffix) {
	if length(suffix) > length(s) {
		return false
	}
	let offset = length(s) - length(suffix)
	let i = 0
	while i < length(suffix) {
		if not equal(s[offset + i], suffix[i]) {
			return false
		}
		i = i + 1
	}
	return true
}

# my_contains(s, sub) - check substring
let my_contains = (s, sub) {
	if length(sub) > length(s) {
		return false
	}
	let limit = length(s) - length(sub)
	let i = 0
	while i <= limit {
		if equal(my_slice(s, i, i + length(sub)), sub) {
			return true
		}
		i = i + 1
	}
	return false
}

# my_join(lst, delim) - join strings with delimiter
let my_join = (lst, delim) {
	if empty(lst) {
		return ""
	}
	list.reduce(rest(lst), first(lst), (acc, x) {
		acc + delim + x
	})
}

# my_split(s, delim) - split string by delimiter
let my_split = (s, delim) {
	let result = []
	let current = ""
	let i = 0
	let dlen = length(delim)
	while i < length(s) {
		if i + dlen <= length(s) {
			if equal(my_slice(s, i, i + dlen), delim) {
				result = append(result, current)
				current = ""
				i = i + dlen
			} else {
				current = current + to_str(s[i])
				i = i + 1
			}
		} else {
			current = current + to_str(s[i])
			i = i + 1
		}
	}
	return append(result, current)
}

# my_replace(s, old, new) - replace all occurrences
let my_replace = (s, old, new) {
	my_join(my_split(s, old), new)
}

# trim helpers
let my_is_whitespace = (r) {
	equal(r, ' ') or equal(r, chr(9)) or equal(r, chr(10)) or equal(r, chr(13))
}

let my_trim_start = (s) {
	let i = 0
	while i < length(s) {
		if not my_is_whitespace(s[i]) {
			return my_slice(s, i, length(s))
		}
		i = i + 1
	}
	return ""
}

let my_trim_end = (s) {
	let i = length(s) - 1
	while i >= 0 {
		if not my_is_whitespace(s[i]) {
			return my_slice(s, 0, i + 1)
		}
		i = i - 1
	}
	return ""
}

# my_trim(s) - remove leading/trailing whitespace
let my_trim = (s) {
	my_trim_end(my_trim_start(s))
}

# Demo
list.println("=== String Utils Demo ===")
list.println("")

list.println("slice hello world 0 5:")
list.println(my_slice("hello world", 0, 5))
list.println("")

list.println("starts_with hello hel:")
list.println(my_starts_with("hello", "hel"))
list.println("")

list.println("ends_with hello llo:")
list.println(my_ends_with("hello", "llo"))
list.println("")

list.println("contains hello world wor:")
list.println(my_contains("hello world", "wor"))
list.println("")

list.println("split a,b,c by comma:")
list.println(my_split("a,b,c", ","))
list.println("")

list.println("join a b c with dash:")
list.println(my_join(["a", "b", "c"], "-"))
list.println("")

list.println("replace world with aiki:")
list.println(my_replace("hello world", "world", "aiki"))
list.println("")

list.println("trim with spaces:")
print("[")
print(my_trim("  hello  "))
list.println("]")
list.println("")

# Unicode works too
list.println("Korean split/join:")
let korean = "안녕하세요"
let runes = []
let i = 0
while i < length(korean) {
	runes = append(runes, to_str(korean[i]))
	i = i + 1
}

list.println(runes)
list.println(my_join(runes, "-"))
