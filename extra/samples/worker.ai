# worker.ai - producer/consumer pattern
let list = import("list")

let work_ch = channel()
let result_ch = channel()

let worker = (input, output) {
	while true {
		let item = recv(input)
		if equal(shape(item), :done) {
			send(output, [@done])
			return true
		}
		send(output, item * item)
	}
}

spawn(worker, work_ch, result_ch)

# send some work
send(work_ch, 5)
list.println(recv(result_ch))  # 25

send(work_ch, 7)
list.println(recv(result_ch))  # 49

send(work_ch, 10)
list.println(recv(result_ch))  # 100

# signal done
send(work_ch, [@done])
recv(result_ch)

list.println("done")
