# worker.ai - producer/consumer pattern

let work_ch = channel()
let result_ch = channel()

let worker = (input, output) {
    while true {
        let item = recv(input)
        if equal(shape(item), :done) {
            send(output, [@done])
            return true
        }
        send(output, item * item)
    }
}

spawn(worker, work_ch, result_ch)

# send some work
send(work_ch, 5)
println(recv(result_ch))  # 25

send(work_ch, 7)
println(recv(result_ch))  # 49

send(work_ch, 10)
println(recv(result_ch))  # 100

# signal done
send(work_ch, [@done])
recv(result_ch)

println("done")
