# Pragmatic module - Go-backed implementations for speed
# Same API as strict, faster execution
# Shim: pragmatic uses Go hash
let hash_code = _hash_code

# Hash map implementation (same as strict, but uses Go hash_code)
# A hash is a list of 64 buckets, each bucket is a list of [key, value] pairs
let _HASH_SIZE = 64

let hash_new = () {
	let buckets = []
	let i = 0
	while i < _HASH_SIZE {
		buckets = append(buckets, [])
		i = i + 1
	}
	return buckets
}

let _bucket_index = (key) {
	return hash_code(key) % _HASH_SIZE
}

let hash_get = (h, key) {
	let idx = _bucket_index(key)
	let bucket = h[idx]
	let i = 0
	while i < length(bucket) {
		let pair = bucket[i]
		if equal(pair[0], key) {
			return pair[1]
		}
		i = i + 1
	}
	return [@error, "key not found"]
}

let hash_put = (h, key, val) {
	let idx = _bucket_index(key)
	let bucket = h[idx]
	let new_bucket = []
	let found = false
	let i = 0
	while i < length(bucket) {
		let pair = bucket[i]
		if equal(pair[0], key) {
			new_bucket = append(new_bucket, [key, val])
			found = true
		} else {
			new_bucket = append(new_bucket, pair)
		}
		i = i + 1
	}
	if not found {
		new_bucket = append(new_bucket, [key, val])
	}
	# Build new hash with updated bucket
	let new_h = []
	let j = 0
	while j < _HASH_SIZE {
		if j == idx {
			new_h = append(new_h, new_bucket)
		} else {
			new_h = append(new_h, h[j])
		}
		j = j + 1
	}
	return new_h
}

let hash_has = (h, key) {
	let result = hash_get(h, key)
	return shape(result) != :error
}

let hash_del = (h, key) {
	let idx = _bucket_index(key)
	let bucket = h[idx]
	let new_bucket = []
	let i = 0
	while i < length(bucket) {
		let pair = bucket[i]
		if not equal(pair[0], key) {
			new_bucket = append(new_bucket, pair)
		}
		i = i + 1
	}
	# Build new hash with updated bucket
	let new_h = []
	let j = 0
	while j < _HASH_SIZE {
		if j == idx {
			new_h = append(new_h, new_bucket)
		} else {
			new_h = append(new_h, h[j])
		}
		j = j + 1
	}
	return new_h
}

let hash_keys = (h) {
	let keys = []
	let i = 0
	while i < _HASH_SIZE {
		let bucket = h[i]
		let j = 0
		while j < length(bucket) {
			let pair = bucket[j]
			keys = append(keys, pair[0])
			j = j + 1
		}
		i = i + 1
	}
	return keys
}

let hash_values = (h) {
	let vals = []
	let i = 0
	while i < _HASH_SIZE {
		let bucket = h[i]
		let j = 0
		while j < length(bucket) {
			let pair = bucket[j]
			vals = append(vals, pair[1])
			j = j + 1
		}
		i = i + 1
	}
	return vals
}
