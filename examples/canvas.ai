let c = canvas(800, 800)
let outer_radius = 200
let inner_radius = 80
let pen_distance = 150
let diff = outer_radius - inner_radius
let ratio = diff / inner_radius
let tick = 0
while tick < 6280 {
    let angle = tick / 100
    let x = 400 + diff * cos(angle) + pen_distance * cos(ratio * angle)
    let y = 400 + diff * sin(angle) - pen_distance * sin(ratio * angle)
    dot(c, x, y, :cyan)
    tick = tick + 1
}

sleep(1000)
