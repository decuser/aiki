# Absolute Value Function
let abs = (x) {
    if x < 0 { 
        return -x 
    }
    return x
}

# Newton's Method
let sqrt = (x) {
    let z = 1.0
    let delta = 1.0

    while delta > 0.00001 {
        let old_z = z
        
        z = (z + (x / z)) / 2.0
        
        delta = abs(z - old_z)
    }

    return z
}

# Test
let result = sqrt(2)
print(result, "\n")
