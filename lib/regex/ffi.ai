package "regex/ffi"

# regex/ffi - RE2-syntax regular expressions backed by Go's regexp
#
# Usage:
#   let re = import("regex/ffi")
#   re.matches("hello world", "^hello")
#   "hello" |> re.matches("^h")
#
# Or import specific functions:
#   import("regex/ffi", :matches, :find, :replace)
# matches(string, pattern) -> bool
# Returns true if pattern matches anywhere in string.
let matches = (s, pattern) {
	_regex_match(s, pattern)
}

# find(string, pattern) -> [@match, start, end, text] or [@error, :regex, reason]
# Finds the first match of pattern in string.
let find = (s, pattern) {
	_regex_find(s, pattern)
}

# find_all(string, pattern) -> list of [@match, start, end, text]
# Finds all non-overlapping matches.
let find_all = (s, pattern) {
	_regex_find_all(s, pattern)
}

# replace(string, pattern, replacement) -> string
# Replaces all matches of pattern with replacement.
# Use $1, $2 etc. in replacement to refer to capture groups.
let replace = (s, pattern, replacement) {
	_regex_replace(s, pattern, replacement)
}

# replace_first(string, pattern, replacement) -> string
# Replaces only the first match.
let replace_first = (s, pattern, replacement) {
	_regex_replace_first(s, pattern, replacement)
}

# split(string, pattern) -> list of strings
# Splits string by pattern.
let split = (s, pattern) {
	_regex_split(s, pattern)
}

export(:matches, :find, :find_all, :replace, :replace_first, :split)
