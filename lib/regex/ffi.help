# regex/ffi - provider interop using Go/RE2-style regular expressions

@func matches
@template "matches(s, pattern)"
@help "Returns true if pattern matches anywhere in s."

@func find
@template "find(s, pattern)"
@help "Returns [@match, start, end, text] with rune positions, or [@error, :regex, msg]."

@func find_all
@template "find_all(s, pattern)"
@help "Returns list of [@match, start, end, text], or []."

@func replace
@template "replace(s, pattern, replacement)"
@help "Replaces all matches with replacement."

@func replace_first
@template "replace_first(s, pattern, replacement)"
@help "Replaces first match with replacement."

@func split
@template "split(s, pattern)"
@help "Splits s at matches of pattern into a list."
