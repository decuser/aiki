package "turtle"
let _math = import("math/native")

# turtle - Logo-style turtle graphics
#
# Turtle uses centered logical coordinates:
#   home = (0, 0)
#   positive x = right
#   positive y = up
#   heading 0 = north, clockwise positive
# turtle(cvs) -> [@turtle, cvs, cx, cy, tx, ty, heading, pen, color]
# Shape stored separately, Elements = [cvs, cx, cy, tx, ty, heading, pen, color]
# indices:                              0    1   2   3   4     5       6    7
let turtle = (canvas) {
	let w = _canvas_width(canvas)
	let h = _canvas_height(canvas)
	[@turtle, canvas, w / 2, h / 2, 0, 0, 0, true, :white]
}

# internal accessors (shape excluded from indexing)
let _cvs = (t) {
	t[0]
}

let _cx = (t) {
	t[1]
}

let _cy = (t) {
	t[2]
}

let _tx = (t) {
	t[3]
}

let _ty = (t) {
	t[4]
}

let _heading = (t) {
	t[5]
}

let _pen = (t) {
	t[6]
}

let _color = (t) {
	t[7]
}

# coordinate transform: turtle logical -> canvas screen
let _screen_x = (t, tx) {
	_cx(t) + tx
}

let _screen_y = (t, ty) {
	_cy(t) - ty
}

# deg->rad constant
let _deg_to_rad = 3.141592653589793 / 180
let _trig_terms = 30

# Turtle headings are expressed in degrees. Cardinal headings have exact
# direction vectors; preserve those exactly instead of routing them through
# an approximation of pi. Other headings use the native Aiki trig path.
let _direction = (angle) {
	let h = angle
	while h < 0 {
		h = h + 360
	}
	while h >= 360 {
		h = h - 360
	}
	if equal(h, 0) {
		return [0, 1]
	}
	if equal(h, 90) {
		return [1, 0]
	}
	if equal(h, 180) {
		return [0, -1]
	}
	if equal(h, 270) {
		return [-1, 0]
	}
	let rad = h * _deg_to_rad
	[_math.sin(rad, _trig_terms), _math.cos(rad, _trig_terms)]
}

# inspection (returns logical coordinates)
let position = (t) {
	[_tx(t), _ty(t)]
}

let heading = (t) {
	_heading(t)
}

# movement
let forward = (t, distance) {
	# heading 0 = north, clockwise positive
	# north means dy positive, so: dx = sin(h), dy = cos(h)
	let direction = _direction(_heading(t))
	let dx = distance * direction[0]
	let dy = distance * direction[1]
	let tx0 = _tx(t)
	let ty0 = _ty(t)
	let tx1 = tx0 + dx
	let ty1 = ty0 + dy
	if _pen(t) {
		_canvas_command(_cvs(t), :line, [
			_screen_x(t, tx0),
			_screen_y(t, ty0),
			_screen_x(t, tx1),
			_screen_y(t, ty1),
			_color(t)
		])
	} else {
		true
	}
	[@turtle, _cvs(t), _cx(t), _cy(t), tx1, ty1, _heading(t), _pen(t), _color(t)]
}

let backward = (t, distance) {
	forward(t, 0 - distance)
}

let left = (t, angle) {
	[@turtle, _cvs(t), _cx(t), _cy(t), _tx(t), _ty(t), _heading(t) - angle, _pen(t), _color(t)]
}

let right = (t, angle) {
	[@turtle, _cvs(t), _cx(t), _cy(t), _tx(t), _ty(t), _heading(t) + angle, _pen(t), _color(t)]
}

let pen_up = (t) {
	[@turtle, _cvs(t), _cx(t), _cy(t), _tx(t), _ty(t), _heading(t), false, _color(t)]
}

let pen_down = (t) {
	[@turtle, _cvs(t), _cx(t), _cy(t), _tx(t), _ty(t), _heading(t), true, _color(t)]
}

let set_color = (t, color) {
	[@turtle, _cvs(t), _cx(t), _cy(t), _tx(t), _ty(t), _heading(t), _pen(t), color]
}

let home = (t) {
	if _pen(t) {
		_canvas_command(_cvs(t), :line, [
			_screen_x(t, _tx(t)),
			_screen_y(t, _ty(t)),
			_cx(t),
			_cy(t),
			_color(t)
		])
	} else {
		true
	}
	[@turtle, _cvs(t), _cx(t), _cy(t), 0, 0, 0, _pen(t), _color(t)]
}

let clear = (t) {
	_canvas_command(_cvs(t), :clear, [])
	t
}

export(
	:turtle,
	:forward,
	:backward,
	:left,
	:right,
	:pen_up,
	:pen_down,
	:set_color,
	:home,
	:clear,
	:position,
	:heading
)
