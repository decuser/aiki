package "system"

# system - host program environment
let args = () {
	_system_args()
}

let env = (name) {
	_system_env(name)
}

let cwd = () {
	_system_cwd()
}

let chdir = (path) {
	_system_chdir(path)
}

let exec = (command, args) {
	_system_exec(command, args)
}

export(:args, :env, :cwd, :chdir, :exec)
