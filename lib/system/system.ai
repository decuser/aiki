package "system"

# system - host program environment
let args = () {
	_system_args()
}

let env = (name) {
	_system_env(name)
}

let environ = () {
	_system_environ()
}

let set_env = (name, value) {
	_system_set_env(name, value)
}

let unset_env = (name) {
	_system_unset_env(name)
}

let cwd = () {
	_system_cwd()
}

let chdir = (path) {
	_system_chdir(path)
}

let exec = (command, args) {
	_system_exec(command, args)
}

let has = (capability) {
	_system_has(capability)
}

let require = (capability) {
	_system_require(capability)
}

export(:args, :env, :environ, :set_env, :unset_env, :cwd, :chdir, :exec, :has, :require)
