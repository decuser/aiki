let test = import("test")
let system = import("system")

let run = test.run
let is_true = test.is_true

run("system args returns a list", () {
	is_true(equal(type(system.args()), :list))
})

run("missing environment variable is recoverable error", () {
	is_true(is_error(system.env("AIKI_TEST_ENVIRONMENT_VARIABLE_SHOULD_NOT_EXIST_7094")))
})
