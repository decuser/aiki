# system - Aiki runtime environment and host-system capability

@func args
@template "args()"
@help "Returns the Aiki program arguments as a list of strings."

@func exit
@template "exit(code)"
@help "Terminates the current Aiki program with exit status 0 through 255 after runtime cleanup."

@func env
@template "env(name)"
@help "Returns an environment variable value, or [@error, :environment, msg] if it is not set."

@func environ
@template "environ()"
@help "Returns the runtime-owned environment as sorted [@env, name, value] entries."

@func set_env
@template "set_env(name, value)"
@help "Sets an environment variable in this Aiki runtime and future child processes."

@func unset_env
@template "unset_env(name)"
@help "Removes an environment variable from this Aiki runtime and future child processes."

@func cwd
@template "cwd()"
@help "Returns the working directory owned by this Aiki runtime."

@func chdir
@template "chdir(path)"
@help "Changes this Aiki runtime's working directory without changing the host process CWD."

@func exec
@template "exec(command, args)"
@help "Runs a command synchronously and returns [@ok, stdout, stderr, exit_code] or [@error, :process, msg]."

@func has
@template "has(capability)"
@help "Reports whether the current runtime provides an Aiki capability."

@func require
@template "require(capability)"
@help "Succeeds when a capability is available or returns an :unsupported error."
