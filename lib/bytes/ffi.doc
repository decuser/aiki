@preamble use("bytes/ffi")
str_to_bytes
Converts a string to a list of byte values (integers 0-255).
Each character is converted to its UTF-8 byte representation.

str_to_bytes(s)

let b = str_to_bytes("ABC")
b    # <bytes:3 [65 66 67]>
===
bytes_to_str
Converts a list of byte values back to a string.

bytes_to_str(bytes)

let b = str_to_bytes("ABC")
bytes_to_str(b)    # "ABC"
===
bytes_new
Creates a byte value from the elements of a list.
Each element must be an integer between 0 and 255, inclusive.

bytes_new(list)

bytes_new([65, 66, 67])    # <bytes:3 [65 66 67]>
===
bytes_get
Returns the byte value at the given index.

bytes_get(bytes, i)

let b = str_to_bytes("ABC")
bytes_get(b, 1)    # 66
===
bytes_length
Returns the length of a byte list.

bytes_length(bytes)

let b = str_to_bytes("ABC")
bytes_length(b)    # 3
===
bytes_slice
Returns a slice of the byte list from start (inclusive) to end (exclusive).

bytes_slice(bytes, start, end)

let b = str_to_bytes("ABCD")
bytes_slice(b, 1, 3)    # <bytes:2 [66 67]>

===
digits_from_text
Decodes ASCII decimal digits into raw byte values 0-9. This is useful at
text protocol boundaries where the in-memory representation should remain
bytes rather than a list of characters.

digits_from_text(text)

let b = digits_from_text("0123")
b    # <bytes:4 [0 1 2 3]>
===
digits_to_text
Encodes raw byte values 0-9 as ASCII decimal digits.

digits_to_text(bytes)

let b = digits_from_text("0123")
digits_to_text(b)    # "0123"
