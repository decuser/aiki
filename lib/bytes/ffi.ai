package "bytes/ffi"

# bytes/ffi - fast opaque bytes using host arrays
# Bytes are an opaque type backed by Go []byte.
# Use specialized functions: bytes_get, bytes_length, bytes_slice.
# Convert string to bytes (UTF-8 encoding)
let str_to_bytes = (s) {
	_str_to_bytes(s)
}

# Convert bytes to string (UTF-8 decoding)
let bytes_to_str = (bytes) {
	_bytes_to_str(bytes)
}

# Create bytes from list of integers (0-255)
let bytes_new = (list) {
	_bytes_new(list)
}

# Get byte at index (returns number 0-255)
let bytes_get = (bytes, i) {
	_bytes_get(bytes, i)
}

# Get length of bytes
let bytes_length = (bytes) {
	_bytes_length(bytes)
}

# Slice bytes from start to end (exclusive)
let bytes_slice = (bytes, start, end) {
	_bytes_slice(bytes, start, end)
}

# Decode ASCII decimal digits into raw byte values 0-9.
let digits_from_text = (text) {
	_bytes_digits_from_text(text)
}

# Encode raw byte values 0-9 as ASCII decimal digits.
let digits_to_text = (bytes) {
	_bytes_digits_to_text(bytes)
}

export(
	:str_to_bytes,
	:bytes_to_str,
	:bytes_new,
	:bytes_get,
	:bytes_length,
	:bytes_slice,
	:digits_from_text,
	:digits_to_text
)
