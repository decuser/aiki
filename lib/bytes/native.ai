package "bytes/native"

# Import dependencies from lib
let _math = import("math/native")

# bytes/native - pure aiki bytes as shaped lists
# Bytes are represented as @bytes shaped lists where each element is 0-255.
# Works with standard list operations: first, rest, length, map, etc.
# Helper to create @bytes shaped list
let _make_bytes = (elements) {
	shaped(:bytes, elements)
}

# Convert string to bytes (UTF-8 encoding)
let str_to_bytes = (s) {
	let result = []
	let i = 0
	let len = length(s)
	while i < len {
		let r = s[i]
		let code = ord(r)
		# UTF-8 encoding
		if code < 128 {
			result = append(result, code)
		} else {
			if code < 2048 {
				result = append(result, 192 + _math.floor(code / 64))
				result = append(result, 128 + _math.modulo(code, 64))
			} else {
				if code < 65536 {
					result = append(result, 224 + _math.floor(code / 4096))
					result = append(result, 128 + _math.modulo(_math.floor(code / 64), 64))
					result = append(result, 128 + _math.modulo(code, 64))
				} else {
					result = append(result, 240 + _math.floor(code / 262144))
					result = append(result, 128 + _math.modulo(_math.floor(code / 4096), 64))
					result = append(result, 128 + _math.modulo(_math.floor(code / 64), 64))
					result = append(result, 128 + _math.modulo(code, 64))
				}
			}
		}
		i = i + 1
	}
	return _make_bytes(result)
}

# Convert bytes to string (UTF-8 decoding)
let bytes_to_str = (bytes) {
	if not equal(shape(bytes), :bytes) {
		return [@error, :bytes, "expected @bytes shape"]
	}
	let result = ""
	let i = 0
	while i < length(bytes) {
		let b0 = bytes[i]
		if b0 < 128 {
			result = result + to_str(chr(b0))
			i = i + 1
		} else {
			if b0 < 224 {
				if i + 1 >= length(bytes) {
					return [@error, :bytes, "truncated UTF-8 sequence"]
				}
				let b1 = bytes[i + 1]
				let code = (b0 - 192) * 64 + (b1 - 128)
				result = result + to_str(chr(code))
				i = i + 2
			} else {
				if b0 < 240 {
					if i + 2 >= length(bytes) {
						return [@error, :bytes, "truncated UTF-8 sequence"]
					}
					let b1 = bytes[i + 1]
					let b2 = bytes[i + 2]
					let code = (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128)
					result = result + to_str(chr(code))
					i = i + 3
				} else {
					if i + 3 >= length(bytes) {
						return [@error, :bytes, "truncated UTF-8 sequence"]
					}
					let b1 = bytes[i + 1]
					let b2 = bytes[i + 2]
					let b3 = bytes[i + 3]
					let code = (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128)
					result = result + to_str(chr(code))
					i = i + 4
				}
			}
		}
	}
	return result
}

# Create bytes from list of integers
let bytes_new = (list) {
	let result = []
	let i = 0
	let len = length(list)
	while i < len {
		let n = list[i]
		if n < 0 {
			return [@error, :bytes, "byte value must be >= 0"]
		}
		if n > 255 {
			return [@error, :bytes, "byte value must be <= 255"]
		}
		if not equal(n, truncate(n)) {
			return [@error, :bytes, "byte value must be an integer"]
		}
		result = append(result, n)
		i = i + 1
	}
	return _make_bytes(result)
}

# Get byte at index (returns number 0-255)
let bytes_get = (bytes, i) {
	if not equal(shape(bytes), :bytes) {
		return [@error, :bytes, "expected @bytes shape"]
	}
	bytes[i]
}

# Get length of bytes
let bytes_length = (bytes) {
	if not equal(shape(bytes), :bytes) {
		return [@error, :bytes, "expected @bytes shape"]
	}
	length(bytes)
}

# Slice bytes from start to end (exclusive)
let bytes_slice = (bytes, start, end) {
	if not equal(shape(bytes), :bytes) {
		return [@error, :bytes, "expected @bytes shape"]
	}
	let result = []
	let i = start
	while i < end {
		result = append(result, bytes[i])
		i = i + 1
	}
	return _make_bytes(result)
}

# Decode ASCII decimal digits into raw byte values 0-9.
let digits_from_text = (text) {
	let result = []
	let i = 0
	while i < length(text) {
		let n = ord(text[i]) - 48
		if n < 0 or n > 9 {
			return [@error, :bytes, "expected ASCII decimal digit"]
		}
		result = append(result, n)
		i = i + 1
	}
	return _make_bytes(result)
}

# Encode raw byte values 0-9 as ASCII decimal digits.
let digits_to_text = (bytes) {
	if not equal(shape(bytes), :bytes) {
		return [@error, :bytes, "expected @bytes shape"]
	}
	let result = ""
	let i = 0
	while i < length(bytes) {
		let n = bytes[i]
		if n < 0 or n > 9 {
			return [@error, :bytes, "expected digit byte 0-9"]
		}
		result = result + to_str(chr(48 + n))
		i = i + 1
	}
	return result
}

export(
	:str_to_bytes,
	:bytes_to_str,
	:bytes_new,
	:bytes_get,
	:bytes_length,
	:bytes_slice,
	:digits_from_text,
	:digits_to_text
)
