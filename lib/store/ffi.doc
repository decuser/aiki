@preamble use("store/ffi")
new_byte
Creates fixed-size mutable storage containing byte values.

new_byte(length)

type(new_byte)    # :function
===
new_word
Creates fixed-size mutable storage containing word values.

new_word(length)

type(new_word)    # :function
===
new_addr18
Creates fixed-size mutable storage containing 18-bit address values.

new_addr18(length)

type(new_addr18)    # :function
===
get
Reads the value at an indexed store location.

get(store, index)

type(get)    # :function
===
set
Writes a value at an indexed store location.

set(store, index, value)

type(set)    # :function
===
length
Returns the number of locations in a store.

length(store)

type(length)    # :function
===
snapshot
Returns a stable snapshot of the store contents.

snapshot(store)

type(snapshot)    # :function
===
word_read_addr
Reads a word through an 18-bit byte address.

word_read_addr(store, address)

type(word_read_addr)    # :function
===
word_write_addr
Writes a word through an 18-bit byte address.

word_write_addr(store, address, value)

type(word_write_addr)    # :function
===
byte_read_addr
Reads a byte through an 18-bit byte address.

byte_read_addr(store, address)

type(byte_read_addr)    # :function
===
byte_write_addr
Writes a byte through an 18-bit byte address.

byte_write_addr(store, address, value)

type(byte_write_addr)    # :function
===
new_counter
Creates fixed-size mutable counter storage.

new_counter(length)

type(new_counter)    # :function
===
counter_get
Reads a counter value.

counter_get(store, index)

type(counter_get)    # :function
===
counter_set
Sets a counter value.

counter_set(store, index, value)

type(counter_set)    # :function
===
counter_add
Adds an amount to a counter value.

counter_add(store, index, amount)

type(counter_add)    # :function
