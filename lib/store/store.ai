package "store"

# store - explicit mutable indexed storage
let new = (size) {
	_store_new(size)
}

let get = (store, index) {
	_store_get(store, index)
}

let set = (store, index, value) {
	_store_set(store, index, value)
}

let length = (store) {
	_store_length(store)
}

let snapshot = (store, ...args) {
	if empty(args) {
		return _store_snapshot(store)
	}
	if not empty(rest(args)) {
		return [@error, :arity, "snapshot expects store and optional count"]
	}
	return _store_snapshot(store, first(args))
}

let digits_to_text = (store, ...args) {
	if empty(args) {
		return _store_digits_to_text(store)
	}
	if not empty(rest(args)) {
		return [@error, :arity, "digits_to_text expects store and optional count"]
	}
	return _store_digits_to_text(store, first(args))
}

let checksum = (store, ...args) {
	if empty(args) {
		return _store_checksum(store)
	}
	if not empty(rest(args)) {
		return [@error, :arity, "checksum expects store and optional count"]
	}
	return _store_checksum(store, first(args))
}

export(:new, :get, :set, :length, :snapshot, :digits_to_text, :checksum)
