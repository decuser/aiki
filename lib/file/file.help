# file - file I/O operations

@func open
@template "open(path, mode)"
@help "Opens file. mode is :read, :write, or :append."

@func read_text
@template "read_text(file)"
@help "Reads entire remaining file as string."

@func read_bytes
@template "read_bytes(file)"
@help "Reads entire remaining file as bytes."

@func read_line
@template "read_line(file)"
@help "Reads next line. Returns string, [@end] at EOF, or [@error, :io, msg]."

@func write_text
@template "write_text(file, s)"
@help "Writes string to file."

@func write_bytes
@template "write_bytes(file, b)"
@help "Writes bytes to file."

@func close
@template "close(file)"
@help "Closes file handle."

@func exists
@template "exists(path)"
@help "Returns true if path exists."

@func delete
@template "delete(path)"
@help "Deletes file at path."

@func list
@template "list(path)"
@help "Returns a sorted list of immediate directory entry names, or [@error, :io, msg]."

@func read_at
@template "read_at(file, offset, count)"
@help "Reads up to count bytes at offset without changing the sequential file position."

@func write_at
@template "write_at(file, offset, bytes)"
@help "Writes bytes at offset without changing the sequential file position."


@func stat
@template "stat(path)"
@help "Returns [@stat, size, modified_ms, is_dir], or [@error, :io, msg]."

@func rename
@template "rename(old_path, new_path)"
@help "Renames a filesystem object. Returns true or [@error, :io, msg]."

@func mkdir
@template "mkdir(path)"
@help "Creates one directory. Returns true or [@error, :io, msg]."

@func mkdir_all
@template "mkdir_all(path)"
@help "Creates a directory and missing parents. Returns true or [@error, :io, msg]."

@func remove_all
@template "remove_all(path)"
@help "Recursively removes path. Returns true or [@error, :io, msg]."

@func temp
@template "temp()"
@help "Creates an empty temporary file and returns its path, or [@error, :io, msg]."

@func temp_dir
@template "temp_dir()"
@help "Creates a temporary directory and returns its path, or [@error, :io, msg]."

@func copy
@template "copy(src, dst)"
@help "Copies file contents from src to dst. Returns true or [@error, :io, msg]."

@func size
@template "size(path)"
@help "Returns file size in bytes, or [@error, :io, msg]."
