package "file"

# file - file I/O operations
let open = (path, mode) {
	_file_open(path, mode)
}

let read_text = (file) {
	_file_read_text(file)
}

let read_bytes = (file) {
	_file_read_bytes(file)
}

let read_line = (file) {
	_file_read_line(file)
}

let write_text = (file, s) {
	_file_write_text(file, s)
}

let write_bytes = (file, b) {
	_file_write_bytes(file, b)
}

let close = (file) {
	_file_close(file)
}

let read_all = (path) {
	let file = open(path, :read)
	if is_error(file) {
		return file
	}
	let result = read_text(file)
	let closed = close(file)
	if is_error(result) {
		return result
	}
	if is_error(closed) {
		return closed
	}
	return result
}

let write_all = (path, text) {
	let file = open(path, :write)
	if is_error(file) {
		return file
	}
	let result = write_text(file, text)
	let closed = close(file)
	if is_error(result) {
		return result
	}
	if is_error(closed) {
		return closed
	}
	return true
}

let read_all_bytes = (path) {
	let file = open(path, :read)
	if is_error(file) {
		return file
	}
	let result = read_bytes(file)
	let closed = close(file)
	if is_error(result) {
		return result
	}
	if is_error(closed) {
		return closed
	}
	return result
}

let write_all_bytes = (path, bytes) {
	let file = open(path, :write)
	if is_error(file) {
		return file
	}
	let result = write_bytes(file, bytes)
	let closed = close(file)
	if is_error(result) {
		return result
	}
	if is_error(closed) {
		return closed
	}
	return true
}

let exists = (path) {
	_file_exists(path)
}

let delete = (path) {
	_file_delete(path)
}

let list = (path) {
	_file_list(path)
}

let read_at = (file, offset, count) {
	_file_read_at(file, offset, count)
}

let write_at = (file, offset, bytes) {
	_file_write_at(file, offset, bytes)
}

let stat = (path) {
	_file_stat(path)
}

let rename = (old_path, new_path) {
	_file_rename(old_path, new_path)
}

let mkdir = (path) {
	_file_mkdir(path)
}

let mkdir_all = (path) {
	_file_mkdir_all(path)
}

let remove_all = (path) {
	_file_remove_all(path)
}

let temp = () {
	_file_temp()
}

let temp_dir = () {
	_file_temp_dir()
}

let copy = (src, dst) {
	_file_copy(src, dst)
}

let size = (path) {
	_file_size(path)
}

let walk = (path) {
	_file_walk(path)
}

let symlink = (target, link_path) {
	_file_symlink(target, link_path)
}

let read_link = (path) {
	_file_read_link(path)
}

let permissions = (path) {
	_file_permissions(path)
}

let chmod = (path, mode) {
	_file_chmod(path, mode)
}

export(
	:open,
	:read_text,
	:read_bytes,
	:read_line,
	:write_text,
	:write_bytes,
	:close,
	:read_all,
	:write_all,
	:read_all_bytes,
	:write_all_bytes,
	:exists,
	:delete,
	:list,
	:read_at,
	:write_at,
	:stat,
	:rename,
	:mkdir,
	:mkdir_all,
	:remove_all,
	:temp,
	:temp_dir,
	:copy,
	:size,
	:walk,
	:symlink,
	:read_link,
	:permissions,
	:chmod
)
