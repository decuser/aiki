package "file"

# file - file I/O operations
let open = (path, mode) {
	_file_open(path, mode)
}

let read_text = (file) {
	_file_read_text(file)
}

let read_bytes = (file) {
	_file_read_bytes(file)
}

let read_line = (file) {
	_file_read_line(file)
}

let write_text = (file, s) {
	_file_write_text(file, s)
}

let write_bytes = (file, b) {
	_file_write_bytes(file, b)
}

let close = (file) {
	_file_close(file)
}

let exists = (path) {
	_file_exists(path)
}

let delete = (path) {
	_file_delete(path)
}

export(:open, :read_text, :read_bytes, :read_line, :write_text, :write_bytes, :close, :exists, :delete)
