@module file
@summary Handle-based file I/O operations.

@function open
@signature open(path, mode)
@description Opens a file with the specified mode.
@param path String path to the file (relative to CWD).
@param mode Symbol: :read, :write, or :append.
@returns File handle on success, [@error, :io, msg] on failure.
@example
let f = open("data.txt", :read)
match f {
    [@error, _, msg] { println("Failed: " + msg) }
    _ { println("Opened!") }
}

@function read_text
@signature read_text(file)
@description Reads entire remaining file content as a string.
@param file File handle opened with :read mode.
@returns String content or [@error, :io, msg].

@function read_bytes
@signature read_bytes(file)
@description Reads entire remaining file content as bytes.
@param file File handle opened with :read mode.
@returns Bytes value or [@error, :io, msg].

@function read_line
@signature read_line(file)
@description Reads the next line from file, stripping newline.
@param file File handle opened with :read mode.
@returns Line string, [@end] at EOF, or [@error, :io, msg].

@function write_text
@signature write_text(file, s)
@description Writes a string to file.
@param file File handle opened with :write or :append mode.
@param s String to write.
@returns true on success, [@error, :io, msg] on failure.

@function write_bytes
@signature write_bytes(file, b)
@description Writes bytes to file.
@param file File handle opened with :write or :append mode.
@param b Bytes value to write.
@returns true on success, [@error, :io, msg] on failure.

@function close
@signature close(file)
@description Closes a file handle.
@param file File handle to close.
@returns true on success, [@error, :io, msg] on failure.

@function exists
@signature exists(path)
@description Checks if a path exists.
@param path String path to check.
@returns true if path exists, false otherwise.

@function delete
@signature delete(path)
@description Deletes a file.
@param path String path to file.
@returns true on success, [@error, :io, msg] on failure.
