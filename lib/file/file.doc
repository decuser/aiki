@preamble use("file")
open
@unchecked
Opens the file named by path and returns a file handle.
mode is :read to read an existing file, :write to create or replace one, or
:append to write at the end of one.
Returns [@error, :io, msg] if the file cannot be opened or mode is not one of
the permitted symbols.

open(path, mode)

let f = open("data.txt", :read)
match f {
    [@error, _, msg] { println("Failed: " + msg) }
    _ { println("Opened") }
}
===
read_text
@unchecked
Reads all remaining contents of file and returns them as a string.
Returns "" at end of file, or [@error, :io, msg] on failure.

read_text(file)

let f = open("data.txt", :read)
let text = read_text(f)
close(f)
===
read_bytes
@unchecked
Reads all remaining contents of file and returns them as a bytes value.
Returns an empty bytes value at end of file, or [@error, :io, msg] on failure.

read_bytes(file)

let f = open("data.bin", :read)
let b = read_bytes(f)
close(f)
===
read_line
@unchecked
Reads and returns the next line of file as a string.
A terminating newline is not included, and a carriage return immediately
preceding it is also removed.
Returns [@end] once end of file is reached, or [@error, :io, msg] on failure.

read_line(file)

let f = open("data.txt", :read)
read_line(f)    # "one"
read_line(f)    # "two"
===
write_text
@unchecked
Writes string s to file and returns true on success.
No newline or other character is added.
Returns [@error, :io, msg] on failure.

write_text(file, s)

let f = open("out.txt", :write)
write_text(f, "hello\n")
close(f)
===
write_bytes
@unchecked
Writes the contents of bytes value b to file and returns true on success.
Returns [@error, :io, msg] on failure.

write_bytes(file, b)

let f = open("out.bin", :write)
write_bytes(f, str_to_bytes("hi"))
close(f)
===
close
@unchecked
Closes file and returns true.
Closing an already closed handle, or an operating-system error while closing,
returns [@error, :io, msg].

close(file)

let f = open("data.txt", :read)
close(f)    # true
===
exists
@unchecked
Returns true if a file-system object exists at path, and false otherwise.
Errors encountered while determining existence, including access errors, also
produce false.

exists(path)

exists("data.txt")      # true
exists("missing.txt")   # false
===
delete
@unchecked
Removes the file-system object named by path and returns true on success.
Returns [@error, :io, msg] if the object cannot be removed.

delete(path)

delete("scratch.txt")    # true
===
list
Returns the names of the immediate entries in a directory as a lexically
sorted list of strings. The returned names are relative entry names, not full
paths. Returns [@error, :io, msg] if the directory cannot be read.

list(path)

let entries = list("lib")
type(entries)    # :list
===
read_at
@unchecked
Reads up to count bytes beginning at offset without changing the file's
sequential position. Offset and count must be non-negative integers. Reading
at or beyond end of file returns the bytes available, possibly an empty bytes
value.

read_at(file, offset, count)
===
write_at
@unchecked
Writes bytes beginning at offset without changing the file's sequential
position. Offset must be a non-negative integer. Use :write or :read_write
mode for random-access writes; :read_write does not truncate an existing file.
Returns true on a complete write or [@error, :io, msg] on failure.

write_at(file, offset, bytes)
===
stat
@unchecked
Returns filesystem metadata as [@stat, size, modified_ms, is_dir]. size is in
bytes, modified_ms is milliseconds since the Unix epoch, and is_dir is a
boolean. Returns [@error, :io, msg] when metadata cannot be read.

stat(path)
===
rename
@unchecked
Renames or moves a filesystem object within the capabilities of the host
filesystem. Returns true on success or [@error, :io, msg].

rename(old_path, new_path)
===
mkdir
@unchecked
Creates one directory. Its parent must already exist. Returns true on success
or [@error, :io, msg].

mkdir(path)
===
mkdir_all
@unchecked
Creates a directory and any missing parent directories. Returns true on
success or [@error, :io, msg].

mkdir_all(path)
===
remove_all
@unchecked
Recursively removes path and anything beneath it. Returns true on success or
[@error, :io, msg]. Use deliberately: this operation can remove a directory
tree.

remove_all(path)
===
temp
@unchecked
Creates a new empty temporary file using the host temporary-file facility,
closes it, and returns its path as a string. Returns [@error, :io, msg] on
failure.

temp()
===
temp_dir
@unchecked
Creates a new temporary directory using the host temporary-directory facility
and returns its path as a string. Returns [@error, :io, msg] on failure.

temp_dir()
===
copy
@unchecked
Copies the bytes of src to dst, creating or replacing dst. Returns true on
success or [@error, :io, msg].

copy(src, dst)
===
size
@unchecked
Returns the filesystem-reported size of path in bytes, or [@error, :io, msg].

size(path)

===
walk
@unchecked
Returns path and its descendants. Relative input produces paths relative to the
runtime working directory; absolute input produces absolute paths. Directory
symlinks are not followed.

walk(path)
===
symlink
@unchecked
Creates link_path pointing to target. A relative target is preserved exactly and
is interpreted by the host relative to the link's directory. Requires the
:symlink capability.

symlink(target, link_path)
===
read_link
@unchecked
Returns the stored target of a symbolic link. Requires :symlink.

read_link(path)
===
permissions
@unchecked
Returns permission bits using the portable permission vocabulary exposed by the
current substrate. The Go substrate reports os.FileMode.Perm bits. Requires
:permissions.

permissions(path)
===
chmod
@unchecked
Requests permission bits in the range 0..0777. The substrate maps those bits to
the host permission model and reports ordinary Aiki I/O errors when the host
cannot perform the request. Requires :permissions.

chmod(path, mode)
===
read_all
Reads the entire file at path as text, closes the file, and returns the string.
Returns a shaped :io error if open, read, or close fails.

read_all(path)

let p = temp()
write_all(p, "alpha\nbeta")    # true
read_all(p)    # "alpha\nbeta"
delete(p)    # true
===
write_all
Creates or replaces path with text, closes the file, and returns true. Returns a
shaped :io error if open, write, or close fails.

write_all(path, text)

let p = temp()
write_all(p, "replacement")    # true
read_all(p)    # "replacement"
delete(p)    # true
===
read_all_bytes
Reads the entire file at path as bytes, closes the file, and returns the bytes
value. Returns a shaped :io error if open, read, or close fails.

read_all_bytes(path)

let bytes = import("bytes/ffi")
let p = temp()
write_all_bytes(p, bytes.str_to_bytes("ABC"))    # true
bytes.bytes_to_str(read_all_bytes(p))    # "ABC"
delete(p)    # true
===
write_all_bytes
Creates or replaces path with bytes, closes the file, and returns true. Returns
a shaped :io error if open, write, or close fails.

write_all_bytes(path, bytes)

let bytes = import("bytes/ffi")
let p = temp()
write_all_bytes(p, bytes.str_to_bytes("XYZ"))    # true
bytes.bytes_to_str(read_all_bytes(p))    # "XYZ"
delete(p)    # true
===

lock
Acquires an exclusive interprocess lock associated with path, waiting until it
is available. Returns an opaque runtime-owned lock token.

lock(path)

@unchecked
let file = import("file")
let p = file.temp()
let l = file.lock(p)
file.unlock(l)
file.delete(p)
===
try_lock
Attempts an exclusive interprocess lock without waiting. Returns an opaque lock
token when acquired, false when the lock is held elsewhere, or a shaped :lock
error.

try_lock(path)

@unchecked
let file = import("file")
let p = file.temp()
let l = file.try_lock(p)
file.unlock(l)
file.delete(p)
===
unlock
Releases a lock returned by lock or try_lock. Outstanding locks are released
automatically during runtime teardown.

unlock(lock)

@unchecked
let file = import("file")
let p = file.temp()
let l = file.lock(p)
file.unlock(l)
file.delete(p)
===
