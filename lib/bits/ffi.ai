package "bits/ffi"

# bits/ffi - provider-backed bit operations over non-negative integral numbers.
let bit_and = (a, b) {
	_bits_and(a, b)
}

let bit_or = (a, b) {
	_bits_or(a, b)
}

let bit_xor = (a, b) {
	_bits_xor(a, b)
}

let bit_not = (a, width) {
	_bits_not(a, width)
}

let shl = (a, count) {
	_bits_shl(a, count)
}

let shr = (a, count) {
	_bits_shr(a, count)
}

let mask = (width) {
	if width < 0 {
		return _bits_shl(1, width)
	}
	if equal(width, 0) {
		return 0
	}
	return shl(1, width) - 1
}

let low = (a, width) {
	bit_and(a, mask(width))
}

let extract = (a, start, width) {
	low(shr(a, start), width)
}

let replace = (a, start, width, value) {
	let field_mask = shl(mask(width), start)
	let selected = bit_and(a, field_mask)
	let cleared = a - selected
	let inserted = shl(low(value, width), start)
	return bit_or(cleared, inserted)
}

export(:bit_and, :bit_or, :bit_xor, :bit_not, :shl, :shr, :mask, :low, :extract, :replace)
