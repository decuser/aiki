package "number"

let _valid_base = (base) {
	(equal(type(base), :number)) and (equal(base, truncate(base))) and (base >= 2) and (base <= 36)
}

let _digit = (n) {
	if n < 10 {
		return to_str(chr(48 + n))
	}
	return to_str(chr(87 + n))
}

let _digit_value = (r) {
	let n = ord(r)
	if (n >= 48) and (n <= 57) {
		return n - 48
	}
	if (n >= 65) and (n <= 90) {
		return n - 55
	}
	if (n >= 97) and (n <= 122) {
		return n - 87
	}
	return 36
}

let to_base = (n, base) {
	if not _valid_base(base) {
		return [@error, :domain, "base must be an integer from 2 through 36"]
	}
	if not equal(type(n), :number) or not equal(n, truncate(n)) {
		return [@error, :domain, "value must be an integer"]
	}
	if equal(n, 0) {
		return "0"
	}
	let negative = n < 0
	let value = n
	if negative {
		value = 0 - value
	}
	let result = ""
	while value > 0 {
		let quotient = truncate(value / base)
		let remainder = value - (quotient * base)
		result = _digit(remainder) + result
		value = quotient
	}
	if negative {
		return "-" + result
	}
	return result
}

let from_base = (text, base) {
	if not _valid_base(base) {
		return [@error, :domain, "base must be an integer from 2 through 36"]
	}
	if not equal(type(text), :string) or equal(length(text), 0) {
		return [@error, :domain, "value must be a non-empty string"]
	}
	let i = 0
	let sign = 1
	if equal(text[0], '-') {
		sign = 0 - 1
		i = 1
	} else {
		if equal(text[0], '+') {
			i = 1
		}
	}
	if equal(i, length(text)) {
		return [@error, :domain, "value must contain digits"]
	}
	let result = 0
	while i < length(text) {
		let digit = _digit_value(text[i])
		if digit >= base {
			return [@error, :domain, "digit is not valid for base"]
		}
		result = result * base + digit
		i = i + 1
	}
	return sign * result
}

export(:to_base, :from_base)
