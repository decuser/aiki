package "math/ffi"

# math/ffi - provider-backed host floating-point math interop
# Transcendental operations use host float64 computation and cross back into
# Aiki as exact rational representations of the returned float values. This is
# an explicit provider semantic surface, not the acceleration twin of math/native.
let floor = (x) {
	_floor(x)
}

let ceil = (x) {
	_ceil(x)
}

let modulo = (a, b) {
	_modulo(a, b)
}

let sin = (x) {
	_sin_inexact(x)
}

let cos = (x) {
	_cos_inexact(x)
}

let sqrt = (x) {
	_sqrt_inexact(x)
}

export(:floor, :ceil, :modulo, :sin, :cos, :sqrt)
