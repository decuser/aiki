package "math/native"

# math/native - pure aiki math functions
# These use Taylor series with rational arithmetic.
# User controls precision via 'terms' or 'iterations' parameter.
# Pure even check - subtract 2 until < 2, check if 0
let _is_even = (n) {
	let r = n
	while r >= 2 {
		r = r - 2
	}
	return equal(r, 0)
}

let _factorial = (n) {
	if n < 2 {
		return 1
	}
	return n * _factorial(n - 1)
}

let _pow = (x, n) {
	if equal(n, 0) {
		return 1
	}
	let result = x
	let i = 1
	while i < n {
		result = result * x
		i = i + 1
	}
	return result
}

# floor(x) - largest integer <= x
let floor = (x) {
	let whole = truncate(x)
	if x < 0 and not equal(x, whole) {
		return whole - 1
	}
	return whole
}

# ceil(x) - smallest integer >= x
let ceil = (x) {
	let whole = truncate(x)
	if x > 0 and not equal(x, whole) {
		return whole + 1
	}
	return whole
}

# modulo(a, b) - Euclidean remainder with a non-negative result.
let modulo = (a, b) {
	if equal(b, 0) {
		# Preserve division-by-zero as a language fault rather than inventing a
		# module-specific recoverable error.
		return a / b
	}
	let divisor = b
	if divisor < 0 {
		divisor = 0 - divisor
	}
	return a - (floor(a / divisor) * divisor)
}

# sin(x, terms) - Taylor series: x - x³/3! + x⁵/5! - ...
let sin = (x, terms) {
	let result = 0
	let i = 0
	while i < terms {
		let n = i * 2 + 1
		let term = _pow(x, n) / _factorial(n)
		if _is_even(i) {
			result = result + term
		} else {
			result = result - term
		}
		i = i + 1
	}
	return result
}

# cos(x, terms) - Taylor series: 1 - x²/2! + x⁴/4! - ...
let cos = (x, terms) {
	let result = 0
	let i = 0
	while i < terms {
		let n = i * 2
		let term = _pow(x, n) / _factorial(n)
		if _is_even(i) {
			result = result + term
		} else {
			result = result - term
		}
		i = i + 1
	}
	return result
}

# sqrt(x, iterations) - Newton's method with exact rationals
let sqrt = (x, iterations) {
	if x < 0 {
		return [@error, :math, "sqrt of negative"]
	}
	if equal(x, 0) {
		return 0
	}
	let guess = x / 2
	let i = 0
	while i < iterations {
		guess = (guess + (x / guess)) / 2
		i = i + 1
	}
	return guess
}

export(:floor, :ceil, :modulo, :sin, :cos, :sqrt)
