package "list"

# list - higher-order functions, aggregation, and list utilities
# Higher-order functions
let map = (list, f) {
	let result = []
	let i = 0
	while i < length(list) {
		result = append(result, f(list[i]))
		i = i + 1
	}
	return result
}

let filter = (list, f) {
	let result = []
	let i = 0
	while i < length(list) {
		if f(list[i]) {
			result = append(result, list[i])
		}
		i = i + 1
	}
	return result
}

let reduce = (list, acc, f) {
	let result = acc
	let i = 0
	while i < length(list) {
		result = f(result, list[i])
		i = i + 1
	}
	return result
}

let each = (list, f) {
	let i = 0
	while i < length(list) {
		f(list[i])
		i = i + 1
	}
	return true
}

# Aggregation
let sum = (list) {
	let total = 0
	let i = 0
	while i < length(list) {
		total = total + list[i]
		i = i + 1
	}
	return total
}

let max = (list) {
	if empty(list) {
		return [@error, :empty, "empty list"]
	}
	let result = list[0]
	let i = 1
	while i < length(list) {
		if list[i] > result {
			result = list[i]
		}
		i = i + 1
	}
	return result
}

let min = (list) {
	if empty(list) {
		return [@error, :empty, "empty list"]
	}
	let result = list[0]
	let i = 1
	while i < length(list) {
		if list[i] < result {
			result = list[i]
		}
		i = i + 1
	}
	return result
}

# Utilities
let reverse = (list) {
	let result = []
	let i = length(list) - 1
	while i >= 0 {
		result = append(result, list[i])
		i = i - 1
	}
	return result
}

let find = (list, f) {
	let i = 0
	while i < length(list) {
		if f(list[i]) {
			return list[i]
		}
		i = i + 1
	}
	return [@error, :lookup, "not found"]
}

let any = (list, f) {
	let i = 0
	while i < length(list) {
		if f(list[i]) {
			return true
		}
		i = i + 1
	}
	return false
}

let all = (list, f) {
	let i = 0
	while i < length(list) {
		if not f(list[i]) {
			return false
		}
		i = i + 1
	}
	return true
}

let concat = (a, b) {
	reduce(b, a, (acc, x) {
		append(acc, x)
	})
}

let _sort_less = (less, a, b) {
	let result = less(a, b)
	if is_error(result) {
		return result
	}
	if not equal(type(result), :boolean) {
		return [@error, :type, "sort comparator must return boolean"]
	}
	return result
}

let _sort_take = (list, count) {
	let result = []
	let i = 0
	while i < count {
		result = append(result, list[i])
		i = i + 1
	}
	return result
}

let _sort_drop = (list, count) {
	let result = []
	let i = count
	while i < length(list) {
		result = append(result, list[i])
		i = i + 1
	}
	return result
}

let _sort_merge = (left, right, less) {
	let result = []
	let li = 0
	let ri = 0
	while (li < length(left)) and (ri < length(right)) {
		let right_first = _sort_less(less, right[ri], left[li])
		if is_error(right_first) {
			return right_first
		}
		if right_first {
			result = append(result, right[ri])
			ri = ri + 1
		} else {
			result = append(result, left[li])
			li = li + 1
		}
	}
	while li < length(left) {
		result = append(result, left[li])
		li = li + 1
	}
	while ri < length(right) {
		result = append(result, right[ri])
		ri = ri + 1
	}
	return result
}

let _sort_merge_sort = (list, less) {
	if length(list) < 2 {
		return list
	}
	let middle = truncate(length(list) / 2)
	let left = _sort_merge_sort(_sort_take(list, middle), less)
	if is_error(left) {
		return left
	}
	let right = _sort_merge_sort(_sort_drop(list, middle), less)
	if is_error(right) {
		return right
	}
	return _sort_merge(left, right, less)
}

let _sort_impl = (list, less) {
	return _sort_merge_sort(list, less)
}

let sort = (list, ...rest) {
	if length(rest) > 1 {
		return [@error, :arity, "sort expects list and optional comparator"]
	}
	let less = (a, b) {
		a < b
	}
	if length(rest) > 0 {
		less = first(rest)
		if not equal(type(less), :function) {
			return [@error, :type, "sort comparator must be function"]
		}
	}
	return _sort_impl(list, less)
}

let range = (start, end) {
	let result = []
	let i = start
	while i < end {
		result = append(result, i)
		i = i + 1
	}
	return result
}

export(
	:map,
	:filter,
	:reduce,
	:each,
	:sum,
	:max,
	:min,
	:reverse,
	:find,
	:any,
	:all,
	:concat,
	:sort,
	:range
)
