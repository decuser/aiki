package "string/native"

# Import dependencies from lib
let _list = import("list")
let _case = import("string/case_table")
let _math = import("math/native")

# String Functions
# =============================================================================
# Foundation
# -----------------------------------------------------------------------------
# substring(s, start, end) - extract substring from start to end (exclusive)
let substring = (s, start, end) {
	let result = ""
	let i = start
	while i < end {
		if i < length(s) {
			result = result + to_str(s[i])
		}
		i = i + 1
	}
	return result
}

# join(list, delim) - join list of strings with delimiter
let join = (list, delim) {
	if empty(list) {
		return ""
	}
	_list.reduce(rest(list), first(list), (acc, x) {
		acc + delim + x
	})
}

# split(s, delim) - split string by delimiter into list
let split = (s, delim) {
	let result = []
	let current = ""
	let i = 0
	let dlen = length(delim)
	while i < length(s) {
		let limit = i + dlen
		if limit <= length(s) {
			if equal(substring(s, i, limit), delim) {
				result = append(result, current)
				current = ""
				i = limit
			} else {
				current = current + to_str(s[i])
				i = i + 1
			}
		} else {
			current = current + to_str(s[i])
			i = i + 1
		}
	}
	return append(result, current)
}

# Search
# -----------------------------------------------------------------------------
# index_of(s, sub) - find index of substring, or [@error, :lookup, "not found"]
let index_of = (s, sub) {
	let slen = length(s)
	let sublen = length(sub)
	if sublen > slen {
		return [@error, :lookup, "not found"]
	}
	let limit = slen - sublen
	let i = 0
	while i <= limit {
		if equal(substring(s, i, i + sublen), sub) {
			return i
		}
		i = i + 1
	}
	return [@error, :lookup, "not found"]
}

# last_index_of(s, sub) - find last index of substring
let last_index_of = (s, sub) {
	let slen = length(s)
	let sublen = length(sub)
	if sublen > slen {
		return [@error, :lookup, "not found"]
	}
	let i = slen - sublen
	while i >= 0 {
		if equal(substring(s, i, i + sublen), sub) {
			return i
		}
		i = i - 1
	}
	return [@error, :lookup, "not found"]
}

# contains(s, sub) - check if string contains substring
let contains = (s, sub) {
	not is_error(index_of(s, sub))
}

# starts_with(s, prefix) - check if string starts with prefix
let starts_with = (s, prefix) {
	if length(prefix) > length(s) {
		return false
	}
	equal(substring(s, 0, length(prefix)), prefix)
}

# ends_with(s, suffix) - check if string ends with suffix
let ends_with = (s, suffix) {
	let slen = length(s)
	let suflen = length(suffix)
	if suflen > slen {
		return false
	}
	equal(substring(s, slen - suflen, slen), suffix)
}

# occurrences(s, sub) - count occurrences of substring
let occurrences = (s, sub) {
	let parts = split(s, sub)
	length(parts) - 1
}

# Transform
# -----------------------------------------------------------------------------
# replace(s, old, new) - replace all occurrences
let replace = (s, old, new) {
	join(split(s, old), new)
}

# replace_first(s, old, new) - replace first occurrence only
let replace_first = (s, old, new) {
	let idx = index_of(s, old)
	if is_error(idx) {
		return s
	}
	substring(s, 0, idx) + new + substring(s, idx + length(old), length(s))
}

# repeat(s, n) - repeat string n times
let repeat = (s, n) {
	let result = ""
	let i = 0
	while i < n {
		result = result + s
		i = i + 1
	}
	return result
}

# reverse_string(s) - reverse a string
let reverse_string = (s) {
	join(_list.map(_list.reverse(chars(s)), to_str), "")
}

# insert(s, pos, sub) - insert substring at position
let insert = (s, pos, sub) {
	substring(s, 0, pos) + sub + substring(s, pos, length(s))
}

# remove(s, start, end) - remove characters from start to end
let remove = (s, start, end) {
	substring(s, 0, start) + substring(s, end, length(s))
}

# Trim/Pad
# -----------------------------------------------------------------------------
# is_whitespace(r) - check if rune is whitespace
let is_whitespace = (r) {
	equal(ord(r), 32) or equal(ord(r), 9) or equal(ord(r), 10) or equal(ord(r), 13)
}

# trim_start(s) - remove leading whitespace
let trim_start = (s) {
	let i = 0
	while i < length(s) {
		if not is_whitespace(s[i]) {
			return substring(s, i, length(s))
		}
		i = i + 1
	}
	return ""
}

# trim_end(s) - remove trailing whitespace
let trim_end = (s) {
	let i = length(s) - 1
	while i >= 0 {
		if not is_whitespace(s[i]) {
			return substring(s, 0, i + 1)
		}
		i = i - 1
	}
	return ""
}

# trim(s) - remove leading and trailing whitespace
let trim = (s) {
	trim_end(trim_start(s))
}

# pad_start(s, len, char) - pad string at start to reach length
let pad_start = (s, len, char) {
	let slen = length(s)
	if slen >= len {
		return s
	}
	repeat(to_str(char), len - slen) + s
}

# pad_end(s, len, char) - pad string at end to reach length
let pad_end = (s, len, char) {
	let slen = length(s)
	if slen >= len {
		return s
	}
	s + repeat(to_str(char), len - slen)
}

# center(s, len, char) - center string with padding on both sides
let center = (s, len, char) {
	let slen = length(s)
	if slen >= len {
		return s
	}
	let total = len - slen
	let left = _math.floor(total / 2)
	let right = total - left
	repeat(to_str(char), left) + s + repeat(to_str(char), right)
}

# truncate(s, len) - truncate string to maximum length
let truncate = (s, len) {
	if length(s) <= len {
		return s
	}
	substring(s, 0, len)
}

# Conversion
# -----------------------------------------------------------------------------
# chars(s) - convert string to list of runes
let chars = (s) {
	let result = []
	let i = 0
	while i < length(s) {
		result = append(result, s[i])
		i = i + 1
	}
	return result
}

# lines(s) - split string into lines
let lines = (s) {
	split(s, "\n")
}

# words(s) - split string into words (by whitespace)
let words = (s) {
	_list.filter(split(trim(s), " "), (w) {
		not equal(w, "")
	})
}

# Character Classes
# -----------------------------------------------------------------------------
# is_digit(r) - check if rune is digit 0-9
let is_digit = (r) {
	(ord(r) >= 48) and (ord(r) <= 57)
}

# is_alpha(r) - check if rune is alphabetic a-z A-Z
let is_alpha = (r) {
	((ord(r) >= 65) and (ord(r) <= 90)) or ((ord(r) >= 97) and (ord(r) <= 122))
}

# is_upper(r) - check if rune is uppercase A-Z
let is_upper = (r) {
	(ord(r) >= 65) and (ord(r) <= 90)
}

# is_lower(r) - check if rune is lowercase a-z
let is_lower = (r) {
	(ord(r) >= 97) and (ord(r) <= 122)
}

# is_alnum(r) - check if rune is alphanumeric
let is_alnum = (r) {
	is_alpha(r) or is_digit(r)
}

# String Predicates
# -----------------------------------------------------------------------------
# is_numeric(s) - check if string contains only digits
let is_numeric = (s) {
	if equal(length(s), 0) {
		return false
	}
	_list.all(chars(s), is_digit)
}

# is_alphabetic(s) - check if string contains only letters
let is_alphabetic = (s) {
	if equal(length(s), 0) {
		return false
	}
	_list.all(chars(s), is_alpha)
}

# Comparison
# -----------------------------------------------------------------------------
# compare(a, b) - lexicographic comparison: -1, 0, or 1
let compare = (a, b) {
	let alen = length(a)
	let blen = length(b)
	let minlen = alen
	if blen < alen {
		minlen = blen
	}
	let i = 0
	while i < minlen {
		let ca = ord(a[i])
		let cb = ord(b[i])
		if ca < cb {
			return 0 - 1
		}
		if ca > cb {
			return 1
		}
		i = i + 1
	}
	if alen < blen {
		return 0 - 1
	}
	if alen > blen {
		return 1
	}
	return 0
}

# Case Conversion (native Unicode simple-case mapping)
# -----------------------------------------------------------------------------
# upper(s) - convert string to uppercase
let upper = (s) {
	let result = ""
	let i = 0
	while i < length(s) {
		result = result + to_str(_case.upper_rune(s[i]))
		i = i + 1
	}
	return result
}

# lower(s) - convert string to lowercase
let lower = (s) {
	let result = ""
	let i = 0
	while i < length(s) {
		result = result + to_str(_case.lower_rune(s[i]))
		i = i + 1
	}
	return result
}

# upper_rune(r) - convert rune to uppercase
let upper_rune = (r) {
	_case.upper_rune(r)
}

# lower_rune(r) - convert rune to lowercase
let lower_rune = (r) {
	_case.lower_rune(r)
}

# capitalize(s) - uppercase first character, lowercase rest
let capitalize = (s) {
	if equal(length(s), 0) {
		return s
	}
	to_str(upper_rune(s[0])) + lower(substring(s, 1, length(s)))
}

# title(s) - title case each word
let title = (s) {
	join(_list.map(words(s), capitalize), " ")
}

# equal_ignore_case(a, b) - case-insensitive equality
let equal_ignore_case = (a, b) {
	equal(lower(a), lower(b))
}

export(
	:substring,
	:join,
	:split,
	:index_of,
	:last_index_of,
	:contains,
	:starts_with,
	:ends_with,
	:occurrences,
	:replace,
	:replace_first,
	:repeat,
	:reverse_string,
	:insert,
	:remove,
	:is_whitespace,
	:trim_start,
	:trim_end,
	:trim,
	:pad_start,
	:pad_end,
	:center,
	:truncate,
	:chars,
	:lines,
	:words,
	:is_digit,
	:is_alpha,
	:is_upper,
	:is_lower,
	:is_alnum,
	:is_numeric,
	:is_alphabetic,
	:compare,
	:upper,
	:lower,
	:upper_rune,
	:lower_rune,
	:capitalize,
	:title,
	:equal_ignore_case
)
