#!/bin/sh
# Pre-push hook: reject cheap-to-fix post-tag history cruft, then run rigorous.

echo "Checking post-tag history hygiene..."
make historycheck || exit 1

echo "Running rigorous (this may take a minute)..."
make rigorous

if [ $? -ne 0 ]; then
    echo "rigorous failed, push aborted"
    exit 1
fi
