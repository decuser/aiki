# Hash utility tests
let hash = import("hash/ffi")

let h = hash.new()
h = hash.put(h, "a", 1)
h = hash.put(h, "b", 2)
h = hash.put(h, "c", 3)

# hash_keys and hash_values
let keys = hash.keys(h)
let vals = hash.values(h)
print(length(keys), "\n")
print(length(vals), "\n")

# hash_del
h = hash.del(h, "b")
print(hash.has(h, "a"), "\n")
print(hash.has(h, "b"), "\n")
print(hash.has(h, "c"), "\n")

# verify remaining values
print(hash.get(h, "a"), "\n")
print(hash.get(h, "c"), "\n")
