# String functions smoke test - qualified import
let str = import("string")

# Foundation
println(str.substring("hello", 1, 4))
println(str.join(["a", "b", "c"], "-"))
println(str.split("a,b,c", ","))

# Search
println(str.index_of("hello", "ll"))
println(str.last_index_of("abcabc", "bc"))
println(str.contains("hello", "ell"))
println(str.starts_with("hello", "he"))
println(str.ends_with("hello", "lo"))
println(str.occurrences("banana", "a"))

# Transform
println(str.replace("hello", "l", "L"))
println(str.replace_first("hello", "l", "L"))
println(str.repeat("ab", 3))
println(str.reverse_string("hello"))
println(str.insert("hello", 2, "XX"))
println(str.remove("hello", 1, 3))

# Trim/Pad
println(str.trim("  hi  "))
println(str.pad_start("42", 5, '0'))
println(str.pad_end("42", 5, '0'))
println(str.center("hi", 6, '-'))
println(str.truncate("hello", 3))

# Conversion
println(str.chars("hi"))
println(str.lines("a\nb"))
println(str.words("hello world"))

# Character classes
println(str.is_digit('5'))
println(str.is_alpha('a'))
println(str.is_upper('A'))
println(str.is_lower('a'))
println(str.is_alnum('5'))
println(str.is_whitespace(' '))

# String predicates
println(str.is_numeric("123"))
println(str.is_alphabetic("abc"))

# Comparison
println(str.compare("abc", "abd"))

# Case conversion
println(str.upper("hello"))
println(str.lower("HELLO"))
println(str.capitalize("hello"))
println(str.title("hello world"))
println(str.equal_ignore_case("Hello", "HELLO"))

println("STRING_SMOKE_DONE")
