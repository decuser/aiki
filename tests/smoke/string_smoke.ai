# String functions smoke test
# Foundation
println(substring("hello", 1, 4))
println(join(["a", "b", "c"], "-"))
println(split("a,b,c", ","))

# Search
println(index_of("hello", "ll"))
println(last_index_of("abcabc", "bc"))
println(contains("hello", "ell"))
println(starts_with("hello", "he"))
println(ends_with("hello", "lo"))
println(occurrences("banana", "a"))

# Transform
println(replace("hello", "l", "L"))
println(replace_first("hello", "l", "L"))
println(repeat("ab", 3))
println(reverse_string("hello"))
println(insert("hello", 2, "XX"))
println(remove("hello", 1, 3))

# Trim/Pad
println(trim("  hi  "))
println(pad_start("42", 5, '0'))
println(pad_end("42", 5, '0'))
println(center("hi", 6, '-'))
println(truncate("hello", 3))

# Conversion
println(chars("hi"))
println(lines("a\nb"))
println(words("hello world"))

# Character classes
println(is_digit('5'))
println(is_alpha('a'))
println(is_upper('A'))
println(is_lower('a'))
println(is_alnum('5'))
println(is_whitespace(' '))

# String predicates
println(is_numeric("123"))
println(is_alphabetic("abc"))

# Comparison
println(compare("abc", "abd"))

# Case conversion
println(upper("hello"))
println(lower("HELLO"))
println(capitalize("hello"))
println(title("hello world"))
println(equal_ignore_case("Hello", "HELLO"))

println("STRING_SMOKE_DONE")
