# Regex smoke test - qualified import
let re = import("regex/ffi")

println("Testing regex...")

# matches
println(re.matches("hello world", "^hello"))
println(re.matches("hello world", "^world"))
println(re.matches("hello world", "world$"))

# find
println(re.find("abc 123 def", "\\d+"))

# find_all
println(re.find_all("a1b2c3", "\\d"))

# replace
println(re.replace("a1b2c3", "\\d", "X"))

# replace_first
println(re.replace_first("a1b2c3", "\\d", "X"))

# split
println(re.split("a,b,,c", ","))
println(re.split("one  two   three", "\\s+"))

# pipes work with direct import
import("regex/ffi", :matches, :replace)
println("hello world" |> matches("^hello"))
println("a1b2c3" |> replace("\\d+", "N"))

# error case - invalid pattern
println(re.find("test", "["))

println("REGEX_SMOKE_DONE")
