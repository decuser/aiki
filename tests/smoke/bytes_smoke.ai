import("bytes/ffi", :str_to_bytes, :bytes_to_str, :bytes_new, :bytes_get, :bytes_length, :bytes_slice)
let list = import("list")

let b = str_to_bytes("Hi")
list.println(type(b))
list.println(bytes_length(b))
list.println(bytes_get(b, 0))
list.println(bytes_get(b, 1))

let s = bytes_to_str(b)
list.println(s)

let b2 = bytes_new([65, 66, 67])
list.println(bytes_to_str(b2))

let slice = bytes_slice(b2, 0, 2)
list.println(bytes_to_str(slice))

list.println("BYTES_SMOKE_DONE")
