# Higher-order function tests
# map
let doubled = map([1, 2, 3], (x) {
	x * 2
})


print(doubled, "\n")

# filter
let evens = filter([1, 2, 3, 4, 5], (x) {
	equal(modulo(x, 2), 0)
})


print(evens, "\n")

# reduce
let total = reduce([1, 2, 3, 4], 0, (acc, x) {
	acc + x
})


print(total, "\n")

# each (side effects)
each([1, 2, 3], (x) {
	print(x)
})


print("\n")

# reverse
print(reverse([1, 2, 3]), "\n")

# find
let found = find([1, 2, 3, 4], (x) {
	x > 2
})


print(found, "\n")

# any
print(any([1, 2, 3], (x) {
	x > 2
}), "\n")


print(any([1, 2, 3], (x) {
	x > 5
}), "\n")


# all
print(all([2, 4, 6], (x) {
	equal(modulo(x, 2), 0)
}), "\n")


print(all([2, 3, 6], (x) {
	equal(modulo(x, 2), 0)
}), "\n")


# sum
print(sum([1, 2, 3, 4, 5]), "\n")

# max/min
print(max([3, 1, 4, 1, 5]), "\n")
print(min([3, 1, 4, 1, 5]), "\n")
