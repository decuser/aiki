# Higher-order function tests
let list = import("list")
let math = import("math")

# map
let doubled = list.map([1, 2, 3], (x) {
	x * 2
})


print(doubled, "\n")

# filter
let evens = list.filter([1, 2, 3, 4, 5], (x) {
	equal(math.modulo(x, 2), 0)
})


print(evens, "\n")

# reduce
let total = list.reduce([1, 2, 3, 4], 0, (acc, x) {
	acc + x
})


print(total, "\n")

# each (side effects)
list.each([1, 2, 3], (x) {
	print(x)
})


print("\n")

# reverse
print(list.reverse([1, 2, 3]), "\n")

# find
let found = list.find([1, 2, 3, 4], (x) {
	x > 2
})


print(found, "\n")

# any
print(list.any([1, 2, 3], (x) {
	x > 2
}), "\n")


print(list.any([1, 2, 3], (x) {
	x > 5
}), "\n")


# all
print(list.all([2, 4, 6], (x) {
	equal(math.modulo(x, 2), 0)
}), "\n")


print(list.all([2, 3, 6], (x) {
	equal(math.modulo(x, 2), 0)
}), "\n")


# sum
print(list.sum([1, 2, 3, 4, 5]), "\n")

# max/min
print(list.max([3, 1, 4, 1, 5]), "\n")
print(list.min([3, 1, 4, 1, 5]), "\n")
