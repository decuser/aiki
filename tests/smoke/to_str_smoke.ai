# to_str smoke test - verify value conversion (not display formatting)
let list = import("list")

# Rune to string - should be "A" not "'A'"
list.println(to_str('A'))
list.println(to_str(chr(50504)))

# String unchanged
list.println(to_str("hello"))

# Number
list.println(to_str(42))
list.println(to_str(1/3))

# Boolean
list.println(to_str(true))
list.println(to_str(false))

# Symbol (keeps colon)
list.println(to_str(:foo))

# Build string from runes
let s = ""
list.each(['h', 'e', 'l', 'l', 'o'], (r) {
	s = s + to_str(r)
})


list.println(s)

list.println("TO_STR_SMOKE_DONE")
