println("Testing hash map...")

let h = hash_new()
let h = hash_put(h, "name", "Mochi")
let h = hash_put(h, "age", 3)
let h = hash_put(h, :color, "orange")

println(hash_get(h, "name"))
println(hash_get(h, "age"))
println(hash_get(h, :color))
println(hash_has(h, "name"))
println(hash_has(h, "missing"))

let h2 = hash_new()
let h2 = hash_put(h2, 1, "one")
let h2 = hash_put(h2, 2, "two")
println(hash_get(h2, 1))
println(hash_get(h2, 2))

println("\nhash_smoke done")
