let list = import("list")
let hash = import("hash")

list.println("Testing hash map...")

let h = hash.new()
let h = hash.put(h, "name", "Mochi")
let h = hash.put(h, "age", 3)
let h = hash.put(h, :color, "orange")

list.println(hash.get(h, "name"))
list.println(hash.get(h, "age"))
list.println(hash.get(h, :color))
list.println(hash.has(h, "name"))
list.println(hash.has(h, "missing"))

let h2 = hash.new()
let h2 = hash.put(h2, 1, "one")
let h2 = hash.put(h2, 2, "two")
list.println(hash.get(h2, 1))
list.println(hash.get(h2, 2))

list.println("\nhash_smoke done")
