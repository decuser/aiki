let list = import("list")

# mutual_even_odd.ai
# Mutual tail recursion should not grow Go stack with proper tail calls.
stack_limit(10000)

let even = (n) {
	if (equal(n, 0)) {
		return true
	}
	return odd((n - 1))
}

let odd = (n) {
	if (equal(n, 0)) {
		return true
	}
	return even((n - 1))
}

list.println(even(20000000))
list.println(odd(20000000))
