# 05_hash_symbols_engine.ai
# Hash, symbol keys, string keys, numbers
let hash = import("hash")

let h = hash.new()
let h = hash.put(h, "name", "Mochi")
let h = hash.put(h, :age, 3)
let h = hash.put(h, 1, "one")

print(hash.get(h, "name"), "\n")
print(hash.get(h, :age), "\n")
print(hash.get(h, 1), "\n")
