let list = import("list")
let hash = import("hash")

# 05_hash_engine.ai
# Hash basics.
let h = hash.new()
let h = hash.put(h, "name", "Mochi")
let h = hash.put(h, :age, 3)

list.println(hash.get(h, "name"))
list.println(hash.get(h, :age))
list.println(hash.has(h, "name"))
list.println(hash.has(h, "missing"))
