let list = import("list")

# 06_channels_engine.ai
# Concurrency primitives without imports.
let ch = channel()

let worker = (c) {
	let x = recv(c)
	let y = recv(c)
	send(c, x + y)
	send(c, x * y)
	return true
}

spawn(worker, ch)

send(ch, 3)
send(ch, 7)

list.println(recv(ch))
list.println(recv(ch))
