# 01_math_ops_engine.ai
# Arithmetic and precedence, no equality operators.
print("ADD", "\n")
print(1 + 1, "\n")

print("RAT_ONE_THIRD_TIMES_THREE", "\n")
print((1 / 3) * 3, "\n")

print("LEFT_TO_RIGHT_ONE_PLUS_TWO_TIMES_THREE", "\n")
print(1 + 2 * 3, "\n")

print("NEG_RATIONAL_ADD", "\n")
print((-1 / 2) + (3 / 2), "\n")

print("MATH_DONE", "\n")
