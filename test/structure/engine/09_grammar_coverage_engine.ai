# Covers grammar productions not otherwise exercised structurally.
package "engine/coverage"

let @pair [left, right]
let pair = [@pair, 10, 20]
println(pair.left)
println([1, 2, 3][1])

let count_rest = (first, ...rest) {
	length(rest)
}

println(count_rest(1, 2, 3))

match :ok {
	:ok {
		println("matched")
	}
	_ {
		println("missed")
	}
}
