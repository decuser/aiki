let hash = import("hash/ffi")

println("Testing hash map...")

let h = hash.new()
let h = hash.put(h, "name", "Mochi")
let h = hash.put(h, "age", 3)
let h = hash.put(h, :color, "orange")

println(hash.get(h, "name"))
println(hash.get(h, "age"))
println(hash.get(h, :color))
println(hash.has(h, "name"))
println(hash.has(h, "missing"))

let h2 = hash.new()
let h2 = hash.put(h2, 1, "one")
let h2 = hash.put(h2, 2, "two")
println(hash.get(h2, 1))
println(hash.get(h2, 2))

println("\nhash_smoke done")
