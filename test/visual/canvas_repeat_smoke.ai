let cv = import("canvas")
let time = import("time")

let c1 = cv.canvas(300, 300)
cv.set_bg(c1, :black)
cv.set_fg(c1, :cyan)
cv.line(c1, 10, 10, 290, 290)
time.sleep(1000)
cv.destroy(c1)

let c2 = cv.canvas(300, 300)
cv.set_bg(c2, :black)
cv.set_fg(c2, :red)
cv.circle(c2, 150, 150, 80)
time.sleep(1000)
cv.destroy(c2)
