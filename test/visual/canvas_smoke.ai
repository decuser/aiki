import("math/ffi", :sin, :cos)
let cv = import("canvas")
let time = import("time")

let canvas_ref = cv.canvas(800, 800)
let tick = 0
let outer_radius = 200
let inner_radius = 80
let pen_distance = 150
let diff = outer_radius - inner_radius
let ratio = diff / inner_radius

while tick < 6280 {
	let angle = tick / 100
	let x = 400 + ((diff * cos(angle)) + (pen_distance * cos(ratio * angle)))
	let y = 400 + ((diff * sin(angle)) - (pen_distance * sin(ratio * angle)))
	cv.dot(canvas_ref, x, y, :cyan)
	tick = tick + 1
}

time.sleep(1000)
