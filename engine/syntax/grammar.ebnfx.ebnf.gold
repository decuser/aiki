TOKENS
  COMMENT	skip=true	pattern="^#[^\\n]*"
  DELIMITER	skip=false	literal="( ) [ ] { } , ; ..."
  KEYWORD	skip=false	literal="let if else while match return true false and or not package"
  NAME	skip=false	pattern="^[a-zA-Z_][a-zA-Z0-9_]*"	error="expected name"	template="foo, my_var"
  NUMBER	skip=false	pattern="^[0-9]+(\\.[0-9]+)?(\\/[0-9]+)?"	error="expected number"	template="42, 3.14, 1/3"
  OPERATOR	skip=false	literal="+ - * / < > <= >= |> . ="
  RUNE	skip=false	pattern="^'([^'\\\\]|\\\\.)'"	error="expected rune"	template="'a', '\\\\n'"
  SHAPE	skip=false	pattern="^@[a-zA-Z_][a-zA-Z0-9_]*"	error="expected shape"	template="@point, @error"
  STRING	skip=false	pattern="^\"([^\"\\\\]|\\\\.)*\""	error="expected string"	template="\\\"hello\\\""
  SYMBOL	skip=false	pattern="^:[a-zA-Z_][a-zA-Z0-9_]*"	error="expected symbol"	template=":name, :ok, :error"
  WHITESPACE	skip=true	pattern="^[ \\t\\r\\n]+"

PRODUCTIONS
  BINOP	= "+" | "-" | "*" | "/" | "<" | ">" | "<=" | ">=" | "and" | "or"	error="expected operator"	template="+ - * / < > <= >= and or"
  access	= "." NAME	error="expected '.field'"	template=".field"
  assign_stmt	= NAME "=" expr	error="expected 'name = expr'"	template="name = expr"
  block	= "{" {statement} "}"	error="expected '{ ... }'"	template="{ statement ... }"
  call	= "(" [expr {"," expr}] ")"	error="expected '(args)'"	template="(arg, arg, ...)"
  expr	= pipe_expr	error="expected expression"	template="expr"
  expr_stmt	= expr	error="expected expression"	template="expr"
  field	= NAME | SHAPE	error="expected field name or embedded shape"	template="name | @shape"
  func_literal	= "(" params ")" block	error="expected '(params) { body }'"	template="(a, b) { return a + b }"
  if_stmt	= "if" expr block ["else" (if_stmt | block)]	error="expected 'if expr { ... }'"	template="if cond { ... } [else { ... }]"
  index	= "[" expr "]"	error="expected '[index]'"	template="[i]"
  infix_expr	= unary_expr {BINOP unary_expr}	error="expected expression"	template="expr op expr op expr"
  let_stmt	= "let" NAME "=" expr | "let" SHAPE "[" [field {"," field}] "]"	error="expected 'let name = expr' or 'let @shape [fields]'"	template="let name = expr | let @shape [fields]"
  list_literal	= "[" [expr {"," expr}] "]" | "[" SHAPE {"," expr} "]"	error="expected list '[expr, ...]' or '[@shape, expr, ...]'"	template="[a, b], [@point, x, y]"
  literal	= NUMBER | STRING | RUNE | SYMBOL | "true" | "false"	error="expected literal"	template="42, \\\"str\\\", 'r', :sym, true, false"
  match_stmt	= "match" expr "{" {pattern block} "}"	error="expected 'match expr { pattern { ... } ... }'"	template="match expr { pattern { ... } }"
  package_stmt	= "package" STRING	error="expected 'package \\\"name\\\"'"	template="package \\\"name\\\""
  param_list	= NAME {"," NAME}	error="expected parameter names"	template="a, b, c"
  params	= [param_list ["," rest_param] | rest_param]	error="expected parameters"	template="a, b, ...rest"
  pattern	= "_" | NAME | literal | "[" [pattern {"," pattern}] "]" | "[" SHAPE {"," pattern} "]"	error="expected pattern"	template="_, name, literal, [patterns], [@shape, patterns]"
  pipe_expr	= infix_expr {"|>" postfix_expr}	error="expected expression"	template="expr |> func |> func"
  postfix_expr	= primary {call | index | access}	error="expected expression"	template="expr(), expr[i], expr.field"
  primary	= NUMBER | STRING | RUNE | SYMBOL | NAME | "true" | "false" | list_literal | func_literal | "(" expr ")"	error="expected value"	template="42, \\\"str\\\", 'r', :sym, name, true, [], (), (expr)"
  program	= {statement}	error="expected statement"	template="statement ..."
  rest_param	= "..." NAME	error="expected '...name'"	template="...args"
  return_stmt	= "return" expr	error="expected 'return expr'"	template="return expr"
  statement	= package_stmt | let_stmt | assign_stmt | if_stmt | while_stmt | match_stmt | return_stmt | expr_stmt	error="expected statement"	template="package | let | assign | if | while | match | return | expr"
  unary_expr	= {"not" | "-"} postfix_expr	error="expected expression"	template="not expr, -expr"
  while_stmt	= "while" expr block	error="expected 'while expr { ... }'"	template="while cond { ... }"

