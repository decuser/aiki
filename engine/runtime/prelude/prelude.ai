let rest = (list) {
	_rest(list)
}

let length = (list) {
	_length(list)
}

let prepend = (list, val) {
	_prepend(list, val)
}

let append = (list, val) {
	_append(list, val)
}

let empty = (list) {
	_empty(list)
}

let range = (start, end) {
	_range(start, end)
}

# Type wrappers
let type = (val) {
	_type(val)
