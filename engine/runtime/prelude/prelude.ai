# Prelude - minimal standard library
# This file runs with ScopePrelude, so it can access _prefixed HAL primitives.
# It defines user-visible wrappers that user code can call.
# Intrinsic wrappers - these need evaluator context
# Note: import and export are available directly (no wrapper needed)
let apply = (fn, args) {
	_apply(fn, args)
}

let load = (path) {
	_load(path)
}

let stack_limit = (n) {
	_stack_limit(n)
}

let spawn = (fn, ...args) {
	_apply(_spawn, _prepend(args, fn))
}

let channel = () {
	_channel()
}

let send = (ch, val) {
	_send(ch, val)
}

let recv = (ch) {
	_recv(ch)
}

# IO wrappers - print uses apply for variadic support
let print = (...args) {
	apply(_print, args)
}

let read = () {
	_read()
}

let input = () {
	_read()
}

# List wrappers
let first = (list) {
	_first(list)
}

let rest = (list) {
	_rest(list)
}

let length = (list) {
	_length(list)
}

let prepend = (list, val) {
	_prepend(list, val)
}

let append = (list, val) {
	_append(list, val)
}

let empty = (list) {
	_empty(list)
}

let range = (start, end) {
	_range(start, end)
}

# Type wrappers
let type = (val) {
	_type(val)
}

let inspect = (val) {
	_inspect(val)
}

let equal = (a, b) {
	_equal(a, b)
}

let ord = (r) {
	_ord(r)
}

let chr = (n) {
	_chr(n)
}

# Math wrappers
let floor = (n) {
	_floor(n)
}

let ceil = (n) {
	_ceil(n)
}

let modulo = (a, b) {
	_modulo(a, b)
}

# Time wrappers
let sleep = (ms) {
	_sleep(ms)
}

# Random wrappers
let seed = (n) {
	_seed(n)
}

let random = (max) {
	_random(max)
}

# Canvas wrappers
let canvas = (w, h) {
	_canvas(w, h)
}

let dot = (c, x, y, ...rest) {
	apply(_dot, _prepend(_prepend(_prepend(rest, y), x), c))
}

let line = (c, x1, y1, x2, y2, ...rest) {
	apply(_line, _prepend(_prepend(_prepend(_prepend(_prepend(rest, y2), x2), y1), x1), c))
}

let rect = (c, x, y, w, h, ...rest) {
	apply(_rect, _prepend(_prepend(_prepend(_prepend(_prepend(rest, h), w), y), x), c))
}

let fill_rect = (c, x, y, w, h, ...rest) {
	apply(_fill_rect, _prepend(_prepend(_prepend(_prepend(_prepend(rest, h), w), y), x), c))
}

let circle = (c, x, y, r, ...rest) {
	apply(_circle, _prepend(_prepend(_prepend(_prepend(rest, r), y), x), c))
}

let fill_circle = (c, x, y, r, ...rest) {
	apply(_fill_circle, _prepend(_prepend(_prepend(_prepend(rest, r), y), x), c))
}

let clear = (c) {
	_clear(c)
}

let destroy = (c) {
	_destroy(c)
}

let set_bg = (c, color) {
	_set_bg(c, color)
}

let set_fg = (c, color) {
	_set_fg(c, color)
}

let set_bg_rgb = (c, r, g, b) {
	_set_bg(c, [r, g, b])
}

let set_fg_rgb = (c, r, g, b) {
	_set_fg(c, [r, g, b])
}

let pen_size = (c, s) {
	_pen_size(c, s)
}

# Higher-order functions
let map = (list, f) {
	let result = []
	let i = 0
	while i < _length(list) {
		result = _append(result, f(list[i]))
		i = i + 1
	}
	return result
}

let filter = (list, f) {
	let result = []
	let i = 0
	while i < _length(list) {
		if f(list[i]) {
			result = _append(result, list[i])
		}
		i = i + 1
	}
	return result
}

let reduce = (list, acc, f) {
	let result = acc
	let i = 0
	while i < _length(list) {
		result = f(result, list[i])
		i = i + 1
	}
	return result
}

let each = (list, f) {
	let i = 0
	while i < _length(list) {
		f(list[i])
		i = i + 1
	}
	return true
}

# Aggregation
let sum = (list) {
	let total = 0
	let i = 0
	while i < _length(list) {
		total = total + list[i]
		i = i + 1
	}
	return total
}

# Convenience
let println = (...args) {
	apply(_print, args)
	_print("\n")
}

# Type conversion wrappers
let shape = (val) {
	_shape(val)
}

let is_error = (val) {
	_equal(_shape(val), :error)
}

let to_str = (val) {
	_to_str(val)
}

let to_decimal = (n, places) {
	_to_decimal(n, places)
}

let to_number = (s) {
	_to_number(s)
}

# Hash code implementation
let _hash_string = (s) {
	let h = 0
	while _length(s) > 0 {
		let r = _first(s)
		h = h * 31 + _ord(r)
		s = _rest(s)
	}
	return h
}

let _hash_code_impl = (val) {
	match _type(val) {
		:number {
			return _hash_string(_to_str(val))
		}
		:boolean {
			if val {
				return 1
			}
			return 0
		}
		:rune {
			return _ord(val)
		}
		:string {
			return _hash_string(val)
		}
		:symbol {
			return _hash_string(_to_str(val))
		}
		:list {
			let h = _hash_string(_to_str(_shape(val)))
			let i = 0
			while i < _length(val) {
				h = h * 31 + _hash_code_impl(val[i])
				i = i + 1
			}
			return h
		}
		_ {
			return 0
		}
	}
}

let hash_code = (val) {
	_hash_code_impl(val)
}

# Hash map implementation
let _HASH_SIZE = 64

let hash_new = () {
	let buckets = []
	let i = 0
	while i < _HASH_SIZE {
		buckets = _append(buckets, [])
		i = i + 1
	}
	return buckets
}

let _bucket_index = (key) {
	return _modulo(hash_code(key), _HASH_SIZE)
}

let hash_get = (h, key) {
	let idx = _bucket_index(key)
	let bucket = h[idx]
	let i = 0
	while i < _length(bucket) {
		let pair = bucket[i]
		if _equal(pair[0], key) {
			return pair[1]
		}
		i = i + 1
	}
	return [@error, :key, "key not found"]
}

let hash_put = (h, key, val) {
	let idx = _bucket_index(key)
	let bucket = h[idx]
	let new_bucket = []
	let found = false
	let i = 0
	while i < _length(bucket) {
		let pair = bucket[i]
		if _equal(pair[0], key) {
			new_bucket = _append(new_bucket, [key, val])
			found = true
		} else {
			new_bucket = _append(new_bucket, pair)
		}
		i = i + 1
	}
	if not found {
		new_bucket = _append(new_bucket, [key, val])
	}
	# Build new hash with updated bucket
	let new_h = []
	let j = 0
	while j < _HASH_SIZE {
		if _equal(j, idx) {
			new_h = _append(new_h, new_bucket)
		} else {
			new_h = _append(new_h, h[j])
		}
		j = j + 1
	}
	return new_h
}

let hash_has = (h, key) {
	let result = hash_get(h, key)
	return not (_equal(_shape(result), :error))
}

let hash_del = (h, key) {
	let idx = _bucket_index(key)
	let bucket = h[idx]
	let new_bucket = []
	let i = 0
	while i < _length(bucket) {
		let pair = bucket[i]
		if not _equal(pair[0], key) {
			new_bucket = _append(new_bucket, pair)
		}
		i = i + 1
	}
	# Build new hash with updated bucket
	let new_h = []
	let j = 0
	while j < _HASH_SIZE {
		if _equal(j, idx) {
			new_h = _append(new_h, new_bucket)
		} else {
			new_h = _append(new_h, h[j])
		}
		j = j + 1
	}
	return new_h
}

let hash_keys = (h) {
	let keys = []
	let i = 0
	while i < _HASH_SIZE {
		let bucket = h[i]
		let j = 0
		while j < _length(bucket) {
			keys = _append(keys, bucket[j][0])
			j = j + 1
		}
		i = i + 1
	}
	return keys
}

let hash_values = (h) {
	let values = []
	let i = 0
	while i < _HASH_SIZE {
		let bucket = h[i]
		let j = 0
		while j < _length(bucket) {
			values = _append(values, bucket[j][1])
			j = j + 1
		}
		i = i + 1
	}
	return values
}

# List utilities
let reverse = (list) {
	let result = []
	let i = _length(list) - 1
	while i >= 0 {
		result = _append(result, list[i])
		i = i - 1
	}
	return result
}

let find = (list, f) {
	let i = 0
	while i < _length(list) {
		if f(list[i]) {
			return list[i]
		}
		i = i + 1
	}
	return [@error, :lookup, "not found"]
}

let any = (list, f) {
	let i = 0
	while i < _length(list) {
		if f(list[i]) {
			return true
		}
		i = i + 1
	}
	return false
}

let all = (list, f) {
	let i = 0
	while i < _length(list) {
		if not f(list[i]) {
			return false
		}
		i = i + 1
	}
	return true
}

let max = (list) {
	if _empty(list) {
		return [@error, :empty, "empty list"]
	}
	let result = list[0]
	let i = 1
	while i < _length(list) {
		if list[i] > result {
			result = list[i]
		}
		i = i + 1
	}
	return result
}

let min = (list) {
	if _empty(list) {
		return [@error, :empty, "empty list"]
	}
	let result = list[0]
	let i = 1
	while i < _length(list) {
		if list[i] < result {
			result = list[i]
		}
		i = i + 1
	}
	return result
}

# REPL control
let quit = () {
	_quit()
}

let reset = () {
	_reset()
}

let help = (...args) {
	if empty(args) {
		_help("")
	} else {
		_help(first(args))
	}
}

let doc = (name) {
	_doc(name)
}

# List concatenation
let concat = (a, b) {
	reduce(b, a, (acc, x) {
		append(acc, x)
	})
}
