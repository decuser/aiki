apply
Applies a function to a list of arguments.

apply(fn, args)

let add = (a, b) { a + b }
apply(add, [1, 2])  # 3
===
load
Loads and evaluates an aiki source file.

load(path)

load("utils.ai")
load("lib/helpers.ai")
===
stack_limit

Sets the maximum non tail call depth for evaluation. Tail calls do not consume stack.

stack_limit(n)

n must be an integer >= 1.

Example

stack_limit(10000)
===
spawn
Runs a function concurrently with an isolated environment.
The spawned function only sees its arguments and prelude - 
no access to outer scope bindings.

spawn(fn, arg, ...)

let worker = (ch) { send(ch, 42) }
let ch = channel()
spawn(worker, ch)
recv(ch)  # 42
===
channel
Creates a new unbuffered channel for communication between
concurrent functions.

channel()

let ch = channel()
===
send
Sends a value on a channel. Blocks until the value is received.

send(ch, val)

send(ch, 42)
send(ch, [@done])
===
recv
Receives a value from a channel. Blocks until a value is sent.

recv(ch)

let val = recv(ch)
===
print
Prints values to stdout without newline.

print(val, ...)

print("hello")
print("x = ", x)
===
read
Reads a line from stdin. Returns string without newline,
or [@end] on EOF.

read()

let name = read()
===
input
Reads a line from stdin (alias for read).

input()

let name = input()
===
first
Returns the first element of a list.

first(list)

first([1, 2, 3])      # 1
first(["a", "b"])     # "a"
===
rest
Returns a new list without the first element.

rest(list)

rest([1, 2, 3])       # [2, 3]
rest([1])             # []
===
length
Returns the number of elements in a list.

length(list)

length([1, 2, 3])     # 3
length([])            # 0
===
prepend
Returns a new list with the value at the front.

prepend(list, val)

prepend([2, 3], 1)    # [1, 2, 3]
===
append
Returns a new list with the value at the end.

append(list, val)

append([1, 2], 3)     # [1, 2, 3]
===
empty
Returns true if the list has no elements.

empty(list)

empty([])             # true
empty([1])            # false
===
type
Returns the type of a value as a symbol.

type(val)

type(42)              # :number
type("hi")            # :string
type([1, 2])          # :list
type(true)            # :boolean
===
inspect
Returns a string representation of any value.

inspect(val)

inspect(42)           # "42"
inspect([1, 2])       # "[1, 2]"
===
equal
Returns true if two values are deeply equal.

equal(a, b)

equal(1, 1)           # true
equal([1], [1])       # true
equal(1, 2)           # false
===
shape
Returns the shape name of a shaped list, or :list for plain lists.

shape(val)

shape([@point, 1, 2]) # :point
shape([1, 2, 3])      # :list
===
is_error
Returns true if the value is a shaped error [@error, ...].

is_error(val)

is_error([@error, :lookup, "not found"])  # true
is_error([1, 2, 3])                        # false
===
ord
Returns the integer code point of a rune.

ord(rune)

ord('A')              # 65
ord('a')              # 97
===
chr
Returns the rune for an integer code point.
Inverse of ord.

chr(n)

chr(65)               # 'A'
chr(97)               # 'a'
chr(8364)             # '€'
ord(chr(65))          # 65
===
to_str
Converts a value to its string representation.

to_str(val)

to_str(42)            # "42"
to_str('A')           # "A"
===
to_number
Parses a string as a number.

to_number(str)

to_number("42")       # 42
to_number("3.14")     # 3.14
===
to_decimal
Formats a number as a decimal string with specified places.

to_decimal(n, places)

to_decimal(3.14159, 2)  # "3.14"
to_decimal(1/3, 4)      # "0.3333"
===
quit
Exits the REPL.

quit()

quit()
===
reset
Resets the environment to initial state.

reset()

reset()
===
delete
Deletes a user binding by name, allowing a shadowed prelude function to be visible again.

delete(name)

name must be a string.

Returns true if a binding was deleted, false otherwise.

let print = 1
delete("print")
print("restored!")
===
help
Shows help for a function.

help(name)

help(:print)
help(:append)
===
doc
Shows full documentation for a function.

doc(name)

doc(:spawn)
doc(:equal)
