apply
Applies a function to a list of arguments.

apply(fn, args)

let add = (a, b) { a + b }
apply(add, [1, 2])  # 3
===
load
Loads and evaluates an aiki source file.

load(path)

load("utils.ai")
load("lib/helpers.ai")
===
spawn
Runs a function concurrently with an isolated environment.
The spawned function only sees its arguments and prelude - 
no access to outer scope bindings.

spawn(fn, arg, ...)

let worker = (ch) { send(ch, 42) }
let ch = channel()
spawn(worker, ch)
recv(ch)  # 42
===
channel
Creates a new unbuffered channel for communication between
concurrent functions.

channel()

let ch = channel()
===
send
Sends a value on a channel. Blocks until the value is received.

send(ch, val)

send(ch, 42)
send(ch, [@done])
===
recv
Receives a value from a channel. Blocks until a value is sent.

recv(ch)

let val = recv(ch)
===
print
Prints values to stdout without newline.

print(val, ...)

print("hello")
print("x = ", x)
===
println
Prints values to stdout followed by newline.

println(val, ...)

println("hello")
println("result:", x)
===
read
Reads a line from stdin. Returns string without newline,
or [@end] on EOF.

read()

let name = read()
===
first
Returns the first element of a list.

first(list)

first([1, 2, 3])      # 1
first(["a", "b"])     # "a"
===
rest
Returns a new list without the first element.

rest(list)

rest([1, 2, 3])       # [2, 3]
rest([1])             # []
===
length
Returns the number of elements in a list.

length(list)

length([1, 2, 3])     # 3
length([])            # 0
===
prepend
Returns a new list with the value at the front.

prepend(list, val)

prepend([2, 3], 1)    # [1, 2, 3]
===
append
Returns a new list with the value at the end.

append(list, val)

append([1, 2], 3)     # [1, 2, 3]
===
empty
Returns true if the list has no elements.

empty(list)

empty([])             # true
empty([1])            # false
===
range
Returns a list of integers from start to end-1.

range(start, end)

range(0, 5)           # [0, 1, 2, 3, 4]
range(1, 4)           # [1, 2, 3]
===
reverse
Returns a new list with elements in reverse order.

reverse(list)

reverse([1, 2, 3])    # [3, 2, 1]
===
type
Returns the type of a value as a symbol.

type(val)

type(42)              # :number
type("hi")            # :string
type([1, 2])          # :list
type(true)            # :boolean
===
inspect
Returns a string representation of any value.

inspect(val)

inspect(42)           # "42"
inspect([1, 2])       # "[1, 2]"
===
equal
Returns true if two values are deeply equal.

equal(a, b)

equal(1, 1)           # true
equal([1], [1])       # true
equal(1, 2)           # false
===
shape
Returns the shape name of a shaped list, or :list for plain lists.

shape(val)

shape([@point, 1, 2]) # :point
shape([1, 2, 3])      # :list
===
map
Applies a function to each element, returns new list of results.

map(list, fn)

map([1, 2, 3], (x) { x * 2 })    # [2, 4, 6]
===
filter
Returns elements where the function returns true.

filter(list, fn)

filter([1, 2, 3, 4], (x) { x > 2 })  # [3, 4]
===
reduce
Reduces a list to a single value by applying fn to accumulator
and each element.

reduce(list, init, fn)

reduce([1, 2, 3], 0, (acc, x) { acc + x })  # 6
===
each
Calls function on each element for side effects. Returns true.

each(list, fn)

each([1, 2, 3], (x) { println(x) })
===
find
Returns first element where function returns true,
or [@error, "not found"].

find(list, fn)

find([1, 2, 3], (x) { x > 1 })  # 2
===
any
Returns true if function returns true for any element.

any(list, fn)

any([1, 2, 3], (x) { x > 2 })   # true
any([1, 2], (x) { x > 5 })      # false
===
all
Returns true if function returns true for all elements.

all(list, fn)

all([2, 4, 6], (x) { modulo(x, 2) == 0 })  # true
===
canvas
Creates a drawing canvas window of the specified size.

canvas(width, height)

let c = canvas(800, 600)
===
dot
Draws a single point at coordinates (x, y).

dot(c, x, y)

dot(c, 100, 100)
===
line
Draws a line from (x1, y1) to (x2, y2).

line(c, x1, y1, x2, y2)

line(c, 0, 0, 100, 100)
===
clear
Clears the canvas to the background color.

clear(c)

clear(c)
===
quit
Exits the REPL.

quit()

quit()
===
reset
Resets the environment to initial state.

reset()

reset()
===


stack_limit

Sets the maximum non tail call depth for evaluation. Tail calls do not consume stack.

stack_limit(n)

n must be an integer >= 1.

Example

stack_limit(10000)
chr
Returns the rune for an integer code point.
Inverse of ord.

chr(n)

chr(65)                   # 'A'
chr(97)                   # 'a'
chr(8364)                 # '€'
ord(chr(65))              # 65
===
concat
Returns a new list with elements of b appended to a.

concat(a, b)

concat([1, 2], [3, 4])    # [1, 2, 3, 4]
concat([], [1, 2])        # [1, 2]
concat([1], [])           # [1]
===
substring
Extracts a substring from start index to end index (exclusive).

substring(s, start, end)

substring("hello", 0, 2)          # "he"
substring("hello", 1, 4)          # "ell"
substring("hello", 2, 10)         # "llo" (bounds safe)
===
join
Joins a list of strings with a delimiter.

join(list, delim)

join(["a", "b", "c"], ", ")   # "a, b, c"
join(["x"], "-")              # "x"
join([], ",")                 # ""
===
split
Splits a string by delimiter into a list.

split(s, delim)

split("a,b,c", ",")           # ["a", "b", "c"]
split("hello", "")            # ["h", "e", "l", "l", "o"]
split("no match", ",")        # ["no match"]
===
index_of
Returns index of first occurrence of substring.
Returns [@error, :lookup, "not found"] if not found.

index_of(s, sub)

index_of("hello", "l")            # 2
index_of("hello", "ll")           # 2
index_of("hello", "x")            # [@error, :lookup, "not found"]
===
last_index_of
Returns index of last occurrence of substring.

last_index_of(s, sub)

last_index_of("hello", "l")       # 3
last_index_of("abcabc", "bc")     # 4
===
contains
Returns true if string contains substring.

contains(s, sub)

contains("hello", "ell")      # true
contains("hello", "x")        # false
===
starts_with
Returns true if string starts with prefix.

starts_with(s, prefix)

starts_with("hello", "he")    # true
starts_with("hello", "lo")    # false
===
ends_with
Returns true if string ends with suffix.

ends_with(s, suffix)

ends_with("hello", "lo")      # true
ends_with("hello", "he")      # false
===
occurrences
Counts occurrences of substring.

occurrences(s, sub)

occurrences("banana", "a")          # 3
occurrences("hello", "l")           # 2
occurrences("hello", "x")           # 0
===
replace
Replaces all occurrences of old with new.

replace(s, old, new)

replace("hello", "l", "L")    # "heLLo"
replace("aaa", "a", "bb")     # "bbbbbb"
===
replace_first
Replaces only the first occurrence.

replace_first(s, old, new)

replace_first("hello", "l", "L")  # "heLlo"
===
repeat
Repeats string n times.

repeat(s, n)

repeat("ab", 3)               # "ababab"
repeat("x", 0)                # ""
===
reverse_string
Reverses a string.

reverse_string(s)

reverse_string("hello")          # "olleh"
reverse_string("안녕")            # "녕안"
===
insert
Inserts substring at position.

insert(s, pos, sub)

insert("hello", 2, "XX")      # "heXXllo"
insert("ab", 1, "-")          # "a-b"
===
remove
Removes characters from start to end (exclusive).

remove(s, start, end)

remove("hello", 1, 3)         # "hlo"
remove("abcde", 0, 2)         # "cde"
===
is_whitespace
Returns true if rune is whitespace (space, tab, newline, carriage return).

is_whitespace(r)

is_whitespace(' ')            # true
is_whitespace('a')            # false
===
trim_start
Removes leading whitespace.

trim_start(s)

trim_start("  hello")         # "hello"
===
trim_end
Removes trailing whitespace.

trim_end(s)

trim_end("hello  ")           # "hello"
===
trim
Removes leading and trailing whitespace.

trim(s)

trim("  hello  ")             # "hello"
===
pad_start
Pads string at start to reach target length.

pad_start(s, len, char)

pad_start("42", 5, '0')       # "00042"
pad_start("hello", 3, 'x')    # "hello" (already longer)
===
pad_end
Pads string at end to reach target length.

pad_end(s, len, char)

pad_end("42", 5, '0')         # "42000"
===
center
Centers string with padding on both sides.

center(s, len, char)

center("hi", 6, '-')          # "--hi--"
center("abc", 6, ' ')         # " abc  "
===
truncate
Truncates string to maximum length.

truncate(s, len)

truncate("hello", 3)          # "hel"
truncate("hi", 10)            # "hi"
===
chars
Converts string to list of runes.

chars(s)

chars("hi")                   # ['h', 'i']
chars("안녕")                  # ['안', '녕']
===
lines
Splits string into lines by newline.

lines(s)

lines("a\nb\nc")              # ["a", "b", "c"]
===
words
Splits string into words by whitespace.

words(s)

words("hello world")          # ["hello", "world"]
words("  spaced  out  ")      # ["spaced", "out"]
===
is_digit
Returns true if rune is digit 0-9.

is_digit(r)

is_digit('5')                 # true
is_digit('a')                 # false
===
is_alpha
Returns true if rune is alphabetic a-z or A-Z.

is_alpha(r)

is_alpha('a')                 # true
is_alpha('5')                 # false
===
is_upper
Returns true if rune is uppercase A-Z.

is_upper(r)

is_upper('A')                 # true
is_upper('a')                 # false
===
is_lower
Returns true if rune is lowercase a-z.

is_lower(r)

is_lower('a')                 # true
is_lower('A')                 # false
===
is_alnum
Returns true if rune is alphanumeric.

is_alnum(r)

is_alnum('a')                 # true
is_alnum('5')                 # true
is_alnum('!')                 # false
===
is_numeric
Returns true if string contains only digits.

is_numeric(s)

is_numeric("123")             # true
is_numeric("12.3")            # false
is_numeric("")                # false
===
is_alphabetic
Returns true if string contains only letters.

is_alphabetic(s)

is_alphabetic("hello")        # true
is_alphabetic("hello1")       # false
===
compare
Lexicographic comparison. Returns -1 if a < b, 0 if equal, 1 if a > b.

compare(a, b)

compare("abc", "abd")         # -1
compare("abc", "abc")         # 0
compare("abd", "abc")         # 1
===
upper
Converts string to uppercase using Unicode rules.

upper(s)

upper("hello")                # "HELLO"
upper("café")                 # "CAFÉ"
===
lower
Converts string to lowercase using Unicode rules.

lower(s)

lower("HELLO")                # "hello"
lower("CAFÉ")                 # "café"
===
upper_rune
Converts a single rune to uppercase.

upper_rune(r)

upper_rune('a')               # 'A'
upper_rune('é')               # 'É'
===
lower_rune
Converts a single rune to lowercase.

lower_rune(r)

lower_rune('A')               # 'a'
===
capitalize
Uppercases first character, lowercases rest.

capitalize(s)

capitalize("hello")           # "Hello"
capitalize("HELLO")           # "Hello"
===
title
Title cases each word.

title(s)

title("hello world")          # "Hello World"
===
equal_ignore_case
Case-insensitive string equality.

equal_ignore_case(a, b)

equal_ignore_case("Hello", "HELLO")  # true
equal_ignore_case("abc", "ABC")      # true
===
