# Prelude function help - quick reference

# Core
@func apply
@template "apply(fn, args)"
@help "Applies function to list of arguments."

@func load
@template "load(path)"
@help "Loads and evaluates an aiki file."

@func stack_limit
@template "stack_limit(n)"
@help "Sets the maximum non tail call depth. n must be an integer >= 1."

# Concurrency
@func spawn
@template "spawn(fn, arg, ...)"
@help "Runs function concurrently with isolated environment."

@func channel
@template "channel()"
@help "Creates a new channel for communication."

@func send
@template "send(ch, val)"
@help "Sends value on channel, blocks until received."

@func recv
@template "recv(ch)"
@help "Receives value from channel, blocks until sent."

# IO
@func print
@template "print(val, ...)"
@help "Prints values to stdout."

@func println
@template "println(val, ...)"
@help "Prints values to stdout followed by newline."

@func read
@template "read()"
@help "Reads a line from stdin."

@func input
@template "input()"
@help "Reads a line from stdin (alias for read)."

# List intrinsics
@func first
@template "first(list)"
@help "Returns first element of list."

@func rest
@template "rest(list)"
@help "Returns list without first element."

@func length
@template "length(list)"
@help "Returns number of elements in list."

@func prepend
@template "prepend(list, val)"
@help "Returns new list with val at front."

@func append
@template "append(list, val)"
@help "Returns new list with val at end."

@func empty
@template "empty(list)"
@help "Returns true if list is empty."

# Math
@func abs
@template "abs(n)"
@help "Returns absolute value of number."

@func truncate
@template "truncate(n)"
@help "Truncate number toward zero, returning integer part."

# Type operations
@func type
@template "type(val)"
@help "Returns type of value as symbol."

@func inspect
@template "inspect(val)"
@help "Returns string representation of value."

@func equal
@template "equal(a, b)"
@help "Returns true if values are deeply equal."

@func shape
@template "shape(val)"
@help "Returns shape name of list, or :list."

@func is_error
@template "is_error(val)"
@help "Returns true if val is a shaped error [@error, ...]."

@func ord
@template "ord(rune)"
@help "Returns integer code point of rune."

@func chr
@template "chr(n)"
@help "Returns rune for integer code point."

# Conversion
@func to_str
@template "to_str(val)"
@help "Converts value to string."

@func to_number
@template "to_number(str)"
@help "Parses string as number."

@func to_decimal
@template "to_decimal(n, places)"
@help "Formats number as decimal string."

# REPL
@func quit
@template "quit()"
@help "Exits the REPL."

@func reset
@template "reset()"
@help "Resets the environment."

@func delete
@template "delete(name)"
@help "Deletes a user binding, restoring shadowed prelude function."

@func help
@template "help(name)"
@help "Shows help for name."

@func doc
@template "doc(name)"
@help "Shows full documentation for name."
