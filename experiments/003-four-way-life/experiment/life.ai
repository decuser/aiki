package "four_way_life"

let list = import("list")
let store = import("store")
let bytes = import("bytes/ffi")

let mod = (a, b) {
	return a - (truncate(a / b) * b)
}

let index = (x, y, width) {
	return (y * width) + x
}

let grid_from_text = (text) {
	return bytes.digits_from_text(text)
}

let grid_length = (grid) {
	if equal(type(grid), :bytes) {
		return bytes.bytes_length(grid)
	}
	return length(grid)
}

let cell = (grid, i) {
	if equal(type(grid), :bytes) {
		return bytes.bytes_get(grid, i)
	}
	return grid[i]
}

let byte_grid_length = (grid) {
	return bytes.bytes_length(grid)
}

let byte_cell = (grid, i) {
	return bytes.bytes_get(grid, i)
}

let grid_to_text = (grid) {
	if equal(type(grid), :bytes) {
		return bytes.digits_to_text(grid)
	}
	let text = ""
	let i = 0
	while i < length(grid) {
		text = text + to_str(grid[i])
		i = i + 1
	}
	return text
}

let byte_neighbor_counts = (grid, width, height, x, y) {
	let total = 0
	let c1 = 0
	let c2 = 0
	let c3 = 0
	let c4 = 0
	let dy = 0 - 1
	while dy <= 1 {
		let dx = 0 - 1
		while dx <= 1 {
			if not (equal(dx, 0) and equal(dy, 0)) {
				let nx = x + dx
				let ny = y + dy
				if (nx >= 0) and (nx < width) and (ny >= 0) and (ny < height) {
					let owner = bytes.bytes_get(grid, index(nx, ny, width))
					if owner > 0 {
						total = total + 1
						if equal(owner, 1) {
							c1 = c1 + 1
						}
						if equal(owner, 2) {
							c2 = c2 + 1
						}
						if equal(owner, 3) {
							c3 = c3 + 1
						}
						if equal(owner, 4) {
							c4 = c4 + 1
						}
					}
				}
			}
			dx = dx + 1
		}
		dy = dy + 1
	}
	return [total, c1, c2, c3, c4]
}

let neighbor_counts = (grid, width, height, x, y) {
	let total = 0
	let c1 = 0
	let c2 = 0
	let c3 = 0
	let c4 = 0
	let dy = 0 - 1
	while dy <= 1 {
		let dx = 0 - 1
		while dx <= 1 {
			if not (equal(dx, 0) and equal(dy, 0)) {
				let nx = x + dx
				let ny = y + dy
				if (nx >= 0) and (nx < width) and (ny >= 0) and (ny < height) {
					let owner = cell(grid, index(nx, ny, width))
					if owner > 0 {
						total = total + 1
						if equal(owner, 1) {
							c1 = c1 + 1
						}
						if equal(owner, 2) {
							c2 = c2 + 1
						}
						if equal(owner, 3) {
							c3 = c3 + 1
						}
						if equal(owner, 4) {
							c4 = c4 + 1
						}
					}
				}
			}
			dx = dx + 1
		}
		dy = dy + 1
	}
	return [total, c1, c2, c3, c4]
}

# byte_active_frontier is the hot byte-grid version of active_frontier. It avoids
# the generic type/cell dispatch because worker grids are byte-backed after
# protocol decoding.
let byte_active_frontier = (grid, width, height) {
	let n = bytes.bytes_length(grid)
	let marks = store.new(n)
	let candidate_buffer = store.new(n)
	let candidate_count = 0
	let i = 0
	while i < n {
		if bytes.bytes_get(grid, i) > 0 {
			let y = truncate(i / width)
			let x = mod(i, width)
			let dy = 0 - 1
			while dy <= 1 {
				let dx = 0 - 1
				while dx <= 1 {
					let nx = x + dx
					let ny = y + dy
					if (nx >= 0) and (nx < width) and (ny >= 0) and (ny < height) {
						let candidate = index(nx, ny, width)
						if equal(store.get(marks, candidate), 0) {
							store.set(marks, candidate, 1)
							store.set(candidate_buffer, candidate_count, candidate)
							candidate_count = candidate_count + 1
						}
					}
					dx = dx + 1
				}
				dy = dy + 1
			}
		}
		i = i + 1
	}
	return store.snapshot(candidate_buffer, candidate_count)
}

# active_frontier returns exactly the cells that can possibly matter to the
# next generation: every live cell plus every in-bounds neighbor of a live
# cell. Dead cells outside this set cannot be born, so running the Life rule
# there is wasted work. A local Store is used only as a dedup bitmap.
let active_frontier = (grid, width, height) {
	let n = grid_length(grid)
	let marks = store.new(n)
	let candidate_buffer = store.new(n)
	let candidate_count = 0
	let i = 0
	while i < n {
		if cell(grid, i) > 0 {
			let y = truncate(i / width)
			let x = mod(i, width)
			let dy = 0 - 1
			while dy <= 1 {
				let dx = 0 - 1
				while dx <= 1 {
					let nx = x + dx
					let ny = y + dy
					if (nx >= 0) and (nx < width) and (ny >= 0) and (ny < height) {
						let candidate = index(nx, ny, width)
						if equal(store.get(marks, candidate), 0) {
							store.set(marks, candidate, 1)
							store.set(candidate_buffer, candidate_count, candidate)
							candidate_count = candidate_count + 1
						}
					}
					dx = dx + 1
				}
				dy = dy + 1
			}
		}
		i = i + 1
	}
	return store.snapshot(candidate_buffer, candidate_count)
}

let byte_next_for_owner = (grid, width, height, owner) {
	let candidates = byte_active_frontier(grid, width, height)
	let position_buffer = store.new(length(candidates))
	let position_count = 0
	let at = 0
	while at < length(candidates) {
		let i = candidates[at]
		let y = truncate(i / width)
		let x = mod(i, width)
		let current = bytes.bytes_get(grid, i)
		let counts = byte_neighbor_counts(grid, width, height, x, y)
		let total = counts[0]
		let alive_next = false
		if equal(current, owner) {
			alive_next = equal(total, 2) or equal(total, 3)
		} else {
			if equal(current, 0) and equal(total, 3) and (counts[owner] >= 2) {
				alive_next = true
			}
		}
		if alive_next {
			store.set(position_buffer, position_count, i)
			position_count = position_count + 1
		}
		at = at + 1
	}
	# Preserve the original row-major proposal order as part of the experiment
	# protocol even though frontier discovery itself is sparse.
	return list.sort(store.snapshot(position_buffer, position_count))
}

let next_for_owner = (grid, width, height, owner) {
	let candidates = active_frontier(grid, width, height)
	let position_buffer = store.new(length(candidates))
	let position_count = 0
	let at = 0
	while at < length(candidates) {
		let i = candidates[at]
		let y = truncate(i / width)
		let x = mod(i, width)
		let current = cell(grid, i)
		let counts = neighbor_counts(grid, width, height, x, y)
		let total = counts[0]
		let alive_next = false
		if equal(current, owner) {
			alive_next = equal(total, 2) or equal(total, 3)
		} else {
			if equal(current, 0) and equal(total, 3) and (counts[owner] >= 2) {
				alive_next = true
			}
		}
		if alive_next {
			store.set(position_buffer, position_count, i)
			position_count = position_count + 1
		}
		at = at + 1
	}
	# Preserve the original row-major proposal order as part of the experiment
	# protocol even though frontier discovery itself is sparse.
	return list.sort(store.snapshot(position_buffer, position_count))
}

let _glider_at = (x, y, base_x, base_y, flip_x, flip_y) {
	let dx = x - base_x
	let dy = y - base_y
	if flip_x {
		dx = 2 - dx
	}
	if flip_y {
		dy = 2 - dy
	}
	return (equal(dx, 0) and equal(dy, 1)) or (equal(dx, 1) and equal(dy, 2)) or (equal(dx, 2) and equal(dy, 0)) or (equal(dx, 2) and equal(dy, 1)) or (equal(dx, 2) and equal(dy, 2))
}

let seed_grid = (width, height, seed) {
	let grid = []
	let shift = mod(abs(seed), 3)
	let left_x = truncate(width / 3) + shift
	let right_x = (width - truncate(width / 3) - 3) - shift
	let top_y = truncate(height / 3)
	let bottom_y = height - truncate(height / 3) - 3
	let y = 0
	while y < height {
		let x = 0
		while x < width {
			let owner = 0
			# All four populations begin with the same canonical glider,
			# reflected so its initial motion is toward the center. Anchors
			# are proportional to grid size so the populations meet sooner.
			if _glider_at(x, y, left_x, top_y, false, false) {
				owner = 1
			}
			if _glider_at(x, y, right_x, top_y, true, false) {
				owner = 2
			}
			if _glider_at(x, y, left_x, bottom_y, false, true) {
				owner = 3
			}
			if _glider_at(x, y, right_x, bottom_y, true, true) {
				owner = 4
			}
			grid = append(grid, owner)
			x = x + 1
		}
		y = y + 1
	}
	return grid
}

let checksum = (grid) {
	let value = 17
	let n = grid_length(grid)
	let i = 0
	while i < n {
		value = mod(((value * 131) + cell(grid, i)) + i, 1000000007)
		i = i + 1
	}
	return value
}

let store_checksum = (grid, n) {
	let value = 17
	let i = 0
	while i < n {
		value = mod(((value * 131) + store.get(grid, i)) + i, 1000000007)
		i = i + 1
	}
	return value
}

export(
	:index,
	:grid_from_text,
	:grid_to_text,
	:grid_length,
	:cell,
	:byte_grid_length,
	:byte_cell,
	:byte_neighbor_counts,
	:active_frontier,
	:byte_active_frontier,
	:next_for_owner,
	:byte_next_for_owner,
	:seed_grid,
	:checksum,
	:store_checksum
)
