let system = import("system")
let io = import("io")
let file = import("file")
let path = import("path")
let string = import("string")
let bytes = import("bytes/ffi")
let time = import("time")
let hash = import("hash")
let random = import("random")
let process = import("process")
let regex = import("regex/ffi")
let number = import("number")
let list = import("list")
let math = import("math/native")
let life = import("./life")
let protocol = import("./protocol")

let args = system.args()

let showcase_dir = system.env("FWL_SHOWCASE_DIR")

let worker_label = (owner) {
	if equal(owner, 1) { return "A FILE" }
	if equal(owner, 2) { return "B ENV/TIME" }
	if equal(owner, 3) { return "C PROCESS" }
	return "D COMPUTE"
}

let showcase_log = (owner, text) {
	if is_error(showcase_dir) { return [] }
	let log_path = path.join(showcase_dir, "worker-" + to_str(owner) + ".log")
	let log = file.open(log_path, :append)
	if is_error(log) { return log }
	file.write_text(log, text + "\n")
	file.close(log)
	return true
}

let mod = (a, b) { a - (truncate(a / b) * b) }

let contains = (xs, value) {
	return list.any(xs, (x) { equal(x, value) })
}

let owned_positions = (grid, owner) {
	let positions = []
	let i = 0
	while i < length(grid) {
		if equal(grid[i], owner) { positions = append(positions, i) }
		i = i + 1
	}
	return positions
}

let protect = (grid, positions, owner, selector) {
	let owned = owned_positions(grid, owner)
	if equal(length(owned), 0) { return positions }
	let pick = owned[mod(abs(selector), length(owned))]
	if not contains(positions, pick) { return append(positions, pick) }
	return positions
}

let engine_a = (generation, grid, owner, positions) {
	if not equal(mod(generation, 3), 0) { return positions }
	let pattern_path = path.join(path.cwd(), "data/engine-a.pattern")
	let info = file.stat(pattern_path)
	if equal(shape(info), :error) { return positions }
	let text = file.read_all(pattern_path) |> string.trim()
	let raw = file.read_all_bytes(pattern_path)
	let fields = text |> string.split("|")
	let selector = bytes.bytes_length(raw) + info[0]
	if length(fields) > 2 {
		let values = fields[2] |> string.split(",")
		selector = selector + to_number(values[mod(generation, length(values))])
	}
	return protect(grid, positions, owner, selector)
}

let engine_b = (generation, grid, owner, positions) {
	let seed_text = system.env("FWL_SEED")
	let seed = 42
	if not equal(shape(seed_text), :error) { seed = to_number(seed_text) }
	let rate_text = system.env("FWL_MUTATION_RATE")
	let rate = 2
	if not equal(shape(rate_text), :error) { rate = to_number(rate_text) }
	if equal(rate, 0) { return positions }
	# An explicit runtime seed makes headless runs reproducible. Current time is
	# used only when the coordinator deliberately omits that seed.
	if equal(shape(seed_text), :error) { seed = time.now() }
	random.seed(seed + generation)
	let jitter = random.random(1000000)
	let h = hash.hash_code("B:" + to_str(seed) + ":" + to_str(generation) + ":" + to_str(jitter))
	return protect(grid, positions, owner, h)
}

let engine_c = (generation, grid, owner, positions) {
	if not equal(mod(generation, 4), 0) { return positions }
	let child = process.start("aiki", ["helper.ai", to_str(generation)])
	let out = process.stdout(child)
	let line = io.read_line(out)
	io.close(out)
	let status = process.wait(child)
	if not equal(status, 0) { return positions }
	if not regex.matches(line, "^VALUE\\|[0-9a-f]+$") { return positions }
	let parts = string.split(line, "|")
	let selector = number.from_base(parts[1], 16)
	if equal(shape(selector), :error) { return positions }
	return protect(grid, positions, owner, selector)
}

let engine_d = (generation, grid, owner, positions) {
	let owned = owned_positions(grid, owner)
	if equal(length(owned), 0) { return positions }
	let transformed = owned |> list.map((x) { x + generation })
	let selected = transformed |> list.filter((x) { equal(mod(x, 2), mod(generation, 2)) })
	let ordered = list.sort(selected, (a, b) { a > b })
	let score = ordered |> list.reduce(0, (acc, x) { acc + x })
	let root = math.sqrt((score * score) + 1, 8)
	let event = [@engine_d, generation, truncate(root)]
	match event {
		[@engine_d, generation, score] { return protect(grid, positions, owner, score) }
		_ { return positions }
	}
}

if length(args) < 1 {
	io.write(:stderr, "worker: missing owner argument\n")
} else {
	let owner = to_number(args[0])
	showcase_log(owner, "ENGINE " + worker_label(owner) + " START pid-domain=" + worker_label(owner))
	let running = true
	while running {
		let line = io.read_line(:stdin)
		if equal(shape(line), :end) {
			running = false
		} else {
			if equal(line, "STOP") {
				running = false
			} else {
				let frame = protocol.decode_gen(line)
				if equal(shape(frame), :error) {
					io.write(:stderr, "worker: " + inspect(frame) + "\n")
					running = false
				} else {
					let generation = frame[0]
					let width = frame[1]
					let height = frame[2]
					let grid = life.grid_from_text(frame[3])
					let positions = life.next_for_owner(grid, width, height, owner)
					if equal(owner, 1) { positions = engine_a(generation, grid, owner, positions) }
					if equal(owner, 2) { positions = engine_b(generation, grid, owner, positions) }
					if equal(owner, 3) { positions = engine_c(generation, grid, owner, positions) }
					if equal(owner, 4) { positions = engine_d(generation, grid, owner, positions) }
					showcase_log(owner,
						"ENGINE " + worker_label(owner) +
						" gen=" + to_str(generation) +
						" live=" + to_str(length(positions)))
					io.write(:stdout, protocol.encode_done(owner, generation, positions) + "\n")
				}
			}
		}
	}
}

if length(args) > 0 {
	showcase_log(to_number(args[0]), "ENGINE " + worker_label(to_number(args[0])) + " STOP")
}
