package "aiki_pdp_rk11"

let bits = import("bits/ffi")
let bytes = import("bytes/ffi")
let octal = import("../../reference/octal")
let rk05 = import("../../media/rk05")
let rk05_drive = import("./rk05_drive")
let store = import("store")
let width = import("../../machine/width")

let RKDS = octal.parse("777400")
let RKER = octal.parse("777402")
let RKCS = octal.parse("777404")
let RKWC = octal.parse("777406")
let RKBA = octal.parse("777410")
let RKDA = octal.parse("777412")
let RKDB = octal.parse("777416")

let REG_DS = 0
let REG_ER = 1
let REG_CS = 2
let REG_WC = 3
let REG_BA = 4
let REG_DA = 5
let REG_DB = 6
let DEVICE_BASE = 7
let ACTIVE = 15
let READS = 16
let WRITES = 17
let BYTES_IN = 18
let BYTES_OUT = 19
let WORDS = 20
let DRIVE_COUNT = 8

let CS_ERROR = bits.shl(1, 15)
let CS_READY = bits.shl(1, 7)
let CS_IDE = bits.shl(1, 6)
let CS_GO = 1
let FUNCTION_RESET = 0
let FUNCTION_WRITE = 1
let FUNCTION_READ = 2

let DS_RK05 = bits.shl(1, 11)
let DS_SOK = bits.shl(1, 8)
let DS_DRY = bits.shl(1, 7)
let DS_RWS = bits.shl(1, 6)

let ER_NXD = bits.shl(1, 7)
let ER_NXC = bits.shl(1, 6)
let ER_NXS = bits.shl(1, 5)

let new = () {
	let state = store.new(WORDS)
	let i = 0
	while i < WORDS {
		store.set(state, i, 0)
		i = i + 1
	}
	let unit = 0
	while unit < DRIVE_COUNT {
		store.set(state, DEVICE_BASE + unit, rk05_drive.new())
		unit = unit + 1
	}
	store.set(state, REG_CS, CS_READY)
	return state
}

let selected_unit = (rk) {
	return bits.extract(store.get(rk, REG_DA), 13, 3)
}

let cylinder = (rk) {
	return bits.extract(store.get(rk, REG_DA), 5, 8)
}

let surface = (rk) {
	return bits.extract(store.get(rk, REG_DA), 4, 1)
}

let sector = (rk) {
	return bits.extract(store.get(rk, REG_DA), 0, 4)
}

let drive = (rk, unit) {
	return store.get(rk, DEVICE_BASE + unit)
}

let attached = (rk, unit) {
	if (unit < 0) or (unit >= DRIVE_COUNT) {
		return false
	}
	return rk05_drive.attached(drive(rk, unit))
}

let path = (rk, unit) {
	if not attached(rk, unit) {
		return ""
	}
	return rk05_drive.path(drive(rk, unit))
}

let refresh_ds = (rk) {
	let unit = selected_unit(rk)
	let value = bits.shl(unit, 13)
	if attached(rk, unit) {
		value = value + DS_RK05 + DS_SOK + DS_DRY + DS_RWS + sector(rk)
	}
	store.set(rk, REG_DS, value)
	return true
}

let attach_path = (rk, unit, disk_path) {
	if (unit < 0) or (unit >= DRIVE_COUNT) {
		return [@pdp_fault, :disk_unit, unit]
	}
	let result = rk05_drive.attach_path(drive(rk, unit), disk_path)
	if is_error(result) {
		return result
	}
	refresh_ds(rk)
	return true
}

let reset_disk = (rk) {
	store.set(rk, REG_ER, 0)
	store.set(rk, REG_CS, CS_READY)
	store.set(rk, REG_WC, 0)
	store.set(rk, REG_BA, 0)
	store.set(rk, REG_DA, 0)
	store.set(rk, REG_DB, 0)
	store.set(rk, ACTIVE, 0)
	refresh_ds(rk)
	return true
}

let FIRST_ADDRESS = RKDS
let LAST_ADDRESS = RKDB

let handles = (address) {
	return (address >= FIRST_ADDRESS) and (address <= LAST_ADDRESS)
}

let register_word = (rk, address) {
	if equal(address, RKDS) {
		refresh_ds(rk)
		return store.get(rk, REG_DS)
	}
	if equal(address, RKER) {
		return store.get(rk, REG_ER)
	}
	if equal(address, RKCS) {
		return store.get(rk, REG_CS)
	}
	if equal(address, RKWC) {
		return store.get(rk, REG_WC)
	}
	if equal(address, RKBA) {
		return store.get(rk, REG_BA)
	}
	if equal(address, RKDA) {
		return store.get(rk, REG_DA)
	}
	if equal(address, RKDB) {
		return store.get(rk, REG_DB)
	}
	return [@pdp_fault, :bus_address, address]
}

let read_word = (rk, address) {
	return register_word(rk, address)
}

let read_byte = (rk, address) {
	let base = address
	if not equal(bits.bit_and(base, 1), 0) {
		base = base - 1
	}
	let value = register_word(rk, base)
	if equal(bits.bit_and(address, 1), 0) {
		return bits.low(value, 8)
	}
	return bits.extract(value, 8, 8)
}

let start_command = (rk, value) {
	store.set(rk, REG_CS, bits.bit_and(value, octal.parse("177577")))
	store.set(rk, REG_ER, 0)
	let function = bits.extract(value, 1, 3)
	if equal(function, FUNCTION_RESET) {
		reset_disk(rk)
		return true
	}
	store.set(rk, ACTIVE, 1)
	return true
}

let write_word = (rk, address, value) {
	let word = width.wrap(value, 16)
	if equal(address, RKCS) {
		# Preserve read-only READY from the current state until GO begins a function.
		let writable = bits.bit_and(word, octal.parse("077177"))
		if not equal(bits.bit_and(word, CS_GO), 0) {
			return start_command(rk, writable)
		}
		store.set(rk, REG_CS, writable + CS_READY)
		return true
	}
	if equal(address, RKWC) {
		store.set(rk, REG_WC, word)
		return true
	}
	if equal(address, RKBA) {
		store.set(rk, REG_BA, bits.bit_and(word, octal.parse("177776")))
		return true
	}
	if equal(address, RKDA) {
		store.set(rk, REG_DA, word)
		refresh_ds(rk)
		return true
	}
	return [@pdp_fault, :bus_address, address]
}

let write_byte = (rk, address, value) {
	let base = address
	if not equal(bits.bit_and(base, 1), 0) {
		base = base - 1
	}
	let current = register_word(rk, base)
	let updated = 0
	if equal(bits.bit_and(address, 1), 0) {
		updated = bits.extract(current, 8, 8) * 256 + width.wrap(value, 8)
	} else {
		updated = width.wrap(value, 8) * 256 + bits.low(current, 8)
	}
	return write_word(rk, base, updated)
}

let fail = (rk, bit) {
	store.set(rk, REG_ER, bits.bit_or(store.get(rk, REG_ER), bit))
	store.set(
		rk,
		REG_CS,
		bits.bit_or(bits.bit_and(store.get(rk, REG_CS), octal.parse("077777")), CS_ERROR + CS_READY)
	)
	store.set(rk, ACTIVE, 0)
	refresh_ds(rk)
	return true
}

let disk_sector = (rk) {
	let cyl = cylinder(rk)
	let surf = surface(rk)
	let sec = sector(rk)
	if cyl >= rk05.CYLINDERS {
		return [@disk_error, ER_NXC]
	}
	if sec >= rk05.SECTORS_PER_TRACK {
		return [@disk_error, ER_NXS]
	}
	return ((cyl * rk05.SURFACES) + surf) * rk05.SECTORS_PER_TRACK + sec
}

let word_count = (rk) {
	let wc = store.get(rk, REG_WC)
	if equal(wc, 0) {
		return 65536
	}
	return 65536 - wc
}

let increment_disk_address = (rk) {
	let unit = selected_unit(rk)
	let cyl = cylinder(rk)
	let surf = surface(rk)
	let sec = sector(rk) + 1
	if sec >= rk05.SECTORS_PER_TRACK {
		sec = 0
		surf = surf + 1
		if surf >= rk05.SURFACES {
			surf = 0
			cyl = cyl + 1
		}
	}
	store.set(rk, REG_DA, bits.shl(unit, 13) + bits.shl(cyl, 5) + bits.shl(surf, 4) + sec)
	refresh_ds(rk)
	return true
}

let finish = (rk) {
	store.set(rk, ACTIVE, 0)
	store.set(rk, REG_CS, bits.bit_or(store.get(rk, REG_CS), CS_READY))
	refresh_ds(rk)
	return true
}

let advance = (rk, elapsed, dma_read_word, dma_write_word) {
	if equal(store.get(rk, ACTIVE), 0) {
		return true
	}
	let unit = selected_unit(rk)
	if not attached(rk, unit) {
		return fail(rk, ER_NXD)
	}
	let first_sector = disk_sector(rk)
	match first_sector {
		[@disk_error, bit] {
			return fail(rk, bit)
		}
		_ {
		}
	}
	let function = bits.extract(store.get(rk, REG_CS), 1, 3)
	let words_left = word_count(rk)
	let transferred = 0
	while transferred < words_left {
		let current_sector = disk_sector(rk)
		match current_sector {
			[@disk_error, bit] {
				return fail(rk, bit)
			}
			_ {
			}
		}
		let sector_data = rk05_drive.read_sector(drive(rk, unit), current_sector)
		if is_error(sector_data) {
			return sector_data
		}
		let buffer = store.new(rk05.SECTOR_BYTES)
		let byte_index = 0
		while byte_index < rk05.SECTOR_BYTES {
			store.set(buffer, byte_index, bytes.bytes_get(sector_data, byte_index))
			byte_index = byte_index + 1
		}
		let sector_word = 0
		while (sector_word < rk05.WORDS_PER_SECTOR) and (transferred < words_left) {
			let offset = sector_word * 2
			let bus_address = store.get(rk, REG_BA)
			if equal(function, FUNCTION_WRITE) {
				let value = dma_read_word(bus_address)
				if is_error(value) {
					return value
				}
				store.set(buffer, offset, bits.low(value, 8))
				store.set(buffer, offset + 1, bits.extract(value, 8, 8))
			} else if equal(function, FUNCTION_READ) {
				let value = store.get(buffer, offset) + (store.get(buffer, offset + 1) * 256)
				let written = dma_write_word(bus_address, value)
				if is_error(written) {
					return written
				}
			} else {
				return finish(rk)
			}
			store.set(rk, REG_DB, store.get(buffer, offset) + (store.get(buffer, offset + 1) * 256))
			store.set(rk, REG_BA, width.wrap(bus_address + 2, 16))
			store.set(rk, REG_WC, width.wrap(store.get(rk, REG_WC) + 1, 16))
			transferred = transferred + 1
			sector_word = sector_word + 1
		}
		if equal(function, FUNCTION_WRITE) {
			let written = rk05_drive.write_sector(
				drive(rk, unit),
				current_sector,
				bytes.bytes_new(store.snapshot(buffer))
			)
			if is_error(written) {
				return written
			}
		}
		if sector_word >= rk05.WORDS_PER_SECTOR {
			increment_disk_address(rk)
		}
	}
	if equal(function, FUNCTION_WRITE) {
		store.set(rk, WRITES, store.get(rk, WRITES) + 1)
		store.set(rk, BYTES_OUT, store.get(rk, BYTES_OUT) + (transferred * 2))
	} else if equal(function, FUNCTION_READ) {
		store.set(rk, READS, store.get(rk, READS) + 1)
		store.set(rk, BYTES_IN, store.get(rk, BYTES_IN) + (transferred * 2))
	}
	return finish(rk)
}

let drive_status = (rk) {
	refresh_ds(rk)
	return store.get(rk, REG_DS)
}

let error = (rk) {
	return store.get(rk, REG_ER)
}

let control_status = (rk) {
	return store.get(rk, REG_CS)
}

let word_count_register = (rk) {
	return store.get(rk, REG_WC)
}

let bus_address = (rk) {
	return store.get(rk, REG_BA)
}

let disk_address = (rk) {
	return store.get(rk, REG_DA)
}

let data_buffer = (rk) {
	return store.get(rk, REG_DB)
}

let read_count = (rk) {
	return store.get(rk, READS)
}

let write_count = (rk) {
	return store.get(rk, WRITES)
}

let bytes_in = (rk) {
	return store.get(rk, BYTES_IN)
}

let bytes_out = (rk) {
	return store.get(rk, BYTES_OUT)
}

let active = (rk) {
	return not equal(store.get(rk, ACTIVE), 0)
}

export(
	:FIRST_ADDRESS,
	:LAST_ADDRESS,
	:active,
	:RKDS,
	:RKER,
	:RKCS,
	:RKWC,
	:RKBA,
	:RKDA,
	:RKDB,
	:DRIVE_COUNT,
	:new,
	:attach_path,
	:attached,
	:path,
	:reset_disk,
	:handles,
	:read_byte,
	:write_byte,
	:read_word,
	:write_word,
	:advance,
	:selected_unit,
	:cylinder,
	:surface,
	:sector,
	:drive_status,
	:error,
	:control_status,
	:word_count_register,
	:bus_address,
	:disk_address,
	:data_buffer,
	:read_count,
	:write_count,
	:bytes_in,
	:bytes_out
)
