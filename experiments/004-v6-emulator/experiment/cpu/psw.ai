package "aiki_pdp_psw"

let fixed = import("machine/ffi")

let C = 0
let V = 1
let Z = 2
let N = 3

let flag = (psw, position) { return fixed.word_bit(psw, position) }
let set_flag = (psw, position, value) { return fixed.word_set_bit(psw, position, value) }
let negative = (psw) { return flag(psw, N) }
let zero = (psw) { return flag(psw, Z) }
let overflow = (psw) { return flag(psw, V) }
let carry = (psw) { return flag(psw, C) }
let set_nz = (psw, value, width) {
	psw = set_flag(psw, N, fixed.negative(value))
	psw = set_flag(psw, Z, fixed.zero(value))
	return psw
}
let set_nzv = (psw, value, width, v) { psw = set_nz(psw, value, width); return set_flag(psw, V, v) }
let set_nzvc = (psw, value, width, v, c) { psw = set_nz(psw, value, width); psw = set_flag(psw, V, v); return set_flag(psw, C, c) }
export(:C,:V,:Z,:N,:negative,:zero,:overflow,:carry,:set_flag,:set_nz,:set_nzv,:set_nzvc)
