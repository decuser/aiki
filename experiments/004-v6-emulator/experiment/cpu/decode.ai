package "aiki_pdp_decode"

let fixed = import("machine/ffi")
let bits = import("bits/ffi")

# Operand specifications are decode metadata, not PDP data values. They leave
# the opaque word domain only as small structural selectors (mode/register).
let operand_mode = (specification) {
	return bits.extract(specification, 3, 3)
}

let operand_register = (specification) {
	return bits.extract(specification, 0, 3)
}

let source_spec_machine = (instruction) {
	return fixed.word_field(instruction, 6, 6)
}

let destination_spec_machine = (instruction) {
	return fixed.word_field(instruction, 0, 6)
}

let major_opcode_machine = (instruction) {
	return fixed.word_field(instruction, 12, 4)
}

let double_operand_kind_machine = (instruction) {
	match major_opcode_machine(instruction) {
		1 {
			return :mov
		}
		2 {
			return :cmp
		}
		3 {
			return :bit
		}
		4 {
			return :bic
		}
		5 {
			return :bis
		}
		6 {
			return :add
		}
		9 {
			return :movb
		}
		10 {
			return :cmpb
		}
		11 {
			return :bitb
		}
		12 {
			return :bicb
		}
		13 {
			return :bisb
		}
		14 {
			return :sub
		}
		_ {
			return :other
		}
	}
}

let single_operand_kind_machine = (instruction) {
	let base = fixed.word_mask(instruction, 65472)
	match base {
		2560 {
			return :clr
		}
		2688 {
			return :inc
		}
		2752 {
			return :dec
		}
		2816 {
			return :neg
		}
		2880 {
			return :adc
		}
		2944 {
			return :sbc
		}
		3008 {
			return :tst
		}
		3072 {
			return :ror
		}
		3200 {
			return :asr
		}
		3264 {
			return :asl
		}
		35328 {
			return :clrb
		}
		35456 {
			return :incb
		}
		35584 {
			return :negb
		}
		35648 {
			return :adcb
		}
		35712 {
			return :sbcb
		}
		35776 {
			return :tstb
		}
		35840 {
			return :rorb
		}
		35968 {
			return :asrb
		}
		36032 {
			return :aslb
		}
		_ {
			return :other
		}
	}
}

let branch_kind_machine = (instruction) {
	let base = fixed.word_mask(instruction, 65280)
	match base {
		256 {
			return :br
		}
		512 {
			return :bne
		}
		768 {
			return :beq
		}
		1024 {
			return :bge
		}
		1280 {
			return :blt
		}
		1536 {
			return :bgt
		}
		1792 {
			return :ble
		}
		32768 {
			return :bpl
		}
		33024 {
			return :bmi
		}
		33280 {
			return :bhi
		}
		33536 {
			return :blos
		}
		33792 {
			return :bvc
		}
		34048 {
			return :bvs
		}
		34304 {
			return :bhis
		}
		34560 {
			return :blo
		}
		_ {
			return :other
		}
	}
}

let eis_kind_machine = (instruction) {
	let base = fixed.word_mask(instruction, 65024)
	match base {
		28672 {
			return :mul
		}
		29184 {
			return :div
		}
		29696 {
			return :ash
		}
		30208 {
			return :ashc
		}
		_ {
			return :other
		}
	}
}

let instruction_kind_machine = (instruction) {
	let kind = double_operand_kind_machine(instruction)
	if not equal(kind, :other) {
		return kind
	}
	kind = single_operand_kind_machine(instruction)
	if not equal(kind, :other) {
		return kind
	}
	kind = branch_kind_machine(instruction)
	if not equal(kind, :other) {
		return kind
	}
	kind = eis_kind_machine(instruction)
	if not equal(kind, :other) {
		return kind
	}
	let single_base = fixed.word_mask(instruction, 65472)
	if equal(single_base, 192) {
		return :swab
	}
	if equal(single_base, 64) {
		return :jmp
	}
	if equal(single_base, 3392) {
		return :mfpi
	}
	if equal(single_base, 3456) {
		return :mtpi
	}
	if equal(fixed.word_mask(instruction, 65024), 2048) {
		return :jsr
	}
	if equal(fixed.word_mask(instruction, 65024), 32256) {
		return :sob
	}
	if equal(fixed.word_mask(instruction, 65528), 128) {
		return :rts
	}
	if fixed.word_eq_number(instruction, 0) {
		return :halt
	}
	if fixed.word_eq_number(instruction, 1) {
		return :wait
	}
	if fixed.word_eq_number(instruction, 5) {
		return :reset
	}
	if fixed.word_eq_number(instruction, 6) {
		return :rtt
	}
	if fixed.word_eq_number(instruction, 160) {
		return :nop
	}
	if fixed.word_ge_number(instruction, 161) and not fixed.word_ge_number(instruction, 192) {
		if fixed.word_eq_number(instruction, 161) {
			return :clc
		}
		return :condition_code
	}
	return :other
}

# Numeric diagnostic boundary. Execution uses only the *_machine forms above.
let source_spec = (instruction) {
	return source_spec_machine(fixed.word(instruction))
}

let destination_spec = (instruction) {
	return destination_spec_machine(fixed.word(instruction))
}

let major_opcode = (instruction) {
	return major_opcode_machine(fixed.word(instruction))
}

let double_operand_kind = (instruction) {
	return double_operand_kind_machine(fixed.word(instruction))
}

let single_operand_kind = (instruction) {
	return single_operand_kind_machine(fixed.word(instruction))
}

let branch_kind = (instruction) {
	return branch_kind_machine(fixed.word(instruction))
}

let eis_kind = (instruction) {
	return eis_kind_machine(fixed.word(instruction))
}

let instruction_kind = (instruction) {
	return instruction_kind_machine(fixed.word(instruction))
}

export(
	:operand_mode,
	:operand_register,
	:source_spec_machine,
	:destination_spec_machine,
	:major_opcode_machine,
	:double_operand_kind_machine,
	:single_operand_kind_machine,
	:branch_kind_machine,
	:eis_kind_machine,
	:instruction_kind_machine,
	:source_spec,
	:destination_spec,
	:major_opcode,
	:double_operand_kind,
	:single_operand_kind,
	:branch_kind,
	:eis_kind,
	:instruction_kind
)
