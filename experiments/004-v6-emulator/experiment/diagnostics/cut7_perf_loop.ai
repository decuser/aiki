# Cut 7 performance workload: the exact three-instruction memory-clear loop
# observed while V6 standalone tmrk initialized itself.
#
# Run under the profiler. AIKI_PDP_PERF_SCALE selects a positive scale;
# 1x is 256 loop iterations and 100x is 25,600 iterations / 76,800 guest
# instructions, close to the real standalone pause that exposed this workload.
let execute = import("../cpu/execute")
let machine = import("../machine/machine")
let octal = import("../reference/octal")
let system = import("system")

let BASE_ITERATIONS = 256
let LOOP_PC = octal.parse("150000")
let CLR_AUTOINCREMENT_R0 = octal.parse("005020")
let CMP_R0_R6 = octal.parse("020006")
let BLO_BACK_THREE_WORDS = octal.parse("103775")

let die = (message) {
	println("CUT7 PERF FAIL: " + message)
	system.exit(1)
}

let scale = 1
let scale_text = system.env("AIKI_PDP_PERF_SCALE")
if not is_error(scale_text) {
	scale = to_number(scale_text)
}

if is_error(scale) {
	die("AIKI_PDP_PERF_SCALE must be numeric")
}

if (scale <= 0) or (scale > 100) {
	die("AIKI_PDP_PERF_SCALE must be in 1..100")
}

let iterations = BASE_ITERATIONS * scale
let target = iterations * 2
let expected_steps = iterations * 3

# At 100x target is 144000 octal, safely below code at 150000 and the I/O page.
if target >= LOOP_PC {
	die("workload would clear its own code")
}

let m = machine.new()
machine.reset_machine(m)
machine.set_register(m, 0, 0)
machine.set_register(m, 6, target)
machine.set_pc(m, LOOP_PC)

let deposited = machine.deposit_word(m, LOOP_PC, CLR_AUTOINCREMENT_R0)
if not equal(deposited, true) {
	die("cannot deposit CLR")
}

deposited = machine.deposit_word(m, LOOP_PC + 2, CMP_R0_R6)
if not equal(deposited, true) {
	die("cannot deposit CMP")
}

deposited = machine.deposit_word(m, LOOP_PC + 4, BLO_BACK_THREE_WORDS)
if not equal(deposited, true) {
	die("cannot deposit BLO")
}

let executed = execute.run_bounded(m, expected_steps)
match executed {
	[@pdp_fault, kind, value] {
		die("PDP fault " + to_str(kind) + " " + to_str(value))
	}
	_ {
	}
}

if not equal(executed, expected_steps) {
	die("unexpected guest instruction count " + to_str(executed))
}

if not equal(machine.get_register(m, 0), target) {
	die("R0 did not reach target")
}

if not equal(machine.get_register(m, 6), target) {
	die("R6 changed")
}

if not equal(machine.pc(m), LOOP_PC + 6) {
	die("loop did not fall through")
}

println(
	"CUT7 PERF " + to_str(scale) + "x" + " iterations=" + to_str(iterations) + " guest_instructions=" + to_str(expected_steps)
)
