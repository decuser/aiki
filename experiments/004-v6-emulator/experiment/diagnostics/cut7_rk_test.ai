use("test")

let file = import("file")
let machine = import("../machine/machine")
let monitor = import("../monitor/monitor")
let octal = import("../reference/octal")
let str = import("string/native")
let views = import("../observe/views")
let v6_tape = import("../media/v6_tape")
let bytes = import("bytes/ffi")

let new_pack_path = () {
	let path = file.temp()
	file.delete(path)
	return path
}

run("media attachment policy keeps tape read-only and creates missing RK05 packs", () {
	let m = monitor.new()
	# Tape is existing immutable distribution media: a missing path must fail and
	# must not be created as a side effect of attach.
	let missing_tape = new_pack_path()
	is_false(file.exists(missing_tape))
	is_error(monitor.attach_tape_unit(m, 0, missing_tape))
	is_false(file.exists(missing_tape))
	# Disk is writable removable media: a missing path is a request to create a
	# blank RK05 pack of the exact hardware geometry.
	let missing_disk = new_pack_path()
	is_false(file.exists(missing_disk))
	equal(monitor.attach_disk_unit(m, 0, missing_disk), true)
	is_true(file.exists(missing_disk))
	equal(file.size(missing_disk), 2457600)
	# Existing media of the wrong size is rejected rather than resized/truncated.
	let wrong = new_pack_path()
	let wf = file.open(wrong, :write)
	file.write_at(wf, 0, bytes.bytes_new([1]))
	file.close(wf)
	equal(file.size(wrong), 1)
	is_error(monitor.attach_disk_unit(m, 1, wrong))
	equal(file.size(wrong), 1)
	file.delete(missing_disk)
	file.delete(wrong)
})


run("RK11 exposes eight drive slots and creates an RK05-sized pack", () {
	let m = monitor.new()
	let path = new_pack_path()
	equal(monitor.attach_disk_unit(m, 7, path), true)
	is_true(machine.disk_unit_attached(m, 7))
	equal(machine.disk_unit_path(m, 7), path)
	equal(file.size(path), 2457600)
	file.delete(path)
})


run("RK11 WRITE and READ transfer one sector through UNIBUS NPR", () {
	let m = monitor.new()
	let path = new_pack_path()
	equal(monitor.attach_disk_unit(m, 0, path), true)
	let base = octal.parse("002000")
	let i = 0
	while i < 256 {
		machine.deposit_word(m, base + (i * 2), i + 1)
		i = i + 1
	}
	# disk 0, cylinder 0, surface 0, sector 0
	equal(machine.write_word(m, octal.parse("177412"), 0), true)
	equal(machine.write_word(m, octal.parse("177410"), base), true)
	equal(machine.write_word(m, octal.parse("177406"), octal.parse("177400")), true)
	equal(machine.write_word(m, octal.parse("177404"), octal.parse("000003")), true)
	machine.complete_instruction(m, 1)
	equal(machine.disk_write_count(m), 1)
	equal(machine.disk_bytes_out(m), 512)
	equal(machine.disk_word_count(m), 0)
	# one complete sector advances RKDA from sector 0 to sector 1
	equal(machine.disk_sector(m), 1)
	i = 0
	while i < 256 {
		machine.deposit_word(m, base + (i * 2), 0)
		i = i + 1
	}
	equal(machine.write_word(m, octal.parse("177412"), 0), true)
	equal(machine.write_word(m, octal.parse("177410"), base), true)
	equal(machine.write_word(m, octal.parse("177406"), octal.parse("177400")), true)
	equal(machine.write_word(m, octal.parse("177404"), octal.parse("000005")), true)
	machine.complete_instruction(m, 1)
	equal(machine.disk_read_count(m), 1)
	equal(machine.disk_bytes_in(m), 512)
	equal(machine.examine_word(m, base), 1)
	equal(machine.examine_word(m, base + 510), 256)
	is_true(machine.unibus_npr_read_count(m) >= 256)
	is_true(machine.unibus_npr_write_count(m) >= 256)
	file.delete(path)
})


run("TM11 space-forward uses MTBRC as a two's-complement record count", () {
	let m = monitor.new()
	let values = []
	let i = 0
	while i < 1536 {
		values = append(values, i - (truncate(i / 256) * 256))
		i = i + 1
	}
	let media = v6_tape.from_bytes(bytes.bytes_new(values))
	equal(machine.attach_tape_media_unit(m, 0, media), true)
	equal(machine.write_word(m, octal.parse("172524"), octal.parse("177776")), true)
	# SPACE FORWARD function 100 plus GO.
	equal(machine.write_word(m, octal.parse("172522"), octal.parse("000011")), true)
	machine.complete_instruction(m, 1)
	equal(machine.tape_media_position(m), 2)
	equal(machine.tape_byte_count(m), 0)
})


run("device and UNIBUS observers expose connected media topology", () {
	let m = monitor.new()
	let path = new_pack_path()
	equal(monitor.attach_disk_unit(m, 0, path), true)
	let rk = views.rk(m)
	let bus = views.unibus(m, "none")
	is_true(str.contains(rk, "drives"))
	is_true(str.contains(rk, path))
	is_true(str.contains(bus, "connected"))
	is_true(str.contains(bus, "disk 0"))
	file.delete(path)
})


run("monitor help exposes disk attachment and RK observer", () {
	let text = monitor.help_text("monitor")
	is_true(str.contains(text, "attach disk UNIT FILE"))
	is_true(str.contains(text, "tape|rk|kl11"))
})


run("demo setup fails safely on missing tape before creating disk", () {
	let m = monitor.new()
	let missing_tape = new_pack_path()
	let disk = new_pack_path()
	is_false(file.exists(missing_tape))
	is_false(file.exists(disk))
	is_error(monitor.demo(m, missing_tape, disk))
	is_false(file.exists(disk))
	let text = monitor.help_text("monitor")
	is_true(str.contains(text, "demo V6_TAPE RK0"))
})


run("RK05 monitor bootstrap reads block zero into memory and transfers control to zero", () {
	let m = monitor.new()
	let path = new_pack_path()
	equal(monitor.attach_disk_unit(m, 0, path), true)
	let source = octal.parse("002000")
	machine.deposit_word(m, source, octal.parse("012345"))
	let i = 1
	while i < 256 {
		machine.deposit_word(m, source + (i * 2), 0)
		i = i + 1
	}
	# Seed RK0 block zero using the documented RK11 register contract.
	equal(machine.write_word(m, octal.parse("177412"), 0), true)
	equal(machine.write_word(m, octal.parse("177410"), source), true)
	equal(machine.write_word(m, octal.parse("177406"), octal.parse("177400")), true)
	equal(machine.write_word(m, octal.parse("177404"), octal.parse("000003")), true)
	machine.complete_instruction(m, 1)
	equal(machine.disk_write_count(m), 1)
	equal(monitor.boot_disk(m, 0), true)
	equal(machine.pc(m), octal.parse("173110"))
	is_true(machine.running(m))
	let steps = 0
	while (steps < 64) and (machine.pc(m) > 0) {
		let stepped = monitor.step(m)
		steps = steps + 1
	}
	equal(machine.pc(m), 0)
	equal(machine.disk_selected_unit(m), 0)
	equal(machine.disk_read_count(m), 1)
	equal(machine.disk_bytes_in(m), 512)
	equal(machine.examine_word(m, 0), octal.parse("012345"))
	file.delete(path)
})


run("RK05 monitor bootstrap encodes selected drive and rejects unattached units", () {
	let m = monitor.new()
	is_error(monitor.boot_disk(m, 0))
	let path = new_pack_path()
	equal(monitor.attach_disk_unit(m, 1, path), true)
	equal(monitor.boot_disk(m, 1), true)
	let base = octal.parse("173110")
	equal(machine.examine_word(m, base + (7 * 2)), octal.parse("020000"))
	equal(machine.pc(m), base)
	file.delete(path)
})
