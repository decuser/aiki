let io = import("io")
let net = import("net")
let system = import("system")
let time = import("time")

let args = system.args()
if length(args) < 2 {
	io.write(:stderr, "usage: aiki observer.ai KIND PORT\n")
	system.exit(2)
}

let kind = args[0]
let endpoint = [@error, :observer, "not connected"]
let attempts = 0
while is_error(endpoint) and (attempts < 100) {
	endpoint = net.connect("127.0.0.1", to_number(args[1]))
	if is_error(endpoint) { time.sleep(50) }
	attempts = attempts + 1
}
if is_error(endpoint) {
	io.write(:stderr, "observer: connect failed: " + inspect(endpoint) + "\n")
	system.exit(1)
}
io.write(endpoint, kind + "\n")

let alive = true
while alive {
	let data = io.read(endpoint, 4096)
	if is_error(data) {
		alive = false
	} else if equal(shape(data), :end) {
		alive = false
	} else {
		io.write(:stdout, data)
	}
}
io.close(endpoint)
