let disk_write_count = (bus) {
	return rk11.write_count(disk(bus))
}

let disk_bytes_in = (bus) {
	return rk11.bytes_in(disk(bus))
}

let disk_bytes_out = (bus) {
	return rk11.bytes_out(disk(bus))
}

let console_receive = (bus, value) {
	return kl11.receive(console(bus), value)
