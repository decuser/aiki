let dati_count = (bus) {
	return counters.counter_get(counts(bus), DATI)
}

let dato_count = (bus) {
	return counters.counter_get(counts(bus), DATO)
}

let datob_count = (bus) {
	return counters.counter_get(counts(bus), DATOB)
}

let npr_write_count = (bus) {
	return counters.counter_get(counts(bus), NPR_WRITE)
}

let npr_read_count = (bus) {
	return counters.counter_get(counts(bus), NPR_READ)
}

# Diagnostic/configuration boundary for inspecting the 16->18 bit projection.
let cpu_physical_address = (address) {
	return fixed.number(cpu_physical_address_machine(fixed.word(address)))
}

