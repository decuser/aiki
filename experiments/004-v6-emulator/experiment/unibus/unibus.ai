package "aiki_pdp_unibus"

let fixed = import("machine/ffi")
let kl11 = import("../devices/console/kl11")
let memory = import("../memory/memory")
let octal = import("../reference/octal")
let store = import("store")
let counters = import("store/ffi")
let tm11 = import("../devices/tape/tm11")
let rk11 = import("../devices/disk/rk11")

let BUS_MEMORY = 0
let BUS_TAPE = 1
let BUS_COUNTS = 2
let BUS_CONSOLE = 3
let BUS_DISK = 4
let BUS_IO_MAP = 5
let BUS_PENDING = 6

let DATI = 0
let DATO = 1
let DATOB = 2
let NPR_WRITE = 3
let NPR_READ = 4
let COUNT_WORDS = 5

let OWNER_NONE = 0
let OWNER_TAPE = 1
let OWNER_CONSOLE = 2
let OWNER_DISK = 3

let IO_PAGE_16 = octal.parse("160000")
let IO_PAGE_OFFSET = octal.parse("600000")
let IO_PAGE_PHYSICAL = octal.parse("760000")
let PHYSICAL_LIMIT = octal.parse("1000000")
let IO_WORD_SLOTS = truncate((PHYSICAL_LIMIT - IO_PAGE_PHYSICAL) / 2)

let io_slot_number = (address) {
	return truncate((fixed.number(address) - IO_PAGE_PHYSICAL) / 2)
}

let register_range = (routes, first, last, owner) {
	let address = first
	while address <= last {
		store.set(routes, truncate((address - IO_PAGE_PHYSICAL) / 2), owner)
		address = address + 2
	}
	return true
}

let configure_io = () {
	let routes = store.new(IO_WORD_SLOTS)
	register_range(routes, tm11.FIRST_ADDRESS, tm11.LAST_ADDRESS, OWNER_TAPE)
	register_range(routes, kl11.FIRST_ADDRESS, kl11.LAST_ADDRESS, OWNER_CONSOLE)
	register_range(routes, rk11.FIRST_ADDRESS, rk11.LAST_ADDRESS, OWNER_DISK)
	return routes
}

let new = () {
	let counts = counters.new_counter(COUNT_WORDS)
	let pending = counters.new_counter(1)
	return [memory.new(), tm11.new(), counts, kl11.new(), rk11.new(), configure_io(), pending]
}

let physical_memory = (bus) {
	return bus[BUS_MEMORY]
}

let tape = (bus) {
	return bus[BUS_TAPE]
}

let counts = (bus) {
	return bus[BUS_COUNTS]
}

let console = (bus) {
	return bus[BUS_CONSOLE]
}

let disk = (bus) {
	return bus[BUS_DISK]
}

let io_routes = (bus) {
	return bus[BUS_IO_MAP]
}

let pending = (bus) {
	return bus[BUS_PENDING]
}

# Bound execution accessors. The CPU resolves these once before its run loop.
let memory_store = (bus) {
	return physical_memory(bus)
}

let count_store = (bus) {
	return counts(bus)
}

let pending_store = (bus) {
	return pending(bus)
}

let bump_bound = (counter_store, index) {
	counters.counter_add(counter_store, index, 1)
	return true
}

let bump = (bus, index) {
	return bump_bound(counts(bus), index)
}

# 16-bit CPU address -> 18-bit physical UNIBUS address, preserving opaque
# machine representation. With MMU disabled the upper 8K CPU page projects to
# the physical I/O page.
let cpu_physical_address_machine = (address) {
	let physical = fixed.addr_from_word(address)
	if fixed.word_ge_number(address, IO_PAGE_16) {
		return fixed.addr_add(physical, IO_PAGE_OFFSET)
	}
	return physical
}

let owner = (bus, address) {
	if fixed.addr_lt_number(address, IO_PAGE_PHYSICAL) {
		return OWNER_NONE
	}
	return store.get(io_routes(bus), io_slot_number(address))
}

let refresh_pending = (bus) {
	let value = 0
	if tm11.active(tape(bus)) or kl11.active(console(bus)) or rk11.active(disk(bus)) {
		value = 1
	}
	counters.counter_set(pending(bus), 0, value)
	return value
}

# Controllers are still numeric at their legacy boundary in this cut. That
# conversion occurs only for I/O-page transactions; ordinary RAM remains fixed
# width end-to-end. Controller migration is a separate representation cut.
let device_word = (value) {
	if is_error(value) {
		return value
	}
	return fixed.word(value)
}

let device_byte = (value) {
	if is_error(value) {
		return value
	}
	return fixed.byte(value)
}

let read_byte_physical = (bus, address) {
	if fixed.addr_lt_number(address, IO_PAGE_PHYSICAL) {
		return memory.read_byte_machine(physical_memory(bus), address)
	}
	let numeric = fixed.number(address)
	match owner(bus, address) {
		1 {
			return device_byte(tm11.read_byte(tape(bus), numeric))
		}
		2 {
			return device_byte(kl11.read_byte(console(bus), numeric))
		}
		3 {
			return device_byte(rk11.read_byte(disk(bus), numeric))
		}
		_ {
			return memory.read_byte_machine(physical_memory(bus), address)
		}
	}
}

let write_byte_physical = (bus, address, value) {
	if fixed.addr_lt_number(address, IO_PAGE_PHYSICAL) {
		return memory.write_byte_machine(physical_memory(bus), address, value)
	}
	let numeric = fixed.number(address)
	let result = false
	match owner(bus, address) {
		1 {
			result = tm11.write_byte(tape(bus), numeric, fixed.number(value))
		}
		2 {
			result = kl11.write_byte(console(bus), numeric, fixed.number(value))
		}
		3 {
			result = rk11.write_byte(disk(bus), numeric, fixed.number(value))
		}
		_ {
			result = memory.write_byte_machine(physical_memory(bus), address, value)
		}
	}
	refresh_pending(bus)
	return result
}

let read_word_physical = (bus, address) {
	if fixed.addr_lt_number(address, IO_PAGE_PHYSICAL) {
		return memory.read_word_machine(physical_memory(bus), address)
	}
	let numeric = fixed.number(address)
	match owner(bus, address) {
		1 {
			return device_word(tm11.read_word(tape(bus), numeric))
		}
		2 {
			return device_word(kl11.read_word(console(bus), numeric))
		}
		3 {
			return device_word(rk11.read_word(disk(bus), numeric))
		}
		_ {
			return memory.read_word_machine(physical_memory(bus), address)
		}
	}
}

let write_word_physical = (bus, address, value) {
	if fixed.addr_lt_number(address, IO_PAGE_PHYSICAL) {
		return memory.write_word_machine(physical_memory(bus), address, value)
	}
	let numeric = fixed.number(address)
	let result = false
	match owner(bus, address) {
		1 {
			result = tm11.write_word(tape(bus), numeric, fixed.number(value))
		}
		2 {
			result = kl11.write_word(console(bus), numeric, fixed.number(value))
		}
		3 {
			result = rk11.write_word(disk(bus), numeric, fixed.number(value))
		}
		_ {
			result = memory.write_word_machine(physical_memory(bus), address, value)
		}
	}
	refresh_pending(bus)
	return result
}

let read_byte_machine = (bus, address) {
	bump(bus, DATI)
	return read_byte_physical(bus, cpu_physical_address_machine(address))
}

let write_byte_machine = (bus, address, value) {
	bump(bus, DATOB)
	return write_byte_physical(bus, cpu_physical_address_machine(address), value)
}

let read_word_machine = (bus, address) {
	bump(bus, DATI)
	return read_word_physical(bus, cpu_physical_address_machine(address))
}

let write_word_machine = (bus, address, value) {
	bump(bus, DATO)
	return write_word_physical(bus, cpu_physical_address_machine(address), value)
}

# Bound CPU path. Ordinary RAM bypasses bus-list rediscovery entirely; I/O-page
# accesses fall back to the configured controller path because the bus object is
# still the authority for controller routing.
let read_byte_bound = (bus, memory_store, counter_store, address) {
	counters.counter_add(counter_store, DATI, 1)
	if fixed.word_lt_number(address, IO_PAGE_16) {
		return memory.read_byte_machine(memory_store, fixed.addr_from_word(address))
	}
	return read_byte_physical(bus, cpu_physical_address_machine(address))
}

let write_byte_bound = (bus, memory_store, counter_store, address, value) {
	counters.counter_add(counter_store, DATOB, 1)
	if fixed.word_lt_number(address, IO_PAGE_16) {
		return memory.write_byte_machine(memory_store, fixed.addr_from_word(address), value)
	}
	return write_byte_physical(bus, cpu_physical_address_machine(address), value)
}

let read_word_bound = (bus, memory_store, counter_store, address) {
	counters.counter_add(counter_store, DATI, 1)
	if fixed.word_lt_number(address, IO_PAGE_16) {
		return memory.read_word_machine(memory_store, fixed.addr_from_word(address))
	}
	return read_word_physical(bus, cpu_physical_address_machine(address))
}

let write_word_bound = (bus, memory_store, counter_store, address, value) {
	counters.counter_add(counter_store, DATO, 1)
	if fixed.word_lt_number(address, IO_PAGE_16) {
		return memory.write_word_machine(memory_store, fixed.addr_from_word(address), value)
	}
	return write_word_physical(bus, cpu_physical_address_machine(address), value)
}

# Numeric diagnostic/control facade; execution uses the *_machine forms.
let read_byte = (bus, address) {
	let v = read_byte_machine(bus, fixed.word(address))
	if equal(shape(v), :pdp_fault) {
		return v
	}
	return fixed.number(v)
}

let write_byte = (bus, address, value) {
	return write_byte_machine(bus, fixed.word(address), fixed.byte(value))
}

let read_word = (bus, address) {
	let v = read_word_machine(bus, fixed.word(address))
	if equal(shape(v), :pdp_fault) {
		return v
	}
	return fixed.number(v)
}

let write_word = (bus, address, value) {
	return write_word_machine(bus, fixed.word(address), fixed.word(value))
}

let attach_tape_media = (bus, media) {
	return tm11.attach_media(tape(bus), media)
}

let attach_tape_media_unit = (bus, unit, media) {
	return tm11.attach_media_unit(tape(bus), unit, media)
}

let attach_tape_raw = (bus, path) {
	return tm11.attach_raw(tape(bus), path)
}

let attach_tape_raw_unit = (bus, unit, path) {
	return tm11.attach_raw_unit(tape(bus), unit, path)
}

let attach_disk_path = (bus, unit, path) {
	return rk11.attach_path(disk(bus), unit, path)
}

let reset_bus = (bus) {
	tm11.reset_tape(tape(bus))
	kl11.reset_console(console(bus))
	rk11.reset_disk(disk(bus))
	refresh_pending(bus)
	return true
}

# Device progress remains deterministic. DMA crosses the legacy controller
# numeric boundary once per callback, then enters fixed-width RAM directly.
let advance = (bus, elapsed) {
	if equal(counters.counter_get(pending(bus), 0), 0) {
		return true
	}
	let tape_result = true
	if tm11.active(tape(bus)) {
		tape_result = tm11.advance(tape(bus), elapsed, (address, value) {
			bump(bus, NPR_WRITE)
			return memory.write_byte_machine(physical_memory(bus), fixed.addr18(address), fixed.byte(value))
		})
	}
	if is_error(tape_result) {
		return tape_result
	}
	let disk_result = true
	if rk11.active(disk(bus)) {
		disk_result = rk11.advance(disk(bus), elapsed, (address) {
			bump(bus, NPR_READ)
			let v = memory.read_word_machine(physical_memory(bus), fixed.addr18(address))
			if equal(shape(v), :pdp_fault) {
				return v
			}
			return fixed.number(v)
		}, (address, value) {
			bump(bus, NPR_WRITE)
			return memory.write_word_machine(physical_memory(bus), fixed.addr18(address), fixed.word(value))
		})
	}
	if is_error(disk_result) {
		return disk_result
	}
	if kl11.active(console(bus)) {
		kl11.advance(console(bus), elapsed)
	}
	refresh_pending(bus)
	return true
}

let advance_bound = (bus, pending_store, elapsed) {
	if counters.counter_get(pending_store, 0) <= 0 {
		return true
	}
	return advance(bus, elapsed)
}

let tape_byte_count = (bus) {
	return tm11.byte_count(tape(bus))
}

let tape_current_address = (bus) {
