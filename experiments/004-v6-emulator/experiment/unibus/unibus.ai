	return kl11.last_tx(console(bus))
}

let console_receiver_done = (bus) {
	return kl11.receiver_done(console(bus))
}

let console_transmitter_ready = (bus) {
	return kl11.transmitter_ready(console(bus))
}

let console_receiver_interrupt_enabled = (bus) {
	return kl11.receiver_interrupt_enabled(console(bus))
}

let console_transmitter_interrupt_enabled = (bus) {
	return kl11.transmitter_interrupt_enabled(console(bus))
}

let dati_count = (bus) {
	return counters.counter_get(counts(bus), DATI)
}

let dato_count = (bus) {
	return counters.counter_get(counts(bus), DATO)
}

let datob_count = (bus) {
	return counters.counter_get(counts(bus), DATOB)
}

let npr_write_count = (bus) {
	return counters.counter_get(counts(bus), NPR_WRITE)
}

let npr_read_count = (bus) {
	return counters.counter_get(counts(bus), NPR_READ)
}

let last_dati_address = (bus) {
	return counters.counter_get(io_trace(bus), TRACE_DATI)
}

let last_dato_address = (bus) {
	return counters.counter_get(io_trace(bus), TRACE_DATO)
}

let last_datob_address = (bus) {
	return counters.counter_get(io_trace(bus), TRACE_DATOB)
}

let clock_status = (bus) {
	return kw11l.status(clock(bus))
}

let clock_enabled = (bus) {
	return kw11l.enabled(clock(bus))
}

let clock_monitor = (bus) {
	return kw11l.monitor(clock(bus))
}

let clock_ticks = (bus) {
	return kw11l.ticks(clock(bus))
}

let clock_interrupts = (bus) {
	return kw11l.interrupts(clock(bus))
}

let interrupt_store = (bus) {
	return irq(bus)
}

let interrupt_pending = (bus) {
	return counters.counter_get(irq(bus), IRQ_PENDING) > 0
}

let interrupt_level = (bus) {
	return counters.counter_get(irq(bus), IRQ_LEVEL)
}

let interrupt_vector = (bus) {
	return counters.counter_get(irq(bus), IRQ_VECTOR)
}

let interrupt_pending_bound = (irq_store) {
	return counters.counter_get(irq_store, IRQ_PENDING) > 0
}

let interrupt_level_bound = (irq_store) {
	return counters.counter_get(irq_store, IRQ_LEVEL)
}

let interrupt_vector_bound = (irq_store) {
	return counters.counter_get(irq_store, IRQ_VECTOR)
}

let acknowledge_interrupt = (bus) {
	kw11l.acknowledge_interrupt(clock(bus))
	sync_clock_irq(bus)
	return true
}

# Diagnostic/configuration boundary for inspecting the 16->18 bit projection.
let cpu_physical_address = (address) {
	return fixed.number(cpu_physical_address_machine(fixed.word(address)))
}

