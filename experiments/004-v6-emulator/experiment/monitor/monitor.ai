package "aiki_pdp_monitor"

let decode = import("../cpu/decode")
let execute = import("../cpu/execute")
let machine = import("../machine/machine")
let octal = import("../reference/octal")
let pdp_help = import("../reference/help")
let str = import("string/native")
let views = import("../observe/views")

let new = () {
	let m = machine.new()
	machine.reset_machine(m)
	return m
}

let parse_number = (text) { return octal.parse(text) }

let status = (m) {
	let state = "halted"
	if machine.suspended(m) { state = "suspended" }
	if machine.running(m) { state = "running" }
	if machine.waiting(m) { state = "waiting" }
	return "CPU " + state +
		"  PC " + octal.word(machine.pc(m)) +
		"  PSW " + octal.word(machine.psw(m)) +
		"  steps " + octal.count(machine.steps(m)) +
		"  tape " + octal.word(machine.tape_media_position(m))
}

let registers = (m) { return views.cpu(m) }
let tape = (m) { return views.tape(m) }
let kl11 = (m) { return views.kl11(m) }
let bus = (m, last_event) { return views.unibus(m, last_event) }

let examine = (m, address, count) {
	let text = ""
	let i = 0
	while i < count {
		let at = address + (i * 2)
		if i > 0 { text = text + "\n" }
		text = text + octal.address(at) + "  " + octal.word(machine.examine_word(m, at))
		i = i + 1
	}
	return text
}

let deposit = (m, address, value) {
	return machine.deposit_word(m, address, value)
}

let attach_tape = (m, path) { return machine.attach_tape_raw(m, path) }
let attach_tape_unit = (m, unit, path) { return machine.attach_tape_raw_unit(m, unit, path) }

let boot_tape = (m, unit) {
	if (unit < 0) or (unit > 7) { return [@error, :tape_unit, "tape unit must be 0..7"] }
	let base = octal.parse("100000")
	let command = octal.parse("060003") + (unit * octal.parse("000400"))
	let words = [octal.parse("012700"), octal.parse("172526"), octal.parse("010040"), octal.parse("012740"), command, octal.parse("000777")]
	let i = 0
	while i < length(words) {
		machine.deposit_word(m, base + (i * 2), words[i])
		i = i + 1
	}
	machine.set_pc(m, base)
	machine.set_waiting(m, false)
	machine.set_suspended(m, false)
	machine.set_running(m, true)
	return true
}

let set_pc = (m, value) { return machine.set_pc(m, value) }

let is_pdp_fault = (value) {
	match value {
		[@pdp_fault, _, _] { return true }
		_ { return false }
	}
}

let step = (m) {
	machine.set_running(m, true)
	let result = execute.step(m)
	if machine.waiting(m) { machine.set_running(m, false) }
	return result
}

let help_text = (topic) {
	if equal(topic, "monitor") {
		return str.join([
			"aiki-pdp monitor commands",
			"",
			"help [TOPIC]             monitor or PDP-11 reference help",
			"attach tape [UNIT] FILE  attach raw V6 distribution tape read-only",
			"boot tape UNIT           deposit and run V6 TM bootstrap for unit 0..7",
			"deposit ADDR WORD        deposit one octal word",
			"examine ADDR [COUNT]     examine octal words",
			"set pc ADDR              set program counter",
			"registers                show CPU state",
			"status                   concise machine state",
			"show cpu|unibus|tape|kl11 print observer snapshot here",
			"step [COUNT]             execute bounded instructions",
			"run [ADDR]               run from current or supplied PC",
			"continue                 resume after CTRL-E",
			"reset                    reset CPU and UNIBUS-visible devices",
			"observers                list connected observer windows",
			"quit",
			"",
			"while running: CTRL-T status; CTRL-E suspend; CTRL-C interrupt",
			"at the prompt: CTRL-D EOF/quit"
		], "\n")
	}
	return pdp_help.topic(topic)
}

let words = (line) {
	let clean = str.trim(line)
	if equal(clean, "") { return [] }
	let raw = str.split(clean, " ")
	let result = []
	let i = 0
	while i < length(raw) {
		if not equal(raw[i], "") { result = append(result, raw[i]) }
		i = i + 1
	}
	return result
}

export(:new, :parse_number, :status, :registers, :tape, :kl11, :bus, :examine, :deposit, :attach_tape, :attach_tape_unit, :boot_tape, :set_pc, :step, :is_pdp_fault, :help_text, :words)
