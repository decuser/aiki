package "aiki_pdp_machine"

let fixed = import("machine/ffi")
let audit = import("../audit/audit")
let state = import("./state")
let unibus = import("../unibus/unibus")
let kt11d = import("./kt11d")
let octal = import("../reference/octal")
let system = import("system")

let MACHINE_STATE = 0
let MACHINE_BUS = 1
let MACHINE_AUDIT = 2
let MACHINE_MMU = 3
let PSW_PHYSICAL = 262142  # 0777776
let CONSOLE_SWITCH_PHYSICAL = 262008  # 0777570
let CUT10_NOFAULT_VIRTUAL = 40796  # 0117534
let CUT10_NOFAULT_RECOVERY = 1242  # 0002332
let CUT10_KSP_STOP = 40960  # 0120000

let cut10_watch_text = system.env("AIKI_PDP_CUT10_WATCH")
let CUT10_WATCH = not is_error(cut10_watch_text)

let new_with_memory_words = (words) {
	return [state.new(), unibus.new_with_memory_words(words), audit.new(), kt11d.new()]
}

let new = () {
	return new_with_memory_words(unibus.DEFAULT_MEMORY_WORDS)
}

let mmu = (m) {
	return m[MACHINE_MMU]
}

let processor_state = (m) {
	return m[MACHINE_STATE]
}

let bus = (m) {
	return m[MACHINE_BUS]
}

let installed_memory_words = (m) {
	return unibus.installed_memory_words(bus(m))
}

let console_switch_word = (m) {
	return state.switch_word(processor_state(m))
}

let set_console_switch_word = (m, value) {
	return state.set_switch_word(processor_state(m), fixed.word(value))
}

let console_switch = (m) {
	return fixed.number(console_switch_word(m))
}

let execution_audit = (m) {
	return m[MACHINE_AUDIT]
}

let reset_machine = (m) {
	state.reset_state(processor_state(m))
	kt11d.reset_mmu(mmu(m))
	unibus.reset_bus(bus(m))
	audit.reset_audit(execution_audit(m))
	return true
}

# Hot execution API: opaque machine values remain fixed-width.
let register_word = (m, index) {
	return state.get_register_word(processor_state(m), index)
}

let cut10_watch_line = (m, kind, old_value, new_value) {
	if not CUT10_WATCH {
		return true
	}
	let psw = fixed.number(state.psw_word(processor_state(m)))
	let pc = fixed.number(state.iar_word(processor_state(m)))
	let ir = fixed.number(state.ir_word(processor_state(m)))
	let current = kt11d.current_mode(psw)
	let previous = kt11d.previous_mode(psw)
	let r5 = fixed.number(state.get_register_word(processor_state(m), 5))
	println(
		"CUT10-WATCH " + kind + " step=" + to_str(state.steps(processor_state(m))) + " pc=" + octal.word(pc) + " ir=" + octal.word(ir) + " ps=" + octal.word(psw) + " cm=" + to_str(current) + " pm=" + to_str(previous) + " r5=" + octal.word(r5) + " old=" + octal.word(fixed.number(old_value)) + " new=" + octal.word(fixed.number(new_value))
	)
	return true
}

let cut10_watch_ksp_transition = (m, old_value, new_value) {
	if not CUT10_WATCH {
		return true
	}
	let old_number = fixed.number(old_value)
	let new_number = fixed.number(new_value)
	let processor = processor_state(m)
	let low = state.watch_ksp_low(processor)
	# Low-water observations require a real downward stack transition.
	# This suppresses reset/bootstrap samples such as 000000 -> 000000.
	if new_number < old_number {
		if new_number < low {
			cut10_watch_line(m, "KSP-LOW", old_value, new_value)
			state.set_watch_ksp_low(processor, new_number)
		}
		if new_number < CUT10_KSP_STOP {
			state.set_watch_stop_kind(processor, 1)
		}
	}
	return true
}

let set_sp_mode_word = (m, mode, value) {
	let old_value = state.sp_mode_word(processor_state(m), mode)
	let result = state.set_sp_mode_word(processor_state(m), mode, value)
	if equal(mode, 0) {
		cut10_watch_ksp_transition(m, old_value, value)
	}
	return result
}

let set_register_word = (m, index, value) {
	if equal(index, 6) {
		let mode = kt11d.current_mode(fixed.number(state.psw_word(processor_state(m))))
		return set_sp_mode_word(m, mode, value)
	}
	return state.set_register_word(processor_state(m), index, value)
}

let pc_word = (m) {
	return state.pc_word(processor_state(m))
}

let set_pc_word = (m, value) {
	return state.set_pc_word(processor_state(m), value)
}

let sp_word = (m) {
	return state.sp_word(processor_state(m))
}

let set_sp_word = (m, value) {
	let mode = kt11d.current_mode(fixed.number(state.psw_word(processor_state(m))))
	return set_sp_mode_word(m, mode, value)
}

let sp_mode_word = (m, mode) {
	return state.sp_mode_word(processor_state(m), mode)
}

let psw_word = (m) {
	return state.psw_word(processor_state(m))
}

let set_psw_word = (m, value) {
	return state.set_psw_word(processor_state(m), value)
}

let ir_word = (m) {
	return state.ir_word(processor_state(m))
}

