let iar_word = (m) {
	return state.iar_word(processor_state(m))
}

let set_iar_word = (m, value) {
	return state.set_iar_word(processor_state(m), value)
}

let cut10_watch_stop = (m) {
	if not CUT10_WATCH {
		return false
	}
	let kind = state.watch_stop_kind(processor_state(m))
	if equal(kind, 1) {
		return "KSP-LOW"
	}
	if equal(kind, 2) {
		return "NOFAULT-ODD"
	}
	return false
}

let cut10_watch_clear_stop = (m) {
	state.set_watch_stop_kind(processor_state(m), 0)
	return true
}

let mmu_enabled = (m) {
	return kt11d.enabled(mmu(m))
}

let current_mode = (m) {
	return kt11d.current_mode(fixed.number(psw_word(m)))
}

let previous_mode = (m) {
	return kt11d.previous_mode(fixed.number(psw_word(m)))
}

let previous_sp_word = (m) {
	return sp_mode_word(m, previous_mode(m))
}

let set_previous_sp_word = (m, value) {
	return set_sp_mode_word(m, previous_mode(m), value)
}

let translate_address = (m, address, mode, writing) {
	let translated = kt11d.translate(mmu(m), fixed.number(address), mode, writing)
	if equal(shape(translated), :pdp_fault) {
		return translated
	}
	return fixed.addr18(translated)
}

let read_byte_mode_machine = (m, address, mode) {
	unibus.record_dati(bus(m), address)
	let physical = translate_address(m, address, mode, false)
	if equal(shape(physical), :pdp_fault) {
		return physical
	}
	let numeric = fixed.number(physical)
	if kt11d.owns(numeric) {
		return fixed.byte(kt11d.read_byte(mmu(m), numeric))
	}
	if equal(numeric, PSW_PHYSICAL) {
		return fixed.low_byte(psw_word(m))
	}
	if equal(numeric, CONSOLE_SWITCH_PHYSICAL) {
		return fixed.low_byte(state.switch_word(processor_state(m)))
	}
	if equal(numeric, CONSOLE_SWITCH_PHYSICAL + 1) {
		return fixed.high_byte(state.switch_word(processor_state(m)))
	}
	return unibus.read_byte_physical_machine(bus(m), physical)
}

let write_byte_mode_machine = (m, address, value, mode) {
	unibus.record_datob(bus(m), address)
	let physical = translate_address(m, address, mode, true)
	if equal(shape(physical), :pdp_fault) {
		return physical
	}
	let numeric = fixed.number(physical)
	if kt11d.owns(numeric) {
		return kt11d.write_byte(mmu(m), numeric, fixed.number(value))
	}
	if equal(numeric, PSW_PHYSICAL) {
		return set_psw_word(m, fixed.with_low_byte(psw_word(m), value))
	}
	if equal(numeric, CONSOLE_SWITCH_PHYSICAL) or equal(numeric, CONSOLE_SWITCH_PHYSICAL + 1) {
		return true
	}
	return unibus.write_byte_physical_machine(bus(m), physical, value)
}

let read_word_mode_machine = (m, address, mode) {
	unibus.record_dati(bus(m), address)
	let physical = translate_address(m, address, mode, false)
	if equal(shape(physical), :pdp_fault) {
		return physical
	}
	let numeric = fixed.number(physical)
	if kt11d.owns(numeric) {
		return fixed.word(kt11d.read_word(mmu(m), numeric))
	}
	if equal(numeric, PSW_PHYSICAL) {
		return psw_word(m)
	}
	if equal(numeric, CONSOLE_SWITCH_PHYSICAL) {
		return state.switch_word(processor_state(m))
	}
	return unibus.read_word_physical_machine(bus(m), physical)
}

let write_word_mode_machine = (m, address, value, mode) {
	unibus.record_dato(bus(m), address)
	let physical = translate_address(m, address, mode, true)
	if equal(shape(physical), :pdp_fault) {
		return physical
	}
	let numeric = fixed.number(physical)
	if kt11d.owns(numeric) {
		return kt11d.write_word(mmu(m), numeric, fixed.number(value))
	}
	if equal(numeric, PSW_PHYSICAL) {
		return set_psw_word(m, value)
	}
	if equal(numeric, CONSOLE_SWITCH_PHYSICAL) {
		return true
	}
	let watched = CUT10_WATCH and equal(mode, 0) and equal(fixed.number(address), CUT10_NOFAULT_VIRTUAL)
	let old_value = value
	if watched {
		old_value = unibus.read_word_physical_machine(bus(m), physical)
	}
	let result = unibus.write_word_physical_machine(bus(m), physical, value)
	if watched and not equal(shape(old_value), :pdp_fault) and not equal(shape(result), :pdp_fault) {
		let new_number = fixed.number(value)
		if not equal(new_number, 0) and not equal(new_number, CUT10_NOFAULT_RECOVERY) {
			cut10_watch_line(m, "NOFAULT-ODD", old_value, value)
			state.set_watch_stop_kind(processor_state(m), 2)
		}
	}
	return result
}

let read_byte_machine = (m, address) {
	return read_byte_mode_machine(m, address, current_mode(m))
}

let write_byte_machine = (m, address, value) {
	return write_byte_mode_machine(m, address, value, current_mode(m))
}

let read_word_machine = (m, address) {
	return read_word_mode_machine(m, address, current_mode(m))
}

let write_word_machine = (m, address, value) {
	return write_word_mode_machine(m, address, value, current_mode(m))
}

let read_word_previous_machine = (m, address) {
	return read_word_mode_machine(m, address, previous_mode(m))
}

let write_word_previous_machine = (m, address, value) {
	return write_word_mode_machine(m, address, value, previous_mode(m))
}

let mmu_instruction_start = (m, pc) {
	return kt11d.instruction_start(mmu(m), fixed.number(pc))
}

let mmu_ssr0 = (m) {
	return kt11d.ssr0(mmu(m))
}

let mmu_ssr2 = (m) {
