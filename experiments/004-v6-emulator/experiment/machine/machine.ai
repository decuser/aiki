package "aiki_pdp_machine"

let audit = import("../audit/audit")
let state = import("./state")
let unibus = import("../unibus/unibus")

let MACHINE_STATE = 0
let MACHINE_BUS = 1
let MACHINE_AUDIT = 2

let new = () {
	return [state.new(), unibus.new(), audit.new()]
}

let processor_state = (machine) {
	return machine[MACHINE_STATE]
}

let bus = (machine) {
	return machine[MACHINE_BUS]
}

let execution_audit = (machine) {
	return machine[MACHINE_AUDIT]
}

let reset_machine = (machine) {
	# Gate 1 has no bus-visible devices to initialize yet. State reset is kept
	# behind the machine boundary so UNIBUS INIT propagation can join it later.
	state.reset_state(processor_state(machine))
	unibus.reset_bus(bus(machine))
	audit.reset_audit(execution_audit(machine))
	return true
}

let get_register = (machine, index) {
	return state.get_register(processor_state(machine), index)
}

let set_register = (machine, index, value) {
	return state.set_register(processor_state(machine), index, value)
}

let pc = (machine) {
	return state.pc(processor_state(machine))
}

let set_pc = (machine, value) {
	return state.set_pc(processor_state(machine), value)
}

let sp = (machine) {
	return state.sp(processor_state(machine))
}

let set_sp = (machine, value) {
	return state.set_sp(processor_state(machine), value)
}

let psw = (machine) {
	return state.psw(processor_state(machine))
}

let set_psw = (machine, value) {
	return state.set_psw(processor_state(machine), value)
}

let running = (machine) {
	return state.running(processor_state(machine))
}

let set_running = (machine, value) {
	return state.set_running(processor_state(machine), value)
}

let waiting = (machine) {
	return state.waiting(processor_state(machine))
}

let set_waiting = (machine, value) {
	return state.set_waiting(processor_state(machine), value)
}

let suspended = (machine) {
	return state.suspended(processor_state(machine))
}

let set_suspended = (machine, value) {
	return state.set_suspended(processor_state(machine), value)
}

let steps = (machine) {
	return state.steps(processor_state(machine))
}

let machine_time = (machine) {
	return state.machine_time(processor_state(machine))
}

let snapshot = (machine) {
	return state.snapshot(processor_state(machine))
}

let complete_instruction = (machine, elapsed) {
	unibus.advance(bus(machine), elapsed)
	return state.complete_instruction(processor_state(machine), elapsed)
}

let reset_bus = (machine) {
	return unibus.reset_bus(bus(machine))
}

let attach_tape_media = (machine, media) { return unibus.attach_tape_media(bus(machine), media) }
let attach_tape_media_unit = (machine, unit, media) { return unibus.attach_tape_media_unit(bus(machine), unit, media) }

let attach_tape_raw = (machine, path) { return unibus.attach_tape_raw(bus(machine), path) }
let attach_tape_raw_unit = (machine, unit, path) { return unibus.attach_tape_raw_unit(bus(machine), unit, path) }

let tape_byte_count = (machine) { return unibus.tape_byte_count(bus(machine)) }
let tape_current_address = (machine) { return unibus.tape_current_address(bus(machine)) }
let tape_command = (machine) { return unibus.tape_command(bus(machine)) }
let tape_status = (machine) { return unibus.tape_status(bus(machine)) }
let tape_selected_unit = (machine) { return unibus.tape_selected_unit(bus(machine)) }
let tape_media_position = (machine) { return unibus.tape_media_position(bus(machine)) }
let tape_media_position_unit = (machine, unit) { return unibus.tape_media_position_unit(bus(machine), unit) }
let tape_read_count = (machine) { return unibus.tape_read_count(bus(machine)) }
let tape_write_count = (machine) { return unibus.tape_write_count(bus(machine)) }
let tape_bytes_in = (machine) { return unibus.tape_bytes_in(bus(machine)) }
let tape_bytes_out = (machine) { return unibus.tape_bytes_out(bus(machine)) }
let unibus_dati_count = (machine) { return unibus.dati_count(bus(machine)) }
let unibus_dato_count = (machine) { return unibus.dato_count(bus(machine)) }
let unibus_datob_count = (machine) { return unibus.datob_count(bus(machine)) }
let unibus_npr_write_count = (machine) { return unibus.npr_write_count(bus(machine)) }

let console_receive = (machine, value) { return unibus.console_receive(bus(machine), value) }
let console_take_output = (machine) { return unibus.console_take_output(bus(machine)) }
let console_receiver_status = (machine) { return unibus.console_receiver_status(bus(machine)) }
let console_receiver_buffer = (machine) { return unibus.console_receiver_buffer(bus(machine)) }
let console_transmitter_status = (machine) { return unibus.console_transmitter_status(bus(machine)) }
let console_transmitter_buffer = (machine) { return unibus.console_transmitter_buffer(bus(machine)) }
let console_rx_count = (machine) { return unibus.console_rx_count(bus(machine)) }
let console_tx_count = (machine) { return unibus.console_tx_count(bus(machine)) }
let console_last_rx = (machine) { return unibus.console_last_rx(bus(machine)) }
let console_last_tx = (machine) { return unibus.console_last_tx(bus(machine)) }
let console_receiver_done = (machine) { return unibus.console_receiver_done(bus(machine)) }
let console_transmitter_ready = (machine) { return unibus.console_transmitter_ready(bus(machine)) }
let console_receiver_interrupt_enabled = (machine) { return unibus.console_receiver_interrupt_enabled(bus(machine)) }
let console_transmitter_interrupt_enabled = (machine) { return unibus.console_transmitter_interrupt_enabled(bus(machine)) }

let audit_instruction = (machine, kind) {
	return audit.record_instruction(execution_audit(machine), kind)
}

let audit_operand = (machine, role, mode) {
	return audit.record_mode(execution_audit(machine), role, mode)
}

let audit_instruction_count = (machine, kind) {
	return audit.instruction_count(execution_audit(machine), kind)
}

let audit_mode_count = (machine, role, mode) {
	return audit.mode_count(execution_audit(machine), role, mode)
}

let audit_instruction_counts = (machine) {
	return audit.instruction_counts(execution_audit(machine))
}

let audit_psw_transition = (machine, kind, before, after) {
	return audit.record_psw_transition(execution_audit(machine), kind, before, after)
}

let audit_psw_change_count = (machine, bit) {
	return audit.psw_change_count(execution_audit(machine), bit)
}

let audit_last_psw_transition = (machine) {
	return audit.last_psw_transition(execution_audit(machine))
}

# Architectural CPU accesses use the same UNIBUS path as operator examine/deposit,
# but have distinct names so later observation and protection policy can remain clear.
let read_byte = (machine, address) {
	return unibus.read_byte(bus(machine), address)
}

let write_byte = (machine, address, value) {
	return unibus.write_byte(bus(machine), address, value)
}

let read_word = (machine, address) {
	return unibus.read_word(bus(machine), address)
}

let write_word = (machine, address, value) {
	return unibus.write_word(bus(machine), address, value)
}

# Operator/diagnostic memory access goes through the machine and UNIBUS rather
# than reaching into backing memory.
let examine_byte = (machine, address) {
	return unibus.read_byte(bus(machine), address)
}

let deposit_byte = (machine, address, value) {
	return unibus.write_byte(bus(machine), address, value)
}

let examine_word = (machine, address) {
	return unibus.read_word(bus(machine), address)
}

let deposit_word = (machine, address, value) {
	return unibus.write_word(bus(machine), address, value)
}

export(
	:new,
	:reset_machine,
	:get_register,
	:set_register,
	:pc,
	:set_pc,
	:sp,
	:set_sp,
	:psw,
	:set_psw,
	:running,
	:set_running,
	:waiting,
	:set_waiting,
	:suspended,
	:set_suspended,
	:steps,
	:machine_time,
	:snapshot,
	:complete_instruction,
	:reset_bus,
	:attach_tape_media,
	:attach_tape_media_unit,
	:attach_tape_raw,
	:attach_tape_raw_unit,
	:tape_byte_count,
	:tape_current_address,
	:tape_command,
	:tape_status,
	:tape_selected_unit,
	:tape_media_position,
	:tape_media_position_unit,
	:tape_read_count,
	:tape_write_count,
	:tape_bytes_in,
	:tape_bytes_out,
	:unibus_dati_count,
	:unibus_dato_count,
	:unibus_datob_count,
	:unibus_npr_write_count,
	:console_receive,
	:console_take_output,
	:console_receiver_status,
	:console_receiver_buffer,
	:console_transmitter_status,
	:console_transmitter_buffer,
	:console_rx_count,
	:console_tx_count,
	:console_last_rx,
	:console_last_tx,
	:console_receiver_done,
	:console_transmitter_ready,
	:console_receiver_interrupt_enabled,
	:console_transmitter_interrupt_enabled,
	:audit_instruction,
	:audit_operand,
	:audit_instruction_count,
	:audit_mode_count,
	:audit_instruction_counts,
	:audit_psw_transition,
	:audit_psw_change_count,
	:audit_last_psw_transition,
	:read_byte,
	:write_byte,
	:read_word,
	:write_word,
	:examine_byte,
	:deposit_byte,
	:examine_word,
	:deposit_word
)
