let reset_bus = (m) {
	return unibus.reset_bus(bus(m))
}

let examine_byte = (m, address) {
	let v = read_byte_machine(m, fixed.word(address))
	if equal(shape(v), :pdp_fault) {
		return v
	}
	return fixed.number(v)
}

let deposit_byte = (m, address, value) {
	return write_byte_machine(m, fixed.word(address), fixed.byte(value))
}

let examine_word = (m, address) {
	let v = read_word_machine(m, fixed.word(address))
	if equal(shape(v), :pdp_fault) {
		return v
	}
	return fixed.number(v)
}

let deposit_word = (m, address, value) {
	return write_word_machine(m, fixed.word(address), fixed.word(value))
}

# Front-panel/operator control path for loading the bootstrap ROM while keeping
# the ROM read-only to guest CPU stores. Address is the 16-bit CPU-visible ROM
# address used by the monitor.
let deposit_boot_word = (m, address, value) {
	let cpu_address = fixed.word(address)
	let physical = unibus.cpu_physical_address_machine(cpu_address)
	return unibus.load_boot_word_machine(bus(m), physical, fixed.word(value))
}

# Compatibility names for operator/device diagnostics remain numeric boundary calls.
let read_byte = (m, address) {
	return examine_byte(m, address)
}

let write_byte = (m, address, value) {
	return deposit_byte(m, address, value)
}

let read_word = (m, address) {
	return examine_word(m, address)
}

let write_word = (m, address, value) {
	return deposit_word(m, address, value)
}

