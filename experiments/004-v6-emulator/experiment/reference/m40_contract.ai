package "aiki_pdp_m40_contract"

# Lions' m40.s contract has two evidence classes: mnemonics assembled directly
# in m40.s, and instruction forms the 11/40 backup logic explicitly classifies
# as architectural cases. SXT is in the latter class even though its direct
# source-mnemonic count is zero. Counts below are static direct occurrences in
# the supplied Lions V6 source listing and are evidence only; dynamic execution
# audit is expected to be a strict subset for any one run.
let INSTRUCTIONS = [
	:adc,
	:add,
	:ash,
	:ashc,
	:asl,
	:asr,
	:beq,
	:bge,
	:bhi,
	:bhis,
	:bic,
	:bis,
	:bisb,
	:bit,
	:ble,
	:blo,
	:bne,
	:br,
	:clc,
	:clr,
	:clrb,
	:cmp,
	:cmpb,
	:dec,
	:div,
	:inc,
	:incb,
	:jmp,
	:jsr,
	:mfpi,
	:mov,
	:movb,
	:mtpi,
	:mul,
	:reset,
	:ror,
	:rts,
	:rtt,
	:sbc,
	:sob,
	:sub,
	:sxt,
	:swab,
	:tst,
	:tstb,
	:wait
]


let SOURCE_COUNTS = [
	[:adc, 1],
	[:add, 9],
	[:ash, 6],
	[:ashc, 2],
	[:asl, 4],
	[:asr, 4],
	[:beq, 21],
	[:bge, 3],
	[:bhi, 1],
	[:bhis, 1],
	[:bic, 28],
	[:bis, 16],
	[:bisb, 1],
	[:bit, 18],
	[:ble, 1],
	[:blo, 3],
	[:bne, 12],
	[:br, 14],
	[:clc, 1],
	[:clr, 21],
	[:clrb, 4],
	[:cmp, 11],
	[:cmpb, 1],
	[:dec, 4],
	[:div, 2],
	[:inc, 5],
	[:incb, 1],
	[:jmp, 4],
	[:jsr, 22],
	[:mfpi, 6],
	[:mov, 210],
	[:movb, 11],
	[:mtpi, 6],
	[:mul, 1],
	[:reset, 2],
	[:ror, 1],
	[:rts, 38],
	[:rtt, 3],
	[:sbc, 1],
	[:sob, 5],
	[:sub, 4],
	[:sxt, 0],
	[:swab, 3],
	[:tst, 6],
	[:tstb, 3],
	[:wait, 1]
]


# Forms named explicitly by the m40.s backup classifier rather than necessarily
# appearing as executable mnemonics in m40.s itself. Keeping this evidence
# separate prevents a zero direct-occurrence count from silently dropping an
# architectural requirement.
let BACKUP_CLASSIFIED = [
	:mfpi,
	:mtpi,
	:sxt
]


let ADDRESSING_MODES = [
	:register,
	:register_deferred,
	:autoincrement,
	:autoincrement_deferred,
	:autodecrement,
	:autodecrement_deferred,
	:indexed,
	:indexed_deferred
]


let source_count = (kind) {
	let i = 0
	while i < length(SOURCE_COUNTS) {
		if equal(SOURCE_COUNTS[i][0], kind) {
			return SOURCE_COUNTS[i][1]
		}
		i = i + 1
	}
	return 0
}

export(:INSTRUCTIONS, :SOURCE_COUNTS, :BACKUP_CLASSIFIED, :ADDRESSING_MODES, :source_count)
